msgstr ""
"Номи дигар барои файли %1 дода шуда "
"натавонист"

#: kio/global.cpp:325
#, c-format
msgid "Could not change permissions for %1."
msgstr ""
"Дастрасӣ барои %1 дигаргун карда "
"натавонист"

#: kio/global.cpp:328
#, c-format
