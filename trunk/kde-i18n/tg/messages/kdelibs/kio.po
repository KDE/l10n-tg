msgstr ""
"Амалиёт барои протоколи %1 ба таври ғайри "
"мунтазарӣ кушта шуд."

#: kio/global.cpp:334
#, c-format
msgid ""
"Error. Out of memory.\n"
"%1"
msgstr ""
"Хато. Калон аз андозаи хотир.\n"
"%1"

#: kio/global.cpp:337
#, c-format
msgid ""
"Unknown proxy host\n"
"%1"
msgstr "Вакили ношинос хӯҷаин.%1"

#: kio/global.cpp:340
