#: main.cpp:49
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"Файли дурдастро боз карда ва дар - KIO Exec "
"сурати мушоҳидаи тағйироти барои "
"боргузориро савол мекунад"

#: main.cpp:55
msgid "Treat URLs as local files and delete them afterwards"
msgstr ""
"URL-ро ҳамчун файлҳои локалӣ коркард "
"намоед ва баъди итмоми кор ҳузф намоед"

#: main.cpp:56
msgid "Command to execute"
msgstr "Дастури мавриди иҷро"

#: main.cpp:57
msgid "URL(s) or local file(s) used for 'command'"
msgstr ""
"Нишона(ҳои) интернете ё файли(ҳои) локалӣ "
"мавриди истифода барои дастур қарор "
"гирифтанд"

#: main.cpp:73
msgid ""
"'command' expected.\n"
msgstr ""
"'дастур' лозим аст.\n"

#: main.cpp:98
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"Нишони интернетии %1\n"
"нодуруст аст"

#: main.cpp:100
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Нишони интернетии дурдасти %1\n"
"ғайриқобили истифода бо калиди --tempfiles"

#: main.cpp:227
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Файли зоҳиран муваққатӣ\n"
"%1\n"
"тағйир дода шудааст.\n"
"Оё ҳанӯз мехоҳед онро ҳузф кунед?"

#: main.cpp:228 main.cpp:235
msgid "File Changed"
msgstr "Файли тағйир кардашуда"

#: main.cpp:234
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Файли\n"
"%1\n"
"тағйир кардааст.\n"
"Оё мехоҳед тағйиротро бор кунед?"

#: main.cpp:262
msgid "KIOExec"
msgstr "KIOExec"

