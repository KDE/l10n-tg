#: part/kateprinter.cpp:71
#, c-format
msgid "Print %1"
msgstr "Чопи %1"

#: part/kateprinter.cpp:201
msgid "(Selection of) "
msgstr "(Ҷудо кардан) "

#: part/kateprinter.cpp:308 part/kateprinter.cpp:523
#, c-format
msgid "Typographical Conventions for %1"
msgstr "Созишномаҳои Матбаа барои %1"

#: part/kateprinter.cpp:632
msgid "Te&xt Settings"
msgstr "&Танзимотҳои Матн"

#: part/kateprinter.cpp:637
msgid "Print &selected text only"
msgstr "Танҳо матни &интихобшударо чоп кунед"

#: part/kateprinter.cpp:640
msgid "Print &line numbers"
msgstr "Хати &рақамҳоро чоп кунед"

#: part/kateprinter.cpp:643
msgid "Print syntax &guide"
msgstr "Роҳнамои синтакси &чоп"

#: part/kateprinter.cpp:652
msgid ""
"<p>This option is only available if some text is selected in the "
"document.</p>"
"<p>If available and enabled, only the selected text is printed.</p>"
msgstr ""
"<p>Ин интихоб дастрас аст, агар қисми матн "
"дар ҳуҷҷат махсус қайд карда шуд.</p> "
"<p>Агар ин тавр бошад, танҳо қисми матн "
"махсус қайд карда шударо чоп мешавад .</p>"

#: part/kateprinter.cpp:655
msgid ""
"<p>If enabled, line numbers will be printed on the left side of the "
"page(s).</p>"
msgstr ""
"<p>Агар ин фаъол аст, хати рақамҳо аз "
"тарафи чап дар саҳифа(ҳо) чоп карда "
"мешавад.</p>"

#: part/kateprinter.cpp:657
msgid ""
"<p>Print a box displaying typographical conventions for the document type, "
"as defined by the syntax highlighting being used."
msgstr ""
"<p>Ахборот дар бораи созиши матбаа, "
"ҳамроҳи намуди ҳуҷҷат ва аз таг равшан "
"кардани синтаксис чоп мешавад."

#: part/kateprinter.cpp:693
msgid "Hea&der && Footer"
msgstr "Сар&лавҳаи асосӣ && Сарлавҳаи поен"

#: part/kateprinter.cpp:701
msgid "Pr&int header"
msgstr "Са&рлавҳае чоп кунед"

#: part/kateprinter.cpp:703
msgid "Pri&nt footer"
msgstr "Сар&лавҳаи поён чоп кунед"

#: part/kateprinter.cpp:708
msgid "Header/footer font:"
msgstr "Ҳарфи сарлавҳаи асосӣ/сарлавҳаи поён:"

#: part/kateprinter.cpp:713
msgid "Choo&se Font..."
msgstr "&Интихоби ҳарф..."

#: part/kateprinter.cpp:717
msgid "Header Properties"
msgstr "Хусусиятҳои сарлавҳа"

#: part/kateprinter.cpp:720
msgid "&Format:"
msgstr "&Андоза:"

#: part/kateprinter.cpp:727 part/kateprinter.cpp:748
msgid "Colors:"
msgstr "Рангҳо:"

#: part/kateprinter.cpp:730 part/kateprinter.cpp:751
msgid "Foreground:"
msgstr "Заминаи пеш:"

#: part/kateprinter.cpp:733
msgid "Bac&kground"
msgstr "За&мина"

#: part/kateprinter.cpp:736
msgid "Footer Properties"
msgstr "Хосиятҳои "

#: part/kateprinter.cpp:740
msgid "For&mat:"
msgstr "Анд&оза:"

#: part/kateprinter.cpp:754
msgid "&Background"
msgstr "&Замина"

#: part/kateprinter.cpp:781
msgid "<p>Format of the page header. The following tags are supported:</p>"
msgstr ""
"<p>Андозаи унвони саҳифа дар боло. "
"Ҳошияҳои додашуда истифода баред:</p> "

#: part/kateprinter.cpp:783
msgid ""
"<ul>"
"<li><tt>%u</tt>: current user name</li>"
"<li><tt>%d</tt>: complete date/time in short format</li>"
"<li><tt>%D</tt>: complete date/time in long format</li>"
"<li><tt>%h</tt>: current time</li>"
"<li><tt>%y</tt>: current date in short format</li>"
"<li><tt>%Y</tt>: current date in long format</li>"
"<li><tt>%f</tt>: file name</li>"
"<li><tt>%U</tt>: full URL of the document</li>"
"<li><tt>%p</tt>: page number</li></ul>"
"<br><u>Note:</u> Do <b>not</b> use the '|' (vertical bar) character."
msgstr ""
"<ul>"
"<li><tt>%u</tt>: номи истифодакунандаи "
"равон</li>"
"<li><tt>%d</tt>: таърих/вақт дар андозаи кӯтоҳ "
"пур кунед</li>"
"<li><tt>%D</tt>: таърих/вақт дар андозаи дароз "
"пур кунед</li>"
"<li><tt>%h</tt>: вақти равон</li>"
"<li><tt>%y</tt>: таърихи равон дар андозаи "
"кӯтоҳ</li>"
"<li><tt>%Y</tt>: таърихи равон дар андозаи "
"дароз</li>"
"<li><tt>%f</tt>: номи файл</li>"
"<li><tt>%U</tt>: URL-и ҳуҷҷат пур кунед</li>"
"<li><tt>%p</tt>: рақами саҳифа</li></ul>"
"<br><u>Шарҳ:</u> Истифода<b>набаред</b> аломати "
"'|' (хати амудӣ)."

#: part/kateprinter.cpp:797
msgid "<p>Format of the page footer. The following tags are supported:</p>"
msgstr ""
"<p>Андозаи унвони саҳифа дар поён. "
"Ҳошияҳои додашуда истифода баред:</p>"

#: part/kateprinter.cpp:901
msgid "L&ayout"
msgstr "Тақсимоти &забонак"

#: part/kateprinter.cpp:908 part/kateschema.cpp:776
msgid "&Schema:"
msgstr "&Нақша:"

#: part/kateprinter.cpp:912
msgid "Draw bac&kground color"
msgstr "Кашидани &ранги замина"

#: part/kateprinter.cpp:915
msgid "Draw &boxes"
msgstr "Кашидани &қуттиҳо"

#: part/kateprinter.cpp:918
msgid "Box Properties"
msgstr "Хосиятҳои қутти"

#: part/kateprinter.cpp:921
msgid "W&idth:"
msgstr "Вас&еъӣ:"

#: part/kateprinter.cpp:925
msgid "&Margin:"
msgstr "&Сарҳад:"

#: part/kateprinter.cpp:929
msgid "Co&lor:"
msgstr "Ра&нг:"

#: part/kateprinter.cpp:947
msgid ""
"<p>If enabled, the background color of the editor will be used.</p>"
"<p>This may be useful if your color scheme is designed for a dark "
"background.</p>"
msgstr ""
"<p>Агар ин фаъол аст, ранги заминаи "
"муҳаррир истифода карда мешавад.</p> "
"<p>Ин бисёре фойданок аст, агар ранги "
"заминаи муҳаррири шумоторик мебошад.</p>"

#: part/kateprinter.cpp:950
msgid ""
"<p>"
"If enabled, a box as defined in the properties below will be drawn around "
"the contents of each page. The Header and Footer will be separated from the "
"contents with a line as well.</p>"
msgstr ""
"<p>Агар ин фаъол аст, дар ҳамаи саҳифаҳо "
"дар гирдогирди матн чорчӯбаҳо расм "
"кашида мешавад. Унвони саҳифаҳоро аз мант "
"бо як хат ҷудо карда мешаванд.</p>"

#: part/kateprinter.cpp:954
msgid "The width of the box outline"
msgstr "Фарохи чорчӯба"

#: part/kateprinter.cpp:956
msgid "The margin inside boxes, in pixels"
msgstr ""
"Андозаи фосилаи мант аз чорчӯба дар "
"нуқтаҳо"

#: part/kateprinter.cpp:958
msgid "The line color to use for boxes"
msgstr "Ранги хат барои истифодаи қуттиҳо"

#: part/katebookmarks.cpp:77
msgid "Set &Bookmark"
msgstr "&Гузориши оянда"

#: part/katebookmarks.cpp:80
msgid "If a line has no bookmark then add one, otherwise remove it."
msgstr ""
"Агар дар ин сатр гузорише монда набошад, "
"он гузошта хоҳад шуд. Агар он дар онҷо "
"вуҷуд бошад, он гирифта хоҳад шуд."

#: part/katebookmarks.cpp:81
msgid "Clear &Bookmark"
msgstr "&Монданиро ҳузф кунед"

#: part/katebookmarks.cpp:84
msgid "Clear &All Bookmarks"
msgstr "Тамоми гузоришҳоро &тасҳеҳ диҳед"

#: part/katebookmarks.cpp:87
msgid "Remove all bookmarks of the current document."
msgstr "Ҳама монданҳо дар ин ҳуҷҷат нобуд кунед."

#: part/katebookmarks.cpp:90 part/katebookmarks.cpp:241
msgid "Next Bookmark"
msgstr "Мондани оянда"

#: part/katebookmarks.cpp:93
msgid "Go to the next bookmark."
msgstr "Ба мондани оянда равед."

#: part/katebookmarks.cpp:96 part/katebookmarks.cpp:243
msgid "Previous Bookmark"
msgstr "Мондани пешина"

#: part/katebookmarks.cpp:99
msgid "Go to the previous bookmark."
msgstr "Ба мондани пешина ревед."

#: part/katebookmarks.cpp:202
msgid "&Next: %1 - \"%2\""
msgstr "&Оянда: %1 - \"%2\""

#: part/katebookmarks.cpp:209
msgid "&Previous: %1 - \"%2\""
msgstr "&Пешина: %1 - \"%2\""

