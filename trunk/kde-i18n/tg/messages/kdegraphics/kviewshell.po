msgstr ""
"<qt><strong>Файли хатогӣ!</strong> Файлро ғайри "
"фишурдан карда натавонист "
"<nobr><strong>%1</strong></nobr>. Файл бор карда "
"намешавад.</qt>"

#: kviewpart.cpp:515
msgid ""
"<qt>This error typically occurs if the file is corrupt. If you want to be "
"sure, try to decompress the file manually using command-line tools.</qt>"
msgstr ""

