msgstr "Намуд: Raw "

#: kfax.cpp:1758
msgid "KDE G3/G4 Fax Viewer"
msgstr "Намоишгари Факси KDE G3/G4"

#: kfax.cpp:1763
msgid "Fine resolution"
msgstr "Ҳалли мураттаб"

#: kfax.cpp:1765
msgid "Normal resolution"
msgstr "Ҳалли оддӣ"

#: kfax.cpp:1766
msgid "Height (number of fax lines)"
msgstr "Дарозӣ (миқдори хати факс)"

#: kfax.cpp:1768
msgid "Width (dots per fax line)"
msgstr "Васеъӣ (нуқтаҳо дар хати факс)"

#: kfax.cpp:1770
msgid "Turn image 90 degrees (landscape mode)"
msgstr "Гардондани дар 90 дараҷа (тамоюли албом)"

#: kfax.cpp:1772
msgid "Turn image upside down"
msgstr "Тасвири аз боло то поён гардондан"

#: kfax.cpp:1774
msgid "Invert black and white"
msgstr "Сиёҳ ва сафедро бадалкунӣ кардан."

#: kfax.cpp:1776
msgid "Limit memory use to 'bytes'"
msgstr "Сарҳади фоидабории ҳофиза дар байтҳо."

#: kfax.cpp:1778
msgid "Fax data is packed lsb first"
msgstr "Бастани маълумоти факс бо аввалин."

#: kfax.cpp:1779
msgid "Raw files are g3-2d"
msgstr "Файлҳои қаторӣ аз гурӯҳи g3-2d"

#: kfax.cpp:1780
msgid "Raw files are g4"
msgstr "Файлҳои қаторӣ аз гурӯҳи g4"

#: kfax.cpp:1781
msgid "Fax file(s) to show"
msgstr "Намоиши файл(ҳо)и факс"

#: kfax.cpp:1791
msgid "UI Rewrite, lots of code cleanups and fixes"
msgstr ""
"Нусхабардории интерфейс, покиза кардани "
"рамзҳо ва ислоҳи хатоҳо"

#: kfax.cpp:1839
msgid ""
"A file with this name already exists.\n"
"Do you want to overwrite it?"
msgstr ""
"Файл бо ҳамин ном боз вуҷуд доштад.\n"
"Шумо ин ҳуҷҷат нусха бардоштан меҳоҳед?"

#: faxinput.cpp:111
msgid ""
"Unable to open:\n"
"%1\n"
msgstr ""
"Кушода наметавонам:\n"
"%1\n"

#: print.cpp:52
msgid "Print Dialog"
msgstr "Диалоги чопи KFax"

#: print.cpp:60
msgid "Print as PostScript to printer"
msgstr "Ҳамчун PostScript дар принтер чоп кардан"

#: print.cpp:68
msgid "Print command:"
msgstr "Фармони чоп:"

#: print.cpp:77
msgid "Print as PostScript to file:"
msgstr "Ҳамчун PostScript дар файл чоп кардан:"

#: print.cpp:89
msgid "Page size:"
msgstr "Андозаи варақ:"

#: print.cpp:107
msgid "Scale fax to page size"
msgstr ""
"Факс то андозаи саҳифа кашида васеъ "
"кардан"

#: print.cpp:112
msgid "Add printer margins (measured in cm):"
msgstr "Иловаи сарҳадҳои чопгар (см):"

#: print.cpp:122
msgid "Horizontal:"
msgstr "Ба таври уфуқӣ:"

#: print.cpp:131
msgid "Vertical:"
msgstr "Ба таври амудӣ:"

#: print.cpp:241
msgid "You must enter a file name if you wish to print to a file."
msgstr ""
"Шумо номи файл бояд монед, агар шумо дар "
"файл чоп кардан меҳоҳед."

#: print.cpp:249
msgid ""
"You must enter a print command such as \"lpr\"\n"
" if you wish to print to a printer."
msgstr ""
"Шумо фармони чоп бояд монед, ба байни "
"ҳамчун \"lpr\",\n"
" агар шумо дар чопгар чоп кардан меҳоҳед."

