msgid "KDE G3/G4 Fax Viewer"
msgstr "Намоишгари Факси KDE G3/G4"

#: kfax.cpp:1753
msgid "Fine resolution"
msgstr "Ҳалли мураттаб"

#: kfax.cpp:1755
msgid "Normal resolution"
msgstr "Ҳалли оддӣ"

#: kfax.cpp:1756
msgid "Height (number of fax lines)"
msgstr "Дарозӣ (миқдори хати факс)"

