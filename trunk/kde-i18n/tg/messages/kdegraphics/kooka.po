#: kocrgocr.cpp:136
msgid ""
"The numeric value gray pixels are \n"
"considered to be black.\n"
"\n"
"Default is 160"
msgstr ""
"Аҳамияти рақамӣ, ки нуқтаҳои хокистаранг\n"
