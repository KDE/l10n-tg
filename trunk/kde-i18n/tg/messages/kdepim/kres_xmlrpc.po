#: kabc_resourcexmlrpc.cpp:253
msgid "Login failed, please check your username and password."
msgstr "Логин вуҷуд надорад илтимос номи истифодабаранда ва номи шабро аз назар гузаронед."

#: kabc_resourcexmlrpc.cpp:272
