#: main.cpp:79
msgid "Print this help and exit"
msgstr "Хориҷ кардани справка ва баромадан"

#: main.cpp:81
msgid "Print helpful runtime messages"
msgstr "Хориҷ кардани хабарҳои фоиданоки як сӯ монда"

#: main.cpp:83
msgid "Print what would have been done, but do not execute"
msgstr "Нишон додан чӣ хоҳад кард, вале карда нашуд"

#: main.cpp:85
msgid "Specify which calendar you want to use"
msgstr " Тақвимӣ истифодашавандаро нишон диҳед"

#: main.cpp:88
msgid "Major operation modes:"
msgstr "Тартиботҳои асосӣ:"

#: main.cpp:90
msgid "  Print calendar events in specified export format"
msgstr "Рӯӣдодҳои тақвимро ба нишондоди андозаи экспорт баровардан"

#: main.cpp:92
msgid "  Insert an event into the calendar"
msgstr "Ҳодисаро ба тақвим даровардан"

#: main.cpp:94
msgid "  Modify an existing calendar event"
msgstr "Ҳодисаро тағир додан"

#: main.cpp:96
msgid "  Remove an existing calendar event"
msgstr "Ҳодисаро нест кардан"

#: main.cpp:98
msgid "  Create new calendar file if one does not exist"
msgstr "Фаӣли нави тақвимро сохтан, агар нишондодаамон мавҷуд набошад"

#: main.cpp:100
msgid "  Import this calendar to main calendar"
msgstr "Воридоти тақвими нишондод ба асоси"

#: main.cpp:103
msgid "Operation modifiers:"
msgstr " Тағирёбандаҳо"

#: main.cpp:105
msgid "  View all calendar entries"
msgstr "Ҳодисаҳои тақвимро дида баромадан"

#: main.cpp:107
msgid "  View next activity in calendar"
msgstr "Ҳодисаи аз пеш меомадаи тақвимро дида баромадан"

#: main.cpp:109
msgid "  From start date show next # days' activities"
msgstr "Аз ҳамин рӯз сар карда ҳодисаҳои рӯзҳоӣ меомадаро # нишон додан"

#: main.cpp:111
msgid "  Event Unique-string identifier"
msgstr "Идентификатори беҳамтои ҳодиса"

#: main.cpp:113
msgid "  Start from this day [YYYY-MM-DD]"
msgstr "Аз рӯзи нишондод сар кунед [YYYY-MM-DD]"

#: main.cpp:115
msgid "  Start from this time [HH:MM:SS]"
msgstr "Аз ҳамин вақт сар кунед [HH:MM:SS]"

#: main.cpp:117
msgid "  End at this day [YYYY-MM-DD]"
msgstr "Дар рӯзи нишондод ба анҷом расонед [YYYY-MM-DD]"

#: main.cpp:119
msgid "  End at this time [HH:MM:SS]"
msgstr ""
"Дар вақти нишондод ба анҷом расонед "
"[HH:MM:SS]"

#: main.cpp:121
msgid " Start from this time [secs since epoch]"
msgstr "Аз ҳамин вақт сар кунед[secs since epoch]"

#: main.cpp:123
msgid "  End at this time [secs since epoch]"
msgstr ""
"Дар ҳамин вақт ба анҷом расонед "
"[secs since epoch]"

#: main.cpp:125
msgid "  Add summary to event (for add/change modes)"
msgstr "Натиҷаҳои ҳодисаҳоро ҳамроҳ кардан (бо фармонҳои ҳамроҳ кардан/дигаргун кардан кор мекунад)"

#: main.cpp:127
msgid "Add description to event (for add/change modes)"
msgstr "Тасвирро ба ҳодиса ҳамроҳ кунед(бо фармонҳои ҳамроҳ кардан/дигаргун кардан кор мекунад)"

#: main.cpp:129
msgid "  Add location to event (for add/change modes)"
msgstr ""
"Ҷоӣгиршавиро ба ҳодиса Ҳамрҳ кунед "
"(бо фармонҳои ҳамроҳ кардан/дигаргун кардан кор мекунад)"

#: main.cpp:131
msgid "Export options:"
msgstr "Сохтани содирот:"

#: main.cpp:133
msgid "Export file type (Default: text)"
msgstr "Навъҳои содироти фаӣлҳо (Default: text)"

#: main.cpp:135
msgid "Export to file (Default: stdout)"
msgstr "Содирот кардан ба фаӣл (Default: stdout)"

#: main.cpp:137
msgid "  Print list of export types supported and exit"
msgstr "Хеълҳои нигоҳдошта шударо барои содирот бароварда, баромадан лозим аст"

#: main.cpp:140
msgid ""
"Examples:\n"
"  konsolekalendar --view\n"
"  konsolekalendar --add --date 2003-06-04 --time 10:00 --end-time 12:00 \\\n"
"                  --summary \"Doctor Visit\" --description \"Get My Head "
"Examined\"\n"
"  konsolekalendar --delete --uid KOrganizer-1740326.803"
msgstr ""
"Намунаҳо:\n"
"  konsolekalendar --view\n"
"  konsolekalendar --add --date 2003-06-04 --time 10:00 --end-time 12:00 \\\n"
"                  --summary \"Ба духтур рафтан\" --description "
"\"Сарамро нишон додан даркор аст\"\n"
"  konsolekalendar --delete --uid KOrganizer-1740326.803"

#: main.cpp:149
msgid ""
"For more information visit the program home page at:\n"
"  http://pim.kde.org/components/konsolekalendar.php"
msgstr ""
"Агар хоҳед, ки бисёртар иттиллоот дастрас кунед, шумо аз ин адрес истифода бурда метавонед: \n"
"  http://pim.kde.org/components/konsolekalendar.php"

#: main.cpp:171
msgid "Primary Author"
msgstr "Муаллифи асосӣ"

#: main.cpp:177
msgid "Author"
msgstr "Муаллиф"

#: main.cpp:241
msgid ""
"\n"
"KonsoleKalendar supports these export formats:\n"
"  Text [Default]\n"
"  Short (like Text, but more compact)\n"
"  HTML\n"
"  CSV (Comma-Separated Values)\n"
msgstr ""
"\n"
"KonsoleKalendar форматҳои содироти зеринро "
"пуштибонӣ мекунад:\n"
"  Text [Пешфарзӣ]\n"
"  Short (формати матнии майдаи зич)\n"
"  HTML\n"
"  CSV (рӯйхати аҳамияте, ки бо вергул ҷудо шудааст)\n"

#: main.cpp:271
#, c-format
msgid "Invalid Export Type Specified: %1"
msgstr "Рӯӣхати нодурусти содирот нишон дода шудааст : %1"

#: main.cpp:446
#, c-format
msgid "Invalid Start Date Specified: %1"
msgstr "Санаи ногдурусти саршавӣ нишон дода шудааст: %1"

#: main.cpp:472
#, c-format
msgid "Invalid Start Time Specified: %1"
msgstr "Вақти ногдурусти саршавӣ нишон дода шудааст: %1"

#: main.cpp:503
#, c-format
msgid "Invalid End Date Specified: %1"
msgstr "Санаи нодурусти итмомоти зерин ишора шудааст: %1"

#: main.cpp:529
#, c-format
msgid "Invalid Date Count Specified: %1"
msgstr "Миқдори рӯзҳои нодуруст нишон дода шудааст: %1"

#: main.cpp:558
#, c-format
msgid "Invalid End Time Specified: %1"
msgstr "Вақти тамомшавии нодуруст ишон дода шудааст: %1"

#: main.cpp:646
msgid "Calendar %1 already exists"
msgstr "Тақвими %1 мавҷуд аст"

#: main.cpp:652
msgid "Calendar %1 successfully created"
msgstr "Тақвим %1 хушбахтона сохта шуд"

#: main.cpp:657
#, c-format
msgid "Unable to create calendar: %1"
msgstr "Имконият нест, ки тақвим сохта шавад: %1"

#: main.cpp:665
#, c-format
msgid "Calendar file not found %1"
msgstr "Фаӣли тақвим ёфта нашуд  %1"

#: main.cpp:668
msgid "Try --create to create new calendar file"
msgstr "Кӯшиш кунед, ки фаӣли нави тақвим созед"

#: main.cpp:821
msgid ""
"Only 1 operation mode (view, add, change, delete, create) permitted at any "
"one time"
msgstr "Танҳо як навъи амалиет, ( дида баромадан, ҳамроҳ кардан, дигаргун кардан, нест кардан, сохтан) якҷоя иҷозат дода шудааст"

#: main.cpp:831
msgid "Ending Date/Time occurs before the Starting Date/Time"
msgstr "Сана/вақти тамомшави аз санаи/вақти саршави барвақтар сар мешавад"

#: main.cpp:852
msgid "Calendar %1 successfully imported"
msgstr "Тақвим %1 хурсандона импорт карджа шуд"

#: main.cpp:857
#, c-format
msgid "Unable to import calendar: %1"
msgstr "Тақвимро ворид кардан имконпазир нест: %1"

#: main.cpp:873
msgid "Attempting to insert an event that already exists"
msgstr "Сайъи гузориши воқеъот, ки аллакай дар тақвимот мавҷуд аст"

#: main.cpp:884 main.cpp:904
msgid "Missing event UID: use --uid command line option"
msgstr ""
"Идентификатори UID ишора нашудааст: онро дар интихоботи --uid "
"ишора кунед"

#: main.cpp:890
msgid "No such event UID: change event failed"
msgstr ""
"Воқеа бо идентификатори UID вуҷуд надорад: "
"воқеъот тағйир дода шуда набуд"

#: main.cpp:910
msgid "No such event UID: delete event failed"
msgstr ""
"Воқеа бо идентификатори UID вуҷуд надорад: "
"воқеъот ҳузф карда шуда набуд"

#: main.cpp:924
#, c-format
msgid "Cannot open specified export file: %1"
msgstr "Наметавонам файли зеринро барои содирот боз кунам: %1"

