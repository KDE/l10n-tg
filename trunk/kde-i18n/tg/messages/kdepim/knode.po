#: knarticlewidget.cpp:1213
msgid "Cannot find a signature in this message."
msgstr "Наметавонам имзоот дар ин иттилоот ёбам."

#: knarticlewidget.cpp:1221
#, c-format
msgid "Message was signed with unknown key 0x%1."
msgstr ""
"Иттилоот бо калиди номаълуми 0x%1 навишта "
"шудааст."

#: knarticlewidget.cpp:1224
msgid "The validity of the signature cannot be verified."
msgstr "Саҳеҳияти имзо наметавонад озмоида шавад."

#: knarticlewidget.cpp:1241
msgid "Message was signed by %1 (Key ID: 0x%2)."
msgstr "Ахборот бо %1 имзо шудааст (калид: 0x%2)."

#: knarticlewidget.cpp:1245
#, c-format
msgid "Message was signed by %1."
msgstr "Ахборот бо %1 имзо шудааст."

#: knarticlewidget.cpp:1253
msgid "The signature is valid, but the key's validity is unknown."
msgstr ""
"Имзоот саҳеҳ аст, аммо дурустии калид "
"номаълум аст."

#: knarticlewidget.cpp:1257
msgid "The signature is valid and the key is marginally trusted."
msgstr ""
"Имзоот саҳеҳ аст, аммо дурустии калид "
"шубҳаовар аст."

#: knarticlewidget.cpp:1261
msgid "The signature is valid and the key is fully trusted."
msgstr ""
"Имзоот саҳеҳ аст ва ба калид метавон "
"пурра боварӣ кард."

#: knarticlewidget.cpp:1265
msgid "The signature is valid and the key is ultimately trusted."
msgstr ""
"Имзоот саҳеҳ аст ва ба калид метавон "
"комилан боварӣ кард."

#: knarticlewidget.cpp:1269
msgid "The signature is valid, but the key is untrusted."
msgstr ""
"Имзоот саҳеҳ аст аммо ба калид боварӣ "
"кардан мумкин нест."

#: knarticlewidget.cpp:1275
msgid "Warning: The signature is bad."
msgstr "Таваҷҷӯъ: имзои ғайрисаҳеҳ."

#: knarticlewidget.cpp:1302
msgid ""
"<br><bodyblock><b>This article has the MIME type "
"&quot;message/partial&quot;, which KNode cannot handle yet."
"<br>Meanwhile you can save the article as a text file and reassemble it by "
"hand.</b></bodyblock></qt>"
msgstr ""
"<br><bodyblock><b>Мақолот дорои навъи MIME "
"&quot;message/partial&quot; мебошад, ки ҳоло бо KNode "
"пуштибонӣ намешавад."
"<br>Шумо метавонед ин мақолотро ба монанди "
"файли матнӣ нигоҳ доред ва дастӣ сайъ ба "
"хондани он шавед.</b></bodyblock></qt>"

