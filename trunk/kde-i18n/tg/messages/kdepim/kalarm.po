msgid ""
"_: hours:minutes\n"
" %1:%2 "
msgstr " %1:%2 "

#: alarmlistview.cpp:406
msgid ""
"_: days hours:minutes\n"
" %1d %2:%3 "
msgstr " %1d %2:%3 "

#: alarmtimewidget.cpp:72
msgid ""
"If a recurrence is configured, the start date/time will be adjusted to the "
"first recurrence on or after the entered date/time."
msgstr ""
"Агар такророт танзим шуда бошад, сана/муддати "
"ибтидоӣ ба такроршавии аввала дар/баъди сана/муддати "
"ишорашуда низ сабт карда хоҳад шуд."

#: alarmtimewidget.cpp:84
msgid "&Defer to date/time:"
msgstr "&Монондан ба санаи/муддати:"

#: alarmtimewidget.cpp:84
msgid "At &date/time:"
msgstr "&Ба санаи/муддати:"

#: alarmtimewidget.cpp:87
msgid "Reschedule the alarm to the specified date and time."
msgstr "Монондани хотиррасонӣ ба санаи/муддати дигар."

#: alarmtimewidget.cpp:88
msgid "Schedule the alarm at the specified date and time."
msgstr ""
"Хотиррасонӣ кардан дар сана ва муддати "
"ишорашуда."

#: alarmtimewidget.cpp:94
msgid "Enter the date to schedule the alarm."
msgstr "Санаи хотиррасониро ворид кунед."

#: alarmtimewidget.cpp:106
msgid "Enter the time to schedule the alarm."
msgstr "Муддати хотиррасониро ворид кунед."

#: alarmtimewidget.cpp:120 editdlg.cpp:267
msgid "An&y time"
msgstr "Дар &ҳар муддат"

#: alarmtimewidget.cpp:123
msgid "Schedule the alarm for any time during the day"
msgstr "Дар ҳар муддати рӯзи ишорашуда хотиррасонӣ кардан"

#: alarmtimewidget.cpp:127
msgid "Defer for time &interval:"
msgstr "Монондан ба &муддати муайян:"

#: alarmtimewidget.cpp:127
msgid "Time from no&w:"
msgstr "&Баъд аз:"

#: alarmtimewidget.cpp:131
msgid "Reschedule the alarm for the specified time interval after now."
msgstr ""
"Хотиррасониро ба танаффуси муваққатии ишорашуда "
"монондан."

#: alarmtimewidget.cpp:132
msgid "Schedule the alarm after the specified time interval from now."
msgstr ""
"Хотиррасониро баъд аз танаффуси муваққатии "
"ишорашуда муайян намудан."

#: alarmtimewidget.cpp:139
msgid ""
"Enter the length of time (in hours and minutes) after the current time to "
"schedule the alarm."
msgstr ""
"Вақтро ворид кунед (соат ва дақиқа), аз кадоме "
"хотиррасониро намоиш додан лозим аст."

#: alarmtimewidget.cpp:220
msgid "Invalid date"
msgstr "Санаи нодуруст"

#: alarmtimewidget.cpp:227 alarmtimewidget.cpp:266
msgid "Invalid time"
msgstr "Вақти нодуруст"

#: alarmtimewidget.cpp:241
msgid "Alarm date has already expired"
msgstr "Санаи хотиррасонӣ аллакай гузашт"

#: alarmtimewidget.cpp:253
msgid "Alarm time has already expired"
msgstr "Муддати хотиррасонӣ аллакай гузашт"

#: birthdaydlg.cpp:70
msgid "Import Birthdays From KAddressBook"
msgstr "Воридоти рӯзҳои таваллуд аз китоби адресии KDE"

#: birthdaydlg.cpp:81
msgid "Birthday: "
msgstr "Рӯзи таваллуд:"

#: birthdaydlg.cpp:84
msgid "Alarm Text"
msgstr "Матни хотиррасонӣ"

#: birthdaydlg.cpp:86
msgid "Pre&fix:"
msgstr "&Префикс:"

#: birthdaydlg.cpp:93
msgid ""
"Enter text to appear before the person's name in the alarm message, "
"including any necessary trailing spaces."
msgstr ""
"Матнро ворид кунед, ки пеш аз номи одам дар "
"хотиррасонӣ ва ҳамчунин фосилотҳои лозимиро "
"барои ҷудо кардани ном низ намоиш хоҳад шавад."

#: birthdaydlg.cpp:96
msgid "S&uffix:"
msgstr "&Суффикс:"

#: birthdaydlg.cpp:103
msgid ""
"Enter text to appear after the person's name in the alarm message, including "
"any necessary leading spaces."
msgstr ""
"Матнро ворид кунед, ки баъд аз номи одам дар "
"хотиррасонӣ ва ҳамчунин фосилотҳои лозимиро "
"барои ҷудо кардани ном низ намоиш хоҳад шавад."

#: birthdaydlg.cpp:106
msgid "Select Birthdays"
msgstr "Интихоби рӯзҳои таваллуд"

#: birthdaydlg.cpp:115 templatelistview.cpp:55
msgid "Name"
msgstr "Ном"

#: birthdaydlg.cpp:116
msgid "Birthday"
msgstr "Рӯзи таваллуд"

#: birthdaydlg.cpp:119
msgid ""
"Select birthdays to set alarms for.\n"
"This list shows all birthdays in KAddressBook except those for which alarms "
"already exist.\n"
"\n"
"You can select multiple birthdays at one time by dragging the mouse over the "
"list, or by clicking the mouse while pressing Ctrl or Shift."
msgstr ""
"Интихоби рӯзи таваллуд барои эҷоди "
"хотиррасонӣ.\n"
"Ин рӯйхат тамоми рӯзҳои таваллудро "
"ба китоби адресии KDE ғайр аз онҳое, ки "
"барояшон хотиррасонӣ аллакай фаъол аст, "
"нишон медиҳад.\n"
"Шумо метавонед якчанд рӯзи таваллудро ба "
"як маротиба бо гузаронидани маконнамои муш "
"аз рӯи рӯйхат ҳангоми пахши тугмаи чап "
"низ интихоб кунед ё инки метавон рӯзҳои таваллудро "
"бо муш ва бо якҷоя пахш намудани тугмаҳои Ctrl ё Shift "
"интихоб намоед."

#: birthdaydlg.cpp:124
msgid "Alarm Configuration"
msgstr "Танзимоти хотиррасонӣ"

#: birthdaydlg.cpp:149
msgid "&Reminder"
msgstr "&Хотиррасонӣ"

#: birthdaydlg.cpp:150
msgid "Check to display a reminder in advance of the birthday."
msgstr ""
"Нишон додани пешнамоишотҳои хотиррасон дар бораи "
"рӯзҳои таваллуд."

#: birthdaydlg.cpp:151
msgid ""
"Enter the number of days before each birthday to display a reminder. This is "
"in addition to the alarm which is displayed on the birthday."
msgstr ""
"Даврро ба рӯзҳо ворид кунед, ки "
"барои хотиррасонӣ доир ба рӯзи "
"таваллуд лозим аст. Ин хотиррасонӣ "
"иловагӣ ба хотиррасонии худи рӯзи таваллуд "
"сабт карда мешавад."

#: birthdaydlg.cpp:175 editdlg.cpp:390
msgid "Special Actions..."
msgstr "Амалҳои махсус..."

#: birthdaydlg.cpp:219
msgid "Error reading address book"
msgstr "Хатои боз кардани китоби адресӣ"

#: daemon.cpp:109
msgid "Alarm Daemon not found"
msgstr "Демони соати зангдори рӯимизӣ ёфт нашуд"

#: daemon.cpp:188
msgid ""
"Cannot enable alarms:\n"
"Failed to register with Alarm Daemon (%1)"
msgstr ""
"Наметавонам хотиррасониро фаъол созам:\n"
"ба демони соати зангдори рӯимизӣ, васл "
"кардан имконпазир нест (%1)"

#: daemon.cpp:221
msgid ""
"Cannot enable alarms:\n"
"Failed to start Alarm Daemon (%1)"
msgstr ""
"Наметавонам хотиррасониро фаъол созам:\n"
"демони соати зангдори рӯимизиро ба кор сар "
"додан имконпазир нест (%1)"

#: daemon.cpp:343
msgid ""
"_: Control the Alarm Daemon\n"
"Control Alarm &Daemon..."
msgstr ""
"Идоракунӣ бо &демони соати зангдори рӯимизӣ "
"имконпазир нест..."

#: daemon.cpp:347
msgid "Configure Alarm &Daemon..."
msgstr "Танзимоти демони &соати зангдори рӯимизӣ..."

#: daemongui.cpp:295
msgid "&Alarms Enabled"
msgstr "&Фаъол сохтани соати зангдори рӯимизӣ"

#: daemongui.cpp:295
msgid "Enable &Alarms"
msgstr "Фаъол сохтани &хотиррасонӣ"

#: deferdlg.cpp:54
msgid "Cancel &Deferral"
msgstr "&Барҳам додани таъхирот"

#: deferdlg.cpp:68
msgid "Defer the alarm until the specified time."
msgstr "Хотиррасониро ба дигар вақт монондан."

#: deferdlg.cpp:69
msgid "Cancel the deferred alarm. This does not affect future recurrences."
msgstr ""
"Барҳами таъхири хотиррасонӣ. Ин ба "
"дигар такроротҳои хотиррасонӣ тасвир "
"нахоҳад шуд."

#: deferdlg.cpp:126
msgid "Cannot defer past the alarm's next recurrence (currently %1)"
msgstr ""
"Натавонистам хотиррасониро ба гузашта мононам "
"(%1-и равон)"

#: deferdlg.cpp:127
msgid "Cannot defer past the alarm's next reminder (currently %1)"
msgstr ""
"Натавонистам хотиррасонии ояндаро ба гузашта мононам "
"(%1-и равон)"

#: deferdlg.cpp:128
msgid "Cannot defer reminder past the main alarm time (%1)"
msgstr ""
"Натавонистам хотиррасонии асосиро ба гузашта мононам "
"(%1-и равон)"

#: editdlg.cpp:88
msgid "Confirm acknowledgment"
msgstr "Тасдиқот"

#: editdlg.cpp:89
msgid "Confirm ac&knowledgment"
msgstr "&Тасдиқоти қабулкунӣ"

#: editdlg.cpp:90
msgid "Cancel if late"
msgstr "Барҳамдиҳӣ ҳангоми ғайриимконии намоиш"

#: editdlg.cpp:91
msgid "Ca&ncel if late"
msgstr "&Барҳамдиҳӣ ҳангоми ғайриимконии намоиш"

#: editdlg.cpp:92
msgid "Copy email to self"
msgstr ""
"Нусхаи хабари почтаи электрониро ба худ "
"фиристодан."

#: editdlg.cpp:93
msgid "Copy &email to self"
msgstr ""
"&Нусхаи мактубро ба худ "
"фиристодан."

#: editdlg.cpp:94
msgid "Copy email to &self"
msgstr ""
"Нусхаи мактубро &ба худ "
"фиристодан."

#: editdlg.cpp:96
msgid "Auto-close window after this time"
msgstr "Пӯшидани тиреза баъди вақти ишорашуда"

#: editdlg.cpp:97
msgid "Auto-close window after late-cancelation time"
msgstr ""
"Пӯшидани тиреза баъди гузаштани даври "
"дермонӣ"

#: editdlg.cpp:128
msgid "Load Template..."
msgstr "Боргирии қолиб..."

#: editdlg.cpp:136
msgid "Template name:"
msgstr "Номи қолиб:"

#: editdlg.cpp:141
msgid "Enter the name of the alarm template"
msgstr "Номи қолиби хотиррасониро ворид кунед"

#: editdlg.cpp:149
msgid "&Alarm"
msgstr "&Соати зангдори рӯимизӣ"

#: editdlg.cpp:158
msgid "&Recurrence"
msgstr "&Такроршавӣ"

#: editdlg.cpp:167
msgid "Action"
msgstr "Амалиёт"

#: editdlg.cpp:174
msgid "Te&xt"
msgstr "&Матн"

#: editdlg.cpp:177
msgid "If checked, the alarm will display a text message."
msgstr ""
"Ҳангоми фаъол сохтани ин нишона, хотиррасонӣ "
"ба намуди иттилооти матн намоиш дода мешавад."

#: editdlg.cpp:185
msgid "If checked, the alarm will display the contents of a text or image file."
msgstr ""
"Ҳангоми фаъол сохтани ин интихобот, дар дохили"
"нишона оганоти файли матнӣ ё файл бо тасвирот "
"намоиш дода мешавад."

#: editdlg.cpp:190
msgid "Co&mmand"
msgstr "&Дастур"

#: editdlg.cpp:193
msgid "If checked, the alarm will execute a shell command."
msgstr ""
"Ҳангоми фаъол сохтани ин нишона, "
"соати рӯимизии зангдор дастури ҷилдро "
"иҷро мекунад."

#: editdlg.cpp:198
msgid "&Email"
msgstr "&Email"

#: editdlg.cpp:201
msgid "If checked, the alarm will send an email."
msgstr ""
"Ҳангоми фаъол сохтани ин нишона, "
"соати рӯимизии зангдор иттилооти "
"почтаи электрониро мефиристад."

#: editdlg.cpp:215
msgid "Deferred Alarm"
msgstr "Хотиррасонии таъхиршуда"

#: editdlg.cpp:217
msgid "Deferred to:"
msgstr "Гузарондан ба:"

#: editdlg.cpp:221
msgid "C&hange..."
msgstr "&Таъғирдиҳӣ..."

#: editdlg.cpp:224
msgid "Change the alarm's deferred time, or cancel the deferral"
msgstr ""
"Тағйир додани мӯҳлати таъхири хотиррасонӣ "
"ё барҳам додани таъхирот"

#: editdlg.cpp:240
msgid "&Default time"
msgstr "&Вақти пешфарзӣ"

#: editdlg.cpp:244
msgid ""
"Do not specify a start time for alarms based on this template. The normal "
"default start time will be used."
msgstr ""
"Муддати ибтидоиро ба хотиррасонӣ, ки дар ин "
"қолиб асос гузоштааст, ишора накунед. Бояд "
"муддати ибтидоии пешфарзӣ низ истифода "
"шавад."

#: editdlg.cpp:251
msgid "Time:"
msgstr "Вақт:"

#: editdlg.cpp:255
msgid "Specify a start time for alarms based on this template."
msgstr ""
"Муддати ибтидоии барои хотиррасоние, ки ба "
"ин қолиб асос гузоштааст, ишора кунед."

#: editdlg.cpp:262
msgid "Enter the start time for alarms based on this template."
msgstr ""
"Муддати ибтидоии барои хотиррасоние, ки ба "
"ин қолиб асос гузоштааст, ворид кунед."

#: editdlg.cpp:271
msgid "Set the '%1' option for alarms based on this template."
msgstr ""
"Параметри '%1'-ро барои хотиррасоние, ки ба "
"ин қолиб асос гузоштааст, сабт кунед."

#: editdlg.cpp:271 recurrenceedit.cpp:276
msgid "Any time"
msgstr "Дар ягон вақт"

#: editdlg.cpp:289
msgid "Recurrence:"
msgstr "Такроршавӣ:"

#: editdlg.cpp:293
msgid ""
"How often the alarm recurs.\n"
"The alarm's recurrence is configured in the Recurrence tab."
msgstr ""
"Зичии такроршавии хотиррасонӣ.\n"
"Такророти хотиррасонӣ ба варақаи замимаи Такроршавӣ "
"танзим шуда истодааст."

#: editdlg.cpp:302
msgid "Schedule the alarm at the specified time."
msgstr "Хотиррасониро ба муддати ишорашуда муқаррар намудан."

#: editdlg.cpp:330
msgid "Enter the text of the alarm message. It may be multi-line."
msgstr ""
"Матни хотиррасониро ворид кунед. Метавон "
"якчанд сатрро ишора намуд."

#: editdlg.cpp:338
msgid "Enter the name or URL of a text or image file to display."
msgstr ""
"Номи файл ё истинодоти Интернетро ба "
"файли матнӣ ё тасовироти барои намоишро "
"низ ворид кунед."

#: editdlg.cpp:346
msgid "Choose a file"
msgstr "Файл интихоб кунед"

#: editdlg.cpp:347
msgid "Select a text or image file to display."
msgstr ""
"Интихоби файли матнӣ ё тасвирот барои "
"намоиш."

#: editdlg.cpp:371
msgid "Enter how long in advance of the main alarm to display a reminder alarm."
