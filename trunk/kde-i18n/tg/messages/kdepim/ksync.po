#: ksync.cpp:63
msgid "New &Window"
msgstr "&Тирезаи Нав"

#: ksync.cpp:78
msgid "Opens a new application window"
msgstr "Кушодани тирезаи барномаи нав"

#: ksync.cpp:79
msgid "Creates a new document"
msgstr "Ҳуҷҷати нав созед"

#: ksync.cpp:80
msgid "Opens an existing document"
msgstr "Кушодани ҳуҷҷати вуҷуд"

#: ksync.cpp:81
msgid "Opens a recently used file"
msgstr ""
"Кушодани файли истифода шуда дар вақти "
"охирин"

#: ksync.cpp:82
msgid "Saves the actual document"
msgstr "Нигоҳдоштани ҳуҷҷати қонунӣ"

#: ksync.cpp:83
msgid "Saves the actual document as..."
msgstr "Нигоҳдоштани ҳуҷҷати қонунӣ ҳамчунин..."

#: ksync.cpp:84
msgid "Closes the actual document"
msgstr "Пӯшидани ҳуҷҷати қонунӣ"

#: ksync.cpp:85
msgid "Prints out the actual document"
msgstr "Чоп кардани ҳуҷҷати қонунӣ"

#: ksync.cpp:86
msgid "Quits the application"
msgstr "Пӯшидани барнома"

#: ksync.cpp:87
msgid "Cuts the selected section and puts it to the clipboard"
msgstr ""
"Ин қисми матни интихобшуда бурида "
"мекунад ва ба хотири нусха мегузорад"

#: ksync.cpp:88
msgid "Copies the selected section to the clipboard"
msgstr ""
"Ин қисми интихобшуда ба хотири нусха "
"мегузорад"

#: ksync.cpp:89
msgid "Pastes the clipboard contents to actual position"
msgstr ""
"Таркиби хотири нусхаро дар ҷои лозимӣ "
"мегузорад"

