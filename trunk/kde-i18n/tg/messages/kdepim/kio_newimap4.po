#: imap4.cc:573
msgid "Message from %1 while processing '%2': %3"
msgstr "Хабар аз %1 дар вақти просесс '%2': %3"

#: imap4.cc:880
msgid "What do you want to store in this folder?"
msgstr " Шумо дар ин феҳрист чи нигоҳ доштан мехоҳед?"

#: imap4.cc:880
msgid "Create Folder"
msgstr "Сохтани Феҳрист"

#: imap4.cc:881
msgid "&Messages"
msgstr "&Хабарҳо"

#: imap4.cc:881
msgid "&Subfolders"
msgstr "&Зерипӯшаҳо"

#: imap4.cc:1174
msgid "Unsubscribe of folder %1 failed. The server returned: %2"
msgstr "Дигар кардани номи феҳристи %1 намешавад. Сервер %2 шуд"

#: imap4.cc:1194
msgid "Subscribe of folder %1 failed. The server returned: %2"
msgstr "Номгузори ба феҳристи %1 намешад. Сервер %2 шуд"

#: imap4.cc:1230 imap4.cc:1241
msgid "Changing the flags of message %1 failed."
msgstr "Дигаргун кардани байрақи хабар %1 намешавад."

#: imap4.cc:1275
msgid ""
"Setting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr "Кор кардан дар Воридоти Назорат дар феҳристи %1 ба истифодакунандаи %2 намешавад. Сервер %3 шуд"

#: imap4.cc:1293
msgid ""
"Deleting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr "Нест кардани Воридоти Назорат дар феҳристи %1 ба истифодакунандаи %2 намешавад. Сервер ба %3 шуд"

#: imap4.cc:1309 imap4.cc:1334
msgid ""
"Retrieving the Access Control List on folder %1 failed. The server returned: "
"%2"
msgstr ""
"Бозгаштан ба Access назорат феҳристи ҳуҷҷати %1 нашуд. Бозгашт ба сервер: "
"%2"

#: imap4.cc:1433
msgid "Unable to close mailbox."
msgstr "Қуттии почтаро пӯшида намешавад."

#: imap4.cc:1463
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "Аз феҳристи %1 хабар гирифта намешавад. Сервер ҷавоб дод: %2"

#: imap4.cc:1628
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"Сервери %1 бо IMAP4 ва IMAP4rev1 дастгири карда намешавад.\n"
"Инро худаш шинохт бо ёрии %2"

#: imap4.cc:1639
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"Сервер дастгирӣ барои TLS надорад.\n"
"Барои алоқа кардани вайрон, ҳолати пуштибонӣ ғайри фаъол созед."

#: imap4.cc:1664
msgid "Starting TLS failed."
msgstr "Оғози TLS кор карда натавонист."

#: imap4.cc:1674
msgid "The authentication method %1 is not supported by the server."
msgstr "Муаянкунии методи %1 бо сервер дастгири карда намешавад."

#: imap4.cc:1685
msgid "Username and password for your IMAP account:"
msgstr "Номи истифодакунанда ва гузарвожаи истифода мебурдаги барои IMAP:"

#: imap4.cc:1699
#, c-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server replied:\n"
"%1"
msgstr ""
"Ворид кушода намешавад. Мумкин, гузарвожа нодуруст аст.\n"
"Сервер гуфт:\n"
"%1"

#: imap4.cc:1705
msgid ""
"Unable to authenticate via %1.\n"
"The server replied:\n"
"%2"
msgstr ""
"Муайян кардан бо %1 намешавад.\n"
"Сервер \n шуд "
"%2"

#: imap4.cc:2177
msgid "Unable to open folder %1. The server replied: %2"
msgstr "Феҳристи %1-ро кушода намешавад. Сервер гуфт: %2"

