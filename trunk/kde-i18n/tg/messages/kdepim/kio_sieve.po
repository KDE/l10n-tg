#: sieve.cpp:273
msgid "Connecting to %1..."
msgstr "Пайвасткунӣ ба %1..."

#: sieve.cpp:276
msgid "The connection to the server was lost."
msgstr "Пайвастшави ба сервер имконият надорад."

#: sieve.cpp:288
msgid "Server identification failed."
msgstr "Дар воридшави ба сервер бозистодан."

#: sieve.cpp:315
msgid "Authenticating user..."
msgstr "Тафтиш кардани идентификатсия..."

#: sieve.cpp:318
msgid "Authentication failed."
msgstr "Хатогӣ дар аслшиносӣ."

#: sieve.cpp:379 sieve.cpp:584 sieve.cpp:657 sieve.cpp:690
msgid "Done."
msgstr "Тайер Шуд."

#: sieve.cpp:390
msgid "Activating script..."
msgstr "Фаъол кардани скрипт..."

#: sieve.cpp:406
msgid "There was an error activating the script."
msgstr "Хатогӣ дар фаъол кардани скрипт."

#: sieve.cpp:424
msgid "There was an error deactivating the script."
msgstr "Хатогӣ дар ғайри фаъол кардани скрипт."

#: sieve.cpp:451
msgid "Sending data..."
msgstr "Фиристодани маълумот..."

#: sieve.cpp:468
msgid "KIO data supply error."
msgstr "Маълумоти KIO хато фиристод."

#: sieve.cpp:495
msgid "Quota exceeded"
msgstr "Аз ҳад гузаштани квота"

#: sieve.cpp:528 sieve.cpp:634 sieve.cpp:964
msgid "Network error."
msgstr "Хатогии шабака."

#: sieve.cpp:539
msgid "Verifying upload completion..."
msgstr "Назорати пурборкуни..."

#: sieve.cpp:565
#, c-format
msgid ""
"The script did not upload successfully.\n"
"This is probably due to errors in the script.\n"
"The server responded:\n"
"%1"
msgstr ""
"Пурборкунии скрипти муйяссар намешавад.\n"
"Мумкин ин аз хатогии дар скрипти \n"
" ба амал омада бошад.Шабака бозгардонд:\n"
"%1"

#: sieve.cpp:573 sieve.cpp:577
msgid ""
"The script did not upload successfully.\n"
"The script may contain errors."
msgstr ""
"Муйяссар намешавад пурборкунии скрипти.\n"
"Мумкин ин аз хатогии дар скрипт ба амал "
"омада бошад."

#: sieve.cpp:611
msgid "Retrieving data..."
msgstr "Дарёфт кардани маълумот..."

#: sieve.cpp:645
msgid "Finishing up..."
msgstr "Хотимаи дарёфт..."

#: sieve.cpp:652
msgid "A protocol error occurred while trying to negotiate script downloading."
msgstr ""
"Дар вақти кӯшиши пурборкунии пртоколи "
"скрипт хатогӣ ба амал омад."

#: sieve.cpp:664
msgid "Folders are not supported."
msgstr "Каталогҳо мувофиқат намекунанд."

#: sieve.cpp:671
msgid "Deleting file..."
msgstr "Нест кардани файл..."

#: sieve.cpp:686
msgid "The server would not delete the file."
msgstr ""
"Муйяссар намешавад бартараф кардани файл "
"дар шабака."

#: sieve.cpp:705
msgid "Cannot chmod to anything but 0700 (active) or 0600 (inactive script)."
msgstr ""
"Муйяссар намешавад ҳуқуқи пайвастшави бо "
"скрипти: 0700 (фаъол) ё ки 0600 (ғайрифаъол)."

#: sieve.cpp:855
msgid "Sieve Authentication Details"
msgstr "Дуруст кардани муайян кардани Sieve"

#: sieve.cpp:856
msgid ""
"Please enter your authentication details for your sieve account (usually the "
"same as your email password):"
msgstr ""
"Марҳамад параметрҳои ҳисоботии хатиро  "
"барои Sieve (фақат лозим меояд ҳамон исми "
"дар пайвасшавии почтаи электрони "
"истифодашударо нишон дод):"

#: sieve.cpp:859
msgid "No authentication details supplied."
msgstr ""
"Дуруст кардани аудентификация нишон дода "
"нашудааст."

#: sieve.cpp:878
msgid "No compatible authentication methods found."
msgstr ""
"Нигоҳ доштани методҳои аудентификатсия "
"зоҳоир нашшудааст."

#: sieve.cpp:897 sieve.cpp:909
#, c-format
msgid ""
"A protocol error occurred during authentication.\n"
"Choose a different authentication method to %1."
msgstr ""
"Хатоги ба амал омад дар протокол дар  "
"вақти аудетификатсия.\n"
"Методи дигари аудентификатсияро интихоб "
"намоед барои %1."

#: sieve.cpp:935
#, c-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded:\n"
"%1"
msgstr ""
"Муйяссар намешавад ба даст овардани "
"воридшавӣ \n"
"Сабаби асосиаш ин нодуруст ворид кардани "
"исм.\n"
"Шабака бозгардонд:\n"
"%1"

#: sieve.cpp:1010
msgid "A protocol error occurred."
msgstr "Хатогии протокол."
