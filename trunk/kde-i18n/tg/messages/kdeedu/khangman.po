#: data.i18n:2
msgid ""
"_: NOTE_TO_THE_TRANSLATORS\n"
"The translators have the opportunity to translate the\n"
"words in the game.\n"
"See the file README.languages in khangman's source directory\n"
"for more information on how to do that.\n"
"(translate this message as \"DONE\" when you have translated\n"
"the words; otherwise leave it untranslated as a reminder)"
msgstr "\"DONE\" "

#: khangmanview.cpp:45
#, c-format
msgid "KHangMan %1"
msgstr "KЧӯбаиДор %1"

#: khangmanview.cpp:63
msgid ""
"The backgrounds files are not found.\n"
"Check your installation, please!"
msgstr ""
"Файлҳои зимина ёфт нашуд.\n"
"Санҷет агар ин бози бо муваффақият "
"барқарор карда шуд!"

#: khangmanview.cpp:140
msgid "Congratulations! You won! Do you want to play again?"
msgstr ""
"Муваффақият! Шумо бурдед! Шумо мехоҳед аз "
"нав бозӣ кунед?"

#: khangmanview.cpp:176
msgid "You are dead. Do you want to play again?"
msgstr ""
"Шумо бой додед. Шумо мехоҳед аз нав бозӣ "
"кунед?"

#: khangmanview.cpp:184
msgid "The letter has already been guessed."
msgstr "Ин ҳарф аллакай пай бурдан буд."

#: khangmanview.cpp:245
msgid ""
"File $KDEDIR/share/apps/khangman/data/%1/%2 not found!\n"
"Check your installation, please!"
msgstr ""
"Файли $KDEDIR/share/apps/khangman/data/%1/%2 ёфт нашуд!\n"
"Санҷет агар ин бози бо муваффақият "
"барқарор карда шуд!"

