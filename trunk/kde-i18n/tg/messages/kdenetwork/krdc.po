#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Абророва Хиромон"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "H_Abrorova@rambler.ru"

#: keycapturedialog.cpp:50
msgid "Enter Key Combination"
msgstr "Ворид намудани Ҷамънамоии Калидҳо"

#: krdc.cpp:132 krdc.cpp:155
msgid "The entered host does not have the required form."
msgstr ""
"Номи соҳиби воридшуда шакли дархостаро "
"надорад."

#: krdc.cpp:133 krdc.cpp:156
msgid "Malformed URL or Host"
msgstr "URL ё Соҳиби Нодуруст"

#: krdc.cpp:162
msgid "%1 - Remote Desktop Connection"
msgstr "%1 - Пайвастшавии Мизи Кории Дурдаст"

#: krdc.cpp:189
msgid ""
"Here you can see the remote desktop. If the other side allows you to control "
"it, you can also move the mouse, click or enter keystrokes. If the content "
"does not fit your screen, click on the toolbar's full screen button or scale "
"button. To end the connection, just close the window."
msgstr ""
"Дар ин ҷо шумо мизи кории дурдастро дида "
"метавонед.Агар тарафи дигар ба шумо идора "
"намудани онро иҷозат диҳад, шумо инчунин "
"дар он бо муш ва забонак кор карда "
"метавонед. Агар андозаи мизи кории "
"дурдаст ба аз они шумо мувофиқат накунад "
"ба тугмаи экрани пурра дар панели асбобҳо "
"ангушт занед. Барои ба охиррасонии "
"пайвастшавӣ танҳо тирезаро пӯшед."

#: krdc.cpp:222
msgid "Establishing connection..."
msgstr "Барпосозии пайвастшавӣ..."

#: krdc.cpp:228
msgid "Authenticating..."
msgstr "Аслшиносӣ..."

#: krdc.cpp:233
msgid "Preparing desktop..."
msgstr "Тайёр намудани мизи корӣ..."

#: krdc.cpp:370
msgid "View Only"
msgstr "Танҳо Азназаргузаронӣ"

#: krdc.cpp:374
msgid "Always Show Local Cursor"
msgstr "Ҳамеша Нишоннамои Маҳаллиро Нишон Додан"

#: krdc.cpp:459
msgid "Autohide on/off"
msgstr "Фаъол/хомӯш кардани худпинҳоншавӣ"

#: krdc.cpp:466 krdc.cpp:562 krdc.cpp:564
msgid "Fullscreen"
msgstr "Экрани пурра"

#: krdc.cpp:472 krdc.cpp:474 krdc.cpp:589
msgid "Advanced options"
msgstr "Хосиятҳои мукаммалгашта"

#: krdc.cpp:487 krdc.cpp:573
msgid "Scale view"
msgstr "Андоза"

#: krdc.cpp:495
msgid "Minimize"
msgstr "Печонидан"

#: krdc.cpp:565
msgid ""
"Switches to full screen. If the remote desktop has a different screen "
"resolution, Remote Desktop Connection will automatically switch to the "
"nearest resolution."
msgstr ""
"Гузариш ба экрани пурра. Агар мизи кории "
"дурдаст ҳосилнокии гуногун дошта бошад, "
"Пайвастшавии Мизи Кории Дурдаст ба таври "
"худкор ба ҳосилнокии наздиктарин "
"мегузарад."

#: krdc.cpp:571
msgid "Scale"
msgstr "Ҷадвал"

#: krdc.cpp:574
msgid "This option scales the remote screen to fit your window size."
msgstr ""
"Тағири андозаи тирезаи мизи кории "
"дурдаст барои мувофиқати он ба андозаи "
"тирезаи шумо."

#: krdc.cpp:580
msgid "Special Keys"
msgstr "Калиҳои Махсус"

#: krdc.cpp:582
msgid "Enter special keys."
msgstr "Калиҳои махсусро ворид кунед."

#: krdc.cpp:583
msgid ""
"This option allows you to send special key combinations like Ctrl-Alt-Del to "
"the remote host."
msgstr ""
"Ин хосият ба шумо имконияти фиристодани "
"ҷамънамоии калиҳои махсусро ба соҳиби "
"дурдаст медиҳад, ба монанди Ctrl-Alt-Del."

#: krdc.cpp:587
msgid "Advanced"
msgstr "Пешрафта"

#: main.cpp:35
msgid "Remote desktop connection"
msgstr "Пайвастшавии дурдаст ба мизи корӣ"

#: main.cpp:41
msgid "Start in fullscreen mode"
msgstr "Дар усули экрани пурра оғоз кунед"

#: main.cpp:43
msgid "Start in regular window"
msgstr "Дар тирезаи муқаррарӣ оғоз кунед"

#: main.cpp:45
msgid "Low quality mode (Tight Encoding, 8 bit color)"
msgstr ""
"Усули сифати паст (Рамзгузории фишурда, "
"ранги 8 бита)"

#: main.cpp:47
msgid "Medium quality mode (Tight Encoding, lossy)"
msgstr ""
"Усули сифати миёна (Рамзгузории фишурда, "
"бо талафотҳо)"

#: main.cpp:49
msgid "High quality mode, default (Hextile Encoding)"
msgstr ""
"Усули сифати баланд, бо нобаёнӣ "
"(Рамзгузории заиф)"

#: main.cpp:51
msgid "Start VNC in scaled mode"
msgstr "Оғоз дар усули VNC миқёскунӣ"

#: main.cpp:53
msgid "Show local cursor (VNC only)"
msgstr ""
"Нишоннамои маҳаллиро нишон диҳед (танҳо "
"VNC)"

#: main.cpp:55
msgid "Override VNC encoding list (e.g. 'hextile raw')"
msgstr ""
"Ба назар нпгирифтани рӯйхати рамзгузории "
"VNC (масалан 'hextile raw')"

#: main.cpp:57
msgid "Provide the password in a file"
msgstr "Таъмини гузарвожа дар файл"

#: main.cpp:58
msgid "The name of the host, e.g. 'localhost:1'"
msgstr "Номи соҳиб,масалан 'localhost:1'"

#: main.cpp:65 maindialog.cpp:29
msgid "Remote Desktop Connection"
msgstr "Пайвастшавии Мизи Кории Дурдаст"

#: main.cpp:76
msgid "RDP backend"
msgstr "Барномаи пастсатҳи RDP"

#: main.cpp:78
msgid "Original VNC viewer and protocol design"
msgstr ""
"Азназаргузарони VNC ва тарроҳӣ аз рӯи "
"қарордод"

#: main.cpp:80
msgid "TightVNC encoding"
msgstr "Рамзгузории TightVNC"

#: main.cpp:82
msgid "ZLib encoding"
msgstr "Рамзгузории ZLib"

#: main.cpp:126
msgid "The password file '%1' does not exist."
msgstr "Файли '%1' гузорвожаҳо мавҷуд нест."

#: main.cpp:140
msgid "Wrong geometry format, must be widthXheight"
msgstr ""
"Шаклбандии нодуруст, бояд барXбаландӣ "
"бошад"

#: maindialog.cpp:36
msgid "Connect"
msgstr "Пайвастшавӣ"

#: maindialogwidget.cpp:44
msgid "unknown"
msgstr "номаълум"

#: maindialogwidget.cpp:51
msgid "Shared Desktop"
msgstr "Мизи Кории Муштаракгашта"

#: maindialogwidget.cpp:54
msgid "Standalone Desktop"
msgstr "Компютери Алоҳида"

#: maindialogwidget.cpp:191 maindialogwidget.cpp:314
msgid "default"
msgstr "бо нобаёнӣ"

#: maindialogwidget.cpp:239
msgid ""
"Browsing the network is not possible. You probably did not install SLP "
"support correctly."
msgstr ""
"Баррасии шабака имконнопазир аст. "
"Эҳтимолан шумо SLP пуштибониро нодуруст "
"коргузорӣ намудаед."

#: maindialogwidget.cpp:241
msgid "Browsing Not Possible"
msgstr "Баррасӣ Имконнопазир Аст"

#: maindialogwidget.cpp:258
msgid "An error occurred while scanning the network."
msgstr ""
"Ҳангоми сканеркунии шабака хатогӣ рух "
"дод."

#: maindialogwidget.cpp:259
msgid "Error While Scanning"
msgstr "Хатогӣ Ҳангоми Сканеркунӣ"

#: preferencesdialog.cpp:32
msgid "Preferences"
msgstr "Имтиёзҳо"

#: preferencesdialog.cpp:38
msgid "&Host Profiles"
msgstr "Тахассусҳои &Соҳиб"

#: preferencesdialog.cpp:41
msgid "&VNC Defaults"
msgstr "&VNC Бо Нобаёнӣ"

#: preferencesdialog.cpp:46 preferencesdialog.cpp:54
msgid "Do not &show the preferences dialog on new connections"
msgstr ""
"Муколамаи имтиёзҳоро дар пайвастшавии "
"нав &нишон надиҳед"

#: preferencesdialog.cpp:49
msgid "RD&P Defaults"
msgstr "RD&P Бо Нобаёниҳо"

#: rc.cpp:2 rc.cpp:60
#, no-c-format
msgid "Host"
msgstr "Соҳиб"

#: rc.cpp:4 rc.cpp:52 rc.cpp:62 rc.cpp:110
#, no-c-format
msgid "Type"
msgstr "Навъ"

#: rc.cpp:6 rc.cpp:64
#, no-c-format
msgid "Settings"
msgstr "Гузоришҳо"

#: rc.cpp:8 rc.cpp:66
#, no-c-format
msgid ""
"This list shows all hosts that you have visited and a summary of your "
"settings for them. If you want to reset the setting for a host, you can "
"delete it using the buttons below. When you connect again you can then "
"re-configure them."
msgstr ""
"Ин рӯйхат ҳамаи соҳибҳоеб ки ташриф "
"овардаед ва гузоришҳои асосии "
"пайвастшавӣ ба онҳоро нишон медиҳад. Агар "
"шумо гузоришро барои соҳиб партофтан "
"хоҳед, шумо онро ба воситаи тугмаи дар "
"поён буда хориҷ карда метавонед. Вақте, ки "
"шумо дафъаи оянда пайваст мешавед, шумо "
"онҳоро аз нав танзим карда метавонед."

#: rc.cpp:10 rc.cpp:68
#, no-c-format
msgid "&Remove Selected Host"
msgstr "&Хориҷкунии Соҳиби Интихобшуда"

#: rc.cpp:12 rc.cpp:70
#, no-c-format
msgid "Deletes the hosts that you have selected in the list above."
msgstr ""
"Соҳибҳоеро, аз рӯйхати дар боло буда "
"интихоб кардаед, нобуд месозад."

#: rc.cpp:14 rc.cpp:72
#, no-c-format
msgid "Remove &All Hosts"
msgstr "Хориҷкунии &Ҳамаи Соҳибҳо"

#: rc.cpp:16 rc.cpp:74
#, no-c-format
msgid "Removes all hosts from the list."
msgstr "Хориҷкунии ҳамаи соҳибҳо аз рӯйхат."

#: rc.cpp:18 rc.cpp:76
#, no-c-format
msgid "Enter a special key or key combination to send to the remote side:"
msgstr ""
"Калиди махсус ё ҷамъи калидҳоро барои "
"фиристодан ба соҳиби дурдаст ворид кунед:"

#: rc.cpp:21 rc.cpp:79
#, no-c-format
msgid ""
"This function allows you to send a key combination like Ctrl+Alt+Del to the "
"remote side. Press Esc to cancel."
msgstr ""
"Ин функсия имконияти фиристодани ҷамъи "
"калидҳои ба монанди Ctrl+Alt+Del ба тарафи "
"дурдаст медиҳад. Барои рад кардан Esc-ро "
"пахш кунед."

#: rc.cpp:23 rc.cpp:81
#, no-c-format
msgid "Remote &desktop:"
msgstr "&Мизи кории дурдаст:"

#: rc.cpp:25 rc.cpp:83
#, no-c-format
msgid "Enter the hostname and display number"
msgstr ""
"Номи соҳиб ва рақами нишоннаморо ворид "
"кунед"

#: rc.cpp:27 rc.cpp:85
#, no-c-format
msgid ""
"Enter the name and display number of the computer that you want to connect "
"to, separated by a colon, e.g. 'mycomputer:1'. The address can be any valid "
"Internet address. The display numbers usually start at 0. If you do not have "
"a display number, try 0 or 1.\n"
"Remote Desktop Connection only supports systems that use VNC."
msgstr ""
"Ном ва рақами намоишгари компютереро, ки "
"ба он дар намуди 'mycomputer:1' пайваст шудан "
"мехоҳед, ворид кунед. Суроға ҳама намуди "
"суроғаҳои мувофиқи Интернет шуда "
"метавонад. Рақамҳои намоишгар одатан ба 0 "
"оғоз меёбанд. Ягар рақами намоишгарро "
"надошта бошед, 0 ё 1-ро таъин кунед.\n"
"Пайвастшавии Мизи Кории Дурдаст танҳо "
"системаҳоеро, ки VNC-ро истифода мебаранд, "
"пуштибонӣ мекунад."

#: rc.cpp:30 rc.cpp:88
#, no-c-format
msgid "&Browse <<"
msgstr "&Баррасӣ <<"

#: rc.cpp:32 rc.cpp:90
#, no-c-format
msgid "Turn on/off the network browsing panel."
msgstr ""
"Панели баррасии шабакаро фаъол/хомӯш "
"кунед."

#: rc.cpp:34 rc.cpp:92
#, no-c-format
msgid ""
"Enter the address of the computer to connect to, or browse the network and "
"select one. VNC and RDP compatible servers will be supported. <a "
"href=\"whatsthis:"
"<h3>Examples</h3>for a computer called "
"'megan':"
"<p>"
"<table>"
"<tr>"
"<td>megan:1</td>"
"<td>connect to the VNC server on 'megan' with display number "
"1</td></tr>"
"<tr>"
"<td>vnc:/megan:1</td>"
"<td>longer form for the same "
"thing</td></tr>"
"<tr>"
"<td>rdp:/megan</td>"
"<td>connect to the RDP server on 'megan'</td></tr></table>\">Examples</a>"
msgstr ""
"Суроғаи компютерреро, ки ба он пайваст "
"шудан мехоҳед, ворид кунед ё шабакаро "
"баррасӣ карда якеро интихоб кунед. "
"Хидматрасонҳое, ки бо VNC ва RDP мувофиқанд, "
"пуштибонӣ мегарданд. <a "
"href=\"whatsthis:"
"<h3>Мисолҳо</h3>барои компютере, ки 'megan' "
"номида мешавад:"
"<p>"
"<table>"
"<tr>"
"<td>megan:1</td>"
"<td>ба хидматрасони VNC дар 'megan' бо рақами "
"намоишгари 1</td></tr>"
"<tr>"
"<td>vnc:/megan:1</td>"
"<td>намуди калонтари ҳамон "
"як</td></tr>"
"<tr>"
"<td>rdp:/megan</td>"
"<td>ба хидматрасони RDP дар 'megan' пайваст "
"шудан</td></tr></table>\">Мисолҳо</a>"

#: rc.cpp:36 rc.cpp:94
#, no-c-format
msgid "&Rescan"
msgstr "&Аз нав дида баромадан"

#: rc.cpp:38 rc.cpp:96
#, no-c-format
msgid ""
"Rescans the network. Depending on the network configuration this may take a "
"few seconds until all systems have responded."
msgstr ""
"Бозсканеркунии шабака. Вобаста ба "
"танзимоти шабака ин якчанд сонияро дар "
"бар мегирад."

#: rc.cpp:40 rc.cpp:98
#, no-c-format
msgid "&Search:"
msgstr "&Ҷустуҷӯ:"

#: rc.cpp:42 rc.cpp:100
#, no-c-format
msgid "Enter a search term"
msgstr "Мавзӯъи ҷустуҷӯиро ворид кунед"

#: rc.cpp:44 rc.cpp:102
#, no-c-format
msgid ""
"Enter a search term here if you want to search for a specific system, then "
"press Enter or click Rescan. All systems, whose description matches the "
"search term, will be displayed. The search is not case sensitive. If you "
"leave the field empty all systems will be displayed."
msgstr ""
"Номи компютерро дар ин ҷо ворид карда "
"Enter-ро пахш кунед. Ҳамаи нуқтаҳои корие, ки "
"таъиноти онҳо ба дархост ҷавобӯ аст, дар "
"рӯйхат нишон дода мешаванд. Ҷустуҷӯ бе "
"ҳисобгирии сабтгоҳ иҷро мешавад. Агар ин "
"майдонро холӣ гузоред, ҳамаи системаҳо "
"нишон дода мешаванд."

#: rc.cpp:46 rc.cpp:104
#, no-c-format
msgid "Scop&e:"
msgstr "&Маҳал:"

#: rc.cpp:48 rc.cpp:106
#, no-c-format
msgid ""
"An administrator can configure the network to have several scopes. If this "
"is the case, you can select the scope to scan here."
msgstr ""
"Идоракунанди метавонад шабакаро дар "
"якчанд соҳаҳо танзим намояд. Агар ҳамин "
"тавр бошад, шумо метавонед соҳаро барои "
"сканеркунӣ интихоб намоед."

#: rc.cpp:50 rc.cpp:108
#, no-c-format
msgid "Name"
msgstr "Ном"

#: rc.cpp:54 rc.cpp:112
#, no-c-format
msgid "Address"
msgstr "Суроға"

#: rc.cpp:56 rc.cpp:114
#, no-c-format
msgid "Protocol"
msgstr "Қарордод"

#: rc.cpp:58 rc.cpp:116
#, no-c-format
msgid ""
"Here you can see the systems on the network that allow you to connect. Note "
"that an administrator can hide systems, so the list is not always complete. "
"Click on an item to select it, double-click it to connect immediately."
msgstr ""
"Дар ин ҷо шумо системаҳоро дар шабака, ки "
"ба пайвастшавӣ иҷозат дода мешавандб "
"дида метавонед. Дар хотир доред, ки "
"идоракунанда метавонад системаҳоро "
"пинҳон намояд ба тавре, ки рӯйхат нопурра "
"мегардад. Барои интихоби он ба пункт "
"ангушт занед ва барои пайвастшавии фаврӣ "
"ба он дубора ангушт занед."

#: rc.cpp:118 rc.cpp:196
#, no-c-format
msgid "Connection"
msgstr "Пайвастшавӣ"

#: rc.cpp:120
#, no-c-format
msgid "Desktop &resolution:"
msgstr "&Ҳалнокии мизи корӣ:"

#: rc.cpp:122
#, no-c-format
msgid "&Keyboard layout:"
msgstr "Ҷобаҷогузории &забонак:"

#: rc.cpp:124
#, no-c-format
msgid "Small (640x480)"
msgstr "Хурд (640x480)"

#: rc.cpp:126
#, no-c-format
msgid "Medium (800x600)"
msgstr "Миёна (800x600)"

#: rc.cpp:128
#, no-c-format
msgid "Big (1024x768)"
msgstr "Калон (1024x768)"

#: rc.cpp:130
#, no-c-format
msgid "Custom (...)"
msgstr "Дигар (...)"

#: rc.cpp:132
#, no-c-format
msgid ""
"Here you can specify the resolution of the remote desktop. This resolution "
"determines the size of the desktop that will be presented to you."
msgstr ""
"Дар ин ҷо шумо метавонед ҳалнокии мизи "
"кории дурдастро таъин намоед. Он андозаи "
"мизи кориеро, ки ба шумо муаррифӣ "
"мегардад, муайя месозад."

#: rc.cpp:134
#, no-c-format
msgid "&Width:"
msgstr "&Бар:"

#: rc.cpp:136
#, no-c-format
msgid ""
"This is the width of the remote desktop. You can only change this value "
"manually if you select Custom as desktop resolution above."
msgstr ""
"Ин бари мизи кории дурдаст аст. Шумо "
"қиммати онро танҳо ба таври дастӣ ба "
"воситаи интихоби Дигар ҳамчун ҳалнокии "
"мизи корӣ иваз карда метавонед."

#: rc.cpp:138
#, no-c-format
msgid "H&eight:"
msgstr "&Баландӣ:"

#: rc.cpp:140
#, no-c-format
msgid ""
"This is the height of the remote desktop. You can only change this value "
"manually if you select Custom as desktop resolution above."
msgstr ""
"Ин баландии мизи кории дурдаст аст. Шумо "
"қиммати онро танҳо ба таври дастӣ ба "
"воситаи интихоби Дигар ҳамчун ҳалнокии "
"мизи корӣ иваз карда метавонед."

#: rc.cpp:142
#, no-c-format
msgid "Arabic (ar)"
msgstr "Арабӣ (ar)"

#: rc.cpp:144
#, no-c-format
msgid "Danish (da)"
msgstr "Даниявӣ (da)"

#: rc.cpp:146
#, no-c-format
msgid "German (de)"
msgstr "Олмонӣ (de)"

#: rc.cpp:148
#, no-c-format
msgid "British English (en-gb)"
msgstr "Англисӣ (en-gb)"

#: rc.cpp:150
#, no-c-format
msgid "US English (en-us)"
msgstr "Англисӣ Америкоӣ (en-us)"

#: rc.cpp:152
#, no-c-format
msgid "Spanish (es)"
msgstr "Испаниёвӣ (es)"

#: rc.cpp:154
#, no-c-format
msgid "Finnish (fi)"
msgstr "Финӣ (fi)"

#: rc.cpp:156
#, no-c-format
msgid "French (fr)"
msgstr "Фаронсавӣ (fr)"

#: rc.cpp:158
#, no-c-format
msgid "Belgium (fr-be)"
msgstr "Белгӣ (fr-be)"

#: rc.cpp:160
#, no-c-format
msgid "Croation (hr)"
msgstr "Хорватӣ (hr)"

