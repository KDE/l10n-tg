msgstr ""
"ИСТИФОДАБАРӢ: /voice <тахаллус1> "
"[<тахаллус2> <...>] - пешкаши статуси гуфтугӯкунанда дар маҷро (статуси амалгар лозим аст). "

#: protocols/irc/ircprotocol.cpp:230
msgid ""
"USAGE: /devoice <nickname> [<nickname 2> <...>"
