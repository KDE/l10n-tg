msgstr ""
"ИСТИФОДАБАРӢ: /devoice <тахаллус1> "
"[<тахаллус2> <...>] - бекоркунии статуси гуфтугӯкунанда дар маҷро (статуси амалгар лозим аст)."

#: protocols/irc/ircprotocol.cpp:234
msgid "USAGE: /quit [<reason>] - Disconnect from IRC, optionally leaving a message."
msgstr ""
"ИСТИФОДАБАРӢ: /quit [<сабаб>] - "
