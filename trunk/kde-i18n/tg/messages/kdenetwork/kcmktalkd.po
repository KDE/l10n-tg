msgstr "URL-и нопуштибонӣ"

#: soundpage.cpp:195
msgid ""
"%1\n"
"does not appear to be a WAV file."
msgstr ""
"%1\n"
"ҳамчун файли WAV нест."

#: soundpage.cpp:198
msgid "Improper File Extension"
msgstr "Вусъати Нодурусти Файл"

#: soundpage.cpp:206
