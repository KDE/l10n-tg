#: rc.cpp:902
#, no-c-format
msgid ""
"<b>Save Inline</b>"
"<p>Saves the pixmaps as binary data in the .ui files. Pixmaps saved like "
"this are not shared between forms. We recommend using Project image files "
"instead."
msgstr ""
"<b>Дар хат нигоҳ доштан</b>"
"<p>Харитаи pix-ро ҳамчун таърихи ҳисоби дуӣ "
"дар файлҳои ui нигоҳ доред.Харитаи pix ва "
"варақаҳо байнашон тақсим карда "
"намешавад. Мо тавсия менамоем ки нақшаи "
"файлҳои тасвирро ба ҷои ин истифода баред."

