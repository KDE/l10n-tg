#: widget/specials.cpp:32
msgid "Enables or disables widget."
msgstr "Метавон ё ин ки нотавон сохтани виджет."

#: widget/specials.cpp:35
msgid "Shows/hides widget."
msgstr "Намоиши/пинҳони васеъкунӣ."

#: widget/specials.cpp:37
msgid "Sets widget's content."
msgstr "Мондани ҷузъи қаноаткунанда."

#: widget/specials.cpp:39
msgid "Returns content of widget."
msgstr "Баргардондани контенти ҷузъ."

#: widget/specials.cpp:41 widget/specials.cpp:95
msgid "Returns selected text or text of current item."
msgstr ""
"Матни интихоб карда шударо ва фақраи "
"мавҷуд бударо боз монед."

#: widget/specials.cpp:43
msgid "Selects given text or select item containing given text."
msgstr ""
"Матни додашударо ва ҳам фақраи матни "
"додашударо интихоб намоед."

#: widget/specials.cpp:46
msgid "Returns index of current item."
msgstr ""
"Баргашт кардани ягон индекси дар "
"муомилот буда."

#: widget/specials.cpp:48
msgid "Selects the item at the specified index. Indexes are zero based."
msgstr ""
"Фақраи дар индекс таъин карда шударо "
"интихоб намоед. Индексҳо ин асоси нул аст."

#: widget/specials.cpp:51
msgid ""
"Sets pixmap at the given index to the specified icon. Use <i>index = -1</i> "
"to set the pixmap for all items."
msgstr ""
"Харитае pix-е ки дар индекси нақши таъин "
"карда шуда монед.Индекси <i> ,барои "
"гузориши харитаи pix-ро барои ҳамаи фақра = "
"-1</i> истифода баред."

#: widget/specials.cpp:53
msgid "Returns the text of the item at the given index."
msgstr ""
"Матнро дар индекси додашудаи фақра боз "
"гардонед."

#: widget/specials.cpp:55
msgid "Returns the slash-separated path to the given item in the tree."
msgstr ""
"Андозаи ҷудои роҳчаро барои нуқтаи муаян "
"боз мегардонад."

#: widget/specials.cpp:57
msgid "Returns the depth of the current item in the tree. Root items have depth 0."
msgstr ""
"Чуқурии нуқта мавҷуд будаи дар дарахтро "
"боз мегардонад. Нуқтаи реша чуқурии 0-ро "
"дорад."

#: widget/specials.cpp:59
msgid "Removes the item with the given index."
msgstr ""
"Фақраро дар индекси додашуда ҳаракат "
"диҳед."

#: widget/specials.cpp:62
msgid "Inserts item at <i>index</i> position."
msgstr "Ҷузъро дар<i>индекси</i> ҷойи ист гузоред."

#: widget/specials.cpp:65
msgid "Inserts multiple items (EOL-separated) at <i>index</i> position."
msgstr "Ҷузъро дар<i>индекси</i> ҷойи ист гузоред."

#: widget/specials.cpp:68
msgid "Inserts the item if it will not create a duplicate."
msgstr ""
"Мондани мундариҷа агар нусҳаи дегари "
"борхатро насазад."

#: widget/specials.cpp:70
msgid "Returns the index of an item with the given text."
msgstr ""
"Ба ҷои нишонаи гирифта додани мундариҷаи "
"матн бар мегардад."

#: widget/specials.cpp:72
msgid "Removes all content from the widget."
msgstr ""
"Нест кардани ҳамаи дар бар гирифтаҳо аз "
"васеъкуни."

#: widget/specials.cpp:75
msgid "Sets/unsets checkbox."
msgstr "Гузошташудаҳо/нагузашташудаҳо checkbox."

#: widget/specials.cpp:77
msgid ""
"Sets scripts associated with widget. This is an advanced feature that would "
"not be commonly used."
msgstr ""
"Нусҳаҳоро ҳамроҳ восеъ мекнад.Ин  шакл на "
"онқадар истифода бурда мешавад."

#: widget/specials.cpp:79
msgid ""
"Returns scripts associated with widget. This is an advanced feature that "
"would not be commonly used."
msgstr ""
"Баргардонидани нусҳаҳо бо widget пайваст "
"аст. Ин алакай истифодашудаги ва зиёд "
"истифода намешавад."

#: widget/specials.cpp:81
msgid "Returns type(class) of widget."
msgstr "Намуди (синфи) васеъкуниро боз гардонед."

#: widget/specials.cpp:83
msgid ""
"Returns the list of child widgets contained in the parent widget. Set the "
"<i>recursive</i> parameter to <i>true</i> to include widgets contained by "
"child widgets."
msgstr ""
"Нусҳаи восеъи куҳнааш ба аввалинаш ҳам "
"бар мегардад. Гузоштани <i>такрории</i> "
"параметр ба <i> дуруст </i> дар даромади "
"восеъшавии аввалинаш пайваст мебошад."

#: widget/specials.cpp:85
msgid "Returns value of a global variable."
msgstr ""
"Бар гардондани нархи ивазшавандаи "
"глобалӣ."

#: widget/specials.cpp:87 widget/specials.cpp:130
msgid ""
"Sets the value of a global variable. Global variables exist for the life of "
"the Kommander window."
msgstr ""
"Нархи гузошташудаи ивазшавандаи "
"глобалӣ.Ивазшавандаи глобалӣ барои "
"зиндагии тирезаи Kommander вуҷуд дорад."

#: widget/specials.cpp:93
msgid "Returns current widget's content."
msgstr ""
"Бар гардондани баргардандаи "
"васеъкунандаи ҷоришаванда."

#: widget/specials.cpp:97
msgid ""
"Does nothing. This is useful if you request the @widgetText value from "
"another widget for a CheckBox that returns nothing in its unchecked state. "
"The @null prevents an error indicating it is empty."
msgstr ""
"Ҳеҷчиз.Ин фоиданок аст,агар шумо нархи "
"@widgetText-ро  аз дигар васеъкунанда талаб "
"кунед ба CheckBox ҳамоне,ки бе ҳеҷ чиз бар "
"гашт дар ин ҷои тафтиш накарда буд. @null "
"огоҳ кард,ки ба хатоги роҳ дода шуд,ин "
"холи аст."

#: widget/specials.cpp:99
msgid "Returns the pid (process ID) of the current process."
msgstr ""
"pid (просессID)-ро бар гардонед аз просесси "
"ҷоришаванда."

#: widget/specials.cpp:101
msgid ""
"Returns DCOP identifier of current process. This is shorthand for "
"<i>kmdr-executor-@pid></i>."
msgstr ""
"Бар гардондани DCOP гузоштани просесси "
"ҷоришаванда.Ин стенография барои "
"<i>kmdr-иҷрокунанда-@pid></i>."

#: widget/specials.cpp:104
msgid "Returns the pid of the parent Kommander window."
msgstr "Бар гардондани pid аз волиди тирезаи Kommander."

#: widget/specials.cpp:106
msgid ""
"Executes a script block. Bash is used if no shell is given. It is primarily "
"for use in non-button widgets where script actions are not expected. "
"<p><i>If this is used inside a button it allows alternate script languages "
"to be used and will return a value to the main script, which may be "
"unexpected.</i>"
msgstr ""
"Нусҳаи муҳрро иҷро мекунад.Bash истифода "
"мешавад агар ки ягон ҷилд дода нашавад. Ин "
"танҳо барои истифодабурдани бекнопкаги "
"васеъшуда ва ба ҳисоб гирифта "
"намешавад."
"<p><i> Агар ин дар даруни кнопка истифода "
"шавад ин метавонад ки ба навбати нусҳаи "
"забонҳо истифода шаванд ва маънояш ба "
"нусҳаи аввалинаш бар мегардад, кадоме ки "
"ногаҳон мебошад.</i>"

#: widget/specials.cpp:108
msgid ""
"Returns value of an environment (shell) variable. Do not use <i>$</i>"
" in the name. For example, <i>@env(PATH)</i>."
msgstr ""
"Бар гардондани нарх аз "
"муҳит(метавонад)ивазшаванда.Инро "
"истифода набаред <i>$</i> дар ном.Мисол, "
"<i>@env(PATH)</i>."

#: widget/specials.cpp:110
