#: kmagzoomview.cpp:116
msgid ""
"This is the main window which shows the contents of the selected region. The "
"contents will be magnified if zoom level is set."
msgstr ""
"Ин тирезаи асосӣ, ки қисми экрани интихобшуда намоиш мекунад.Агар дар ҳолати "
"калонкунӣ қарор диҳем, он гоҳ намоиш калон мешавад."

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr ""
"Линукси Тоҷикӣ, Роҷер Ковакс, Виктор Ибрагимов, Марина Колючева, Мирзоев "
"Муҳаммад солеҳ"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "youth_opportunities@tajik.net, martel2004@mail.ru, solehjon@yahoo.com"

#: main.cpp:37
msgid "File to open"
msgstr "Файл барои кушодан"

#: main.cpp:45
msgid "KMagnifier"
msgstr "Пурбини Экрани KDE"

#: main.cpp:46
msgid "Screen magnifier for the K Desktop Environment (KDE)"
msgstr "Пурбини Экран барои гирдуатрофи KDE"

#: main.cpp:53
msgid "Rewrite and current maintainer"
msgstr "Таъсисдиҳандаи равон"

#: main.cpp:56
msgid "Original idea and author (KDE1)"
msgstr "Муаллифи фикр ва таъсисдиҳанда (KDE1)"

#: main.cpp:58
msgid "Various patches"
msgstr "Қуроқҳои гуногун"

#: main.cpp:59
msgid "Some tips"
msgstr "Як чанд  маслиҳатҳо"

#: rc.cpp:5
msgid "Other &Settings"
msgstr "Танзимотҳои &дигар"

#: kmag.cpp:87
msgid "&Very Low"
msgstr "&Хеле оҳиста"

#: kmag.cpp:87
msgid "&Low"
msgstr "&Оҳиста"

#: kmag.cpp:87
msgid "&Medium"
msgstr "&Миёна"

#: kmag.cpp:87
msgid "&High"
msgstr "&Баланд"

#: kmag.cpp:87
msgid "V&ery High"
msgstr "&Хеле баланд"

#: kmag.cpp:122
msgid "New &Window"
msgstr "&Тирезаи Нав"

#: kmag.cpp:124
msgid "Open a new KMagnifier window"
msgstr "Кушодани Пурбини Экрани KDE-и нав"

#: kmag.cpp:126
msgid "&Stop"
msgstr "Ис&т"

#: kmag.cpp:128
msgid "Click to stop window refresh"
msgstr "Барои ист кардани бозсозии тиреза зер кунед"

#: kmag.cpp:129
msgid ""
"Clicking on this icon will <b>start</b> / <b>stop</b>  updating of the "
"display. Stopping the update will zero the processing power  required (CPU "
"usage)"
msgstr ""
"Бо зер кунии ин нишона шумо метавонед бозсозии экран <b>фаъол</b> ё <b>ғайри "
"фаъол</b>  созед. Дар вақти ғайри фаъоли бозсозии экран барнома манбаъи "
"маркази протсессорро талаб намекунад (CPU)"

#: kmag.cpp:133
msgid "&Save Snapshot As..."
msgstr "&Нигоҳ доштани расм ҳамчун..."

#: kmag.cpp:135
msgid "Saves the zoomed view to an image file."
msgstr "Сохранить увеличенное изображение в файл."

#: kmag.cpp:136
msgid "Save image to a file"
msgstr "Нигоҳ доштани расм дар файл"

#: kmag.cpp:139
msgid "Click on this button to print the current zoomed view."
msgstr "Чоп кардани расми калоншудаи равон."

#: kmag.cpp:142 kmag.cpp:143
msgid "Quits the application"
msgstr "Пӯшидани барнома"

#: kmag.cpp:146
msgid ""
"Click on this button to copy the current zoomed view to the clipboard which "
"you can paste in other applications."
msgstr ""
"Нусха бардоштани расми калоншудаи равон дар хотири нусха, барои мондани ин "
"расм дар барномаҳои дигар."

#: kmag.cpp:147
msgid "Copy zoomed image to clipboard"
msgstr "Нусха бардоштани расми калоншуда да хотири нусха"

#: kmag.cpp:149
msgid "Show &Menu"
msgstr "Намоиши &Меню"

#: kmag.cpp:151
msgid "Show Main &Toolbar"
msgstr "&Нигоҳ доштани пайраҳаи асбоби асосӣ"

#: kmag.cpp:153
msgid "Show &View Toolbar"
msgstr "Нигоҳ доштани п&айраҳаи асбоб барои намоиш"

#: kmag.cpp:155
msgid "Show &Settings Toolbar"
msgstr "Намоиши &Танзимотҳои Пайраҳаи Асбоб"

#: kmag.cpp:159
msgid "&Always Fit Window"
msgstr "&Хамеша тирезаро пур кунед"

#: kmag.cpp:162
msgid "&Fit Window"
msgstr "&Пуркардани тиреза"

#: kmag.cpp:164
msgid "Click on this button to fit the zoom view to the zoom window."
msgstr "Як хела кардани андозаи расм ба андозаи тиреза."

#: kmag.cpp:165
msgid "Maximize the use of the window"
msgstr "Тирезаро пурра истифода кунед"

#: kmag.cpp:167
msgid "&Follow Mouse"
msgstr "&Аз кафои муш рафтан"

#: kmag.cpp:169
msgid "Magnify around the mouse cursor"
msgstr "Калон кардани доира дар даври курсори муш"

#: kmag.cpp:170
msgid "If selected, the area around the mouse cursor is magnified"
msgstr ""
"Агар ин пункт интихоб шуда бошад, доира дар даври курсори муш калон карда "
"мешавад."

#: kmag.cpp:172
msgid "Hide Mouse &Cursor"
msgstr "&Пинҳон кардани курсори муш"

#: kmag.cpp:174
msgid "Hide the mouse cursor"
msgstr "Курсори мушро пинҳон кунед"

#: kmag.cpp:176
msgid "Selection &Window"
msgstr "&Тирезаи расми интихобшуда"

#: kmag.cpp:178
msgid "Show the selection window on the screen"
msgstr "Намоиши расми интихобшуда дар экран"

#: kmag.cpp:181
msgid "Click on this button to <b>zoom-in</b> on the selected region."
msgstr "<b>Калон кардани</b> доираи расми интихобшуда"

#: kmag.cpp:185
msgid "Select the zoom factor."
msgstr "Ҳолати калонкардан интихоб кунед."

#: kmag.cpp:186
msgid "Zoom factor"
msgstr "Ҳолати калонкардан"

#: kmag.cpp:189
msgid "Click on this button to <b>zoom-out</b> on the selected region."
msgstr "Доираи расми интихобшуда <b>Майда кунед</b>"

#: kmag.cpp:197
msgid "&Refresh"
msgstr "&Бозсозӣ"

#: kmag.cpp:199
msgid ""
"Select the refresh rate. The higher the rate, the more computing power (CPU) "
"will be needed."
msgstr ""
"Ҷафси бозсозӣ соз кунед. Агар ҷавси бозсозӣ баланд аст, пурборкардани "
"протсессори марказӣ кори бисёр талаб мекунад (CPU)."

#: kmag.cpp:200
msgid "Refresh rate"
msgstr "Ҷавси бозсозӣ"

#: kmag.cpp:468
msgid "Save Zoomed Region"
msgstr "Доираи калонкарда нигоҳ доред"

#: kmag.cpp:475
msgid ""
"Unable to save temporary file (before uploading to the network file you "
"specified)."
msgstr "Файли вақтӣ нигоҳ дошта натавонист."

#: kmag.cpp:476 kmag.cpp:480 kmag.cpp:492
msgid "Error Writing File"
msgstr "Хатогӣ дар ҳоли навиштани файл"

#: kmag.cpp:479
msgid "Unable to upload file over the network."
msgstr "Фиристодани файл дар шабақа имконнопазир аст."

#: kmag.cpp:482 kmag.cpp:494
#, c-format
msgid ""
"Current zoomed image saved to\n"
"%1"
msgstr ""
"Расми равони калон кардашуда нигоҳ дошта шуд ба\n"
"%1"

#: kmag.cpp:491
msgid ""
"Unable to save file. Please check if you have permission to write to the "
"directory."
msgstr ""
"Файл нигоҳ дошта натавонист. Санҷет, агар шумо дастрасӣ барои навиштан дар "
"феҳрист доред."

#: kmag.cpp:511
msgid "Click to stop window update"
msgstr "Бозсозии тиреза ғайри фаъол созед"

#: kmag.cpp:514
msgid "Start"
msgstr "Сар кардан"

#: kmag.cpp:515
msgid "Click to start window update"
msgstr "Бозсозии тиреза фаъол созед"
