#: kmagzoomview.cpp:116
msgid ""
"This is the main window which shows the contents of the selected region. The "
"contents will be magnified according to the zoom level that is set."
msgstr ""
"Ин тирезаи асосӣ, ки қисми экрани "
"интихобшударо намоиш мекунад. Агар дар "
"ҳолати калонкунӣ қарор диҳем, он гоҳ "
"намоиш калон мешавад."

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr ""
"Линукси Тоҷикӣ, Роҷер Ковакс, Виктор "
"Ибрагимов, Марина Колючева, Мирзоев "
"Муҳаммад солеҳ"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "youth_opportunities@tajik.net, martel2004@mail.ru, solehjon@yahoo.com"

#: main.cpp:37
msgid "File to open"
msgstr "Файл барои кушодан"

#: kmagselrect.cpp:204 main.cpp:45
msgid "KMagnifier"
msgstr "Пурбини Экрани KDE"

#: main.cpp:46
msgid "Screen magnifier for the K Desktop Environment (KDE)"
msgstr "Пурбини Экран барои гирдуатрофи KDE"

#: main.cpp:53
msgid "Rewrite and current maintainer"
msgstr "Таъсисдиҳандаи равон"

#: main.cpp:56
msgid "Original idea and author (KDE1)"
msgstr "Муаллифи фикр ва таъсисдиҳанда (KDE1)"

#: main.cpp:58
msgid ""
"Rework of the user interface, improved selection window, speed optimisation, "
"rotation, bug fixes"
msgstr ""
"Бозсози кардани воситаи истифодабаранда, "
"беҳтар гардонидани панҷараи "
"интихобгардидашуда суръати "
"беееҳинасозӣ, даврзанӣ, дуруст кардани "
"хатогиҳо"

#: main.cpp:59
msgid "Some tips"
msgstr "Як чанд  маслиҳатҳо"

#: kmagselrect.cpp:204
msgid "Selection Window"
msgstr "Тирезаи расми интихобшуда"

#: kmag.cpp:90
msgid "&Very Low"
msgstr "&Хеле оҳиста"

#: kmag.cpp:90
msgid "&Low"
msgstr "&Оҳиста"

#: kmag.cpp:90
msgid "&Medium"
msgstr "&Миёна"

#: kmag.cpp:90
msgid "&High"
msgstr "&Баланд"

#: kmag.cpp:90
msgid "V&ery High"
msgstr "&Хеле баланд"

#: kmag.cpp:98
msgid "&No Rotation (0°)"
msgstr "&Даврзанӣ нест (0°)"

#: kmag.cpp:98
msgid "&Left (90°)"
msgstr "&Чап (90°)"

#: kmag.cpp:98
msgid "&Upside Down (180°)"
msgstr "&Аз боло ба поён (180°)"

#: kmag.cpp:98
msgid "&Right (270°)"
msgstr "&Рост (270°)"

#: kmag.cpp:127
msgid "New &Window"
msgstr "&Тирезаи Нав"

#: kmag.cpp:129
msgid "Open a new KMagnifier window"
msgstr "Кушодани Пурбини Экрани KDE-и нав"

#: kmag.cpp:131
msgid "&Stop"
msgstr "Ис&т"

#: kmag.cpp:133
msgid "Click to stop window refresh"
msgstr ""
"Барои ист кардани бозсозии тиреза зер "
"кунед"

#: kmag.cpp:134
msgid ""
"Clicking on this icon will <b>start</b> / <b>stop</b>  updating of the "
"display. Stopping the update will zero the processing power  required (CPU "
"usage)"
msgstr ""
"Бо зер кунии ин нишона шумо метавонед "
"бозсозии экран <b>фаъол</b> ё <b>ғайри "
"фаъол</b>  созед. Дар вақти ғайри фаъоли "
"бозсозии экран барнома манбаъи маркази "
"протсессорро талаб намекунад (CPU)"

#: kmag.cpp:138
msgid "&Save Snapshot As..."
msgstr "&Нигоҳ доштани расм ҳамчун..."

#: kmag.cpp:140
msgid "Saves the zoomed view to an image file."
msgstr "Сохранить увеличенное изображение в файл."

#: kmag.cpp:141
msgid "Save image to a file"
msgstr "Нигоҳ доштани расм дар файл"

#: kmag.cpp:144
msgid "Click on this button to print the current zoomed view."
msgstr "Чоп кардани расми калоншудаи равон."

#: kmag.cpp:147 kmag.cpp:148
msgid "Quits the application"
msgstr "Пӯшидани барнома"

#: kmag.cpp:151
msgid ""
"Click on this button to copy the current zoomed view to the clipboard which "
"you can paste in other applications."
msgstr ""
"Нусха бардоштани расми калоншудаи равон "
"дар хотири нусха, барои мондани ин расм "
"дар барномаҳои дигар."

#: kmag.cpp:152
msgid "Copy zoomed image to clipboard"
msgstr ""
"Нусха бардоштани расми калоншуда да "
"хотири нусха"

#: kmag.cpp:154
msgid "Show &Menu"
msgstr "Намоиши &Меню"

#: kmag.cpp:157
msgid "Hide &Menu"
msgstr "Пинҳон кардани &Меню"

#: kmag.cpp:159
msgid "Show Main &Toolbar"
msgstr "&Нигоҳ доштани пайраҳаи асбоби асосӣ"

#: kmag.cpp:162
msgid "Hide Main &Toolbar"
msgstr "&Пинҳон кардани пайраҳаи асбоби асосӣ"

#: kmag.cpp:164
msgid "Show &View Toolbar"
msgstr ""
"Нигоҳ доштани п&айраҳаи асбоб барои "
"намоиш"

#: kmag.cpp:167
msgid "Hide &View Toolbar"
msgstr ""
"Пинҳон кардани п&айраҳаи асбоб барои "
"намоиш"

#: kmag.cpp:169
msgid "Show &Settings Toolbar"
msgstr "Намоиши &Танзимотҳои Пайраҳаи Асбоб"

#: kmag.cpp:172
msgid "Hide &Settings Toolbar"
msgstr ""
"Пинҳон кардани &танзимотҳои пайраҳаи "
"асбоб"

#: kmag.cpp:175
msgid "&Follow Mouse Mode"
msgstr "&Аз кафои муш рафтан"

#: kmag.cpp:177
msgid "Magnify around the mouse cursor"
msgstr "Калон кардани доира дар даври курсори муш"

#: kmag.cpp:178
msgid "If selected, the area around the mouse cursor is magnified"
msgstr ""
"Агар ин пункт интихоб шуда бошад, доира "
"дар даври курсори муш калон карда мешавад."

#: kmag.cpp:180
msgid "Se&lection Window Mode"
msgstr "&Тирезаи расми интихобшуда"

#: kmag.cpp:182
msgid "Show a window for selecting the magnified area"
msgstr ""
"Нишон додани экран барои интихоб кардани "
"қитъаи калоншуда"

#: kmag.cpp:184
msgid "&Whole Screen Mode"
msgstr "&Тарзи пуррааи экран"

#: kmag.cpp:186
msgid "Magnify the whole screen"
msgstr "Калон кардани доира дар даври курсори муш"

#: kmag.cpp:187
msgid "Click on this button to fit the zoom view to the zoom window."
msgstr ""
"Як хела кардани андозаи расм ба андозаи "
"тиреза."

#: kmag.cpp:189
msgid "Hide Mouse &Cursor"
msgstr "&Пинҳон кардани курсори муш"

#: kmag.cpp:192
msgid "Show Mouse &Cursor"
msgstr "&Намоиши курсори муш"

#: kmag.cpp:194
msgid "Hide the mouse cursor"
msgstr "Курсори мушро пинҳон кунед"

#: kmag.cpp:197
msgid "Click on this button to <b>zoom-in</b> on the selected region."
msgstr ""
"Пахши кардани ин тугма барои<b>калон "
"кардани</b> доираи расми интихобшуда"

#: kmag.cpp:201
msgid "Select the zoom factor."
msgstr "Ҳолати калонкардан интихоб кунед."

#: kmag.cpp:202
msgid "Zoom factor"
msgstr "Ҳолати калонкардан"

#: kmag.cpp:205
msgid "Click on this button to <b>zoom-out</b> on the selected region."
msgstr "Доираи расми интихобшуда <b>Майда кунед</b>"

#: kmag.cpp:207
msgid "&Rotation"
msgstr "&Даврзанӣ"

#: kmag.cpp:209
msgid "Select the rotation factor."
msgstr "Ҳолати калонкардан интихоб кунед."

#: kmag.cpp:210
msgid "Rotation factor"
msgstr "Ҳолати калонкардан"

#: kmag.cpp:218
msgid "&Refresh"
msgstr "&Бозсозӣ"

#: kmag.cpp:220
msgid ""
"Select the refresh rate. The higher the rate, the more computing power (CPU) "
"will be needed."
msgstr ""
"Ҷафси бозсозӣ соз кунед. Агар ҷавси "
"бозсозӣ баланд аст, пурборкардани "
"протсессори марказӣ кори бисёр талаб "
"мекунад (CPU)."

#: kmag.cpp:221
msgid "Refresh rate"
msgstr "Ҷавси бозсозӣ"

#: kmag.cpp:523
msgid "Save Snapshot As"
msgstr "Нигоҳ доштани расм ҳамчун"

#: kmag.cpp:530
msgid ""
"Unable to save temporary file (before uploading to the network file you "
"specified)."
msgstr ""
"Файли вақтӣ нигоҳ дошта натавонист(пеш аз "
"пур кадани шабака мушаххаси худро пур "
"кун)."

#: kmag.cpp:531 kmag.cpp:535 kmag.cpp:547
msgid "Error Writing File"
msgstr "Хатогӣ дар вақти навиштани файл"

#: kmag.cpp:534
msgid "Unable to upload file over the network."
msgstr ""
"Фиристодани файл дар шабақа имконнопазир "
"аст."

#: kmag.cpp:537 kmag.cpp:549
#, c-format
msgid ""
"Current zoomed image saved to\n"
"%1"
msgstr ""
"Расми ҷараёни калон кардашуда нигоҳ "
"дошта шуд ба\n"
"%1"

#: kmag.cpp:546
msgid ""
"Unable to save file. Please check if you have permission to write to the "
"directory."
msgstr ""
"Файл нигоҳ дошта натавонист. Санҷет, агар "
"шумо дастрасӣ барои навиштан дар феҳрист "
"доред."

#: kmag.cpp:566
msgid "Click to stop window update"
msgstr "Бозсозии тиреза ғайри фаъол созед"

#: kmag.cpp:569
msgid "Start"
msgstr "Сар кардан"

#: kmag.cpp:570
msgid "Click to start window update"
msgstr "Бозсозии тиреза фаъол созед"
