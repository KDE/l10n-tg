#: xml_doc.cc:88
#, no-c-format
msgid "POLA(X;Y)"
msgstr "POLA(X;Y)"

#: xml_doc.cc:90
#, no-c-format
msgid "POLA(12;12) returns 0.78539816"
msgstr "POLA(12;12) бозгаштан 0.78539816"

#: xml_doc.cc:92
#, no-c-format
msgid "POLA(12;0) returns 0"
msgstr "POLA(12;0) бозгаштан 0"

#: xml_doc.cc:94
#, no-c-format
msgid "POLA(0;12) returns 1.5707"
msgstr "POLA(0;12) бозгаштан 1.5707"

#: xml_doc.cc:96 xml_doc.cc:132
#, no-c-format
msgid "Radius"
msgstr "Қутоъ"

#: xml_doc.cc:98 xml_doc.cc:134 xml_doc.cc:3732 xml_doc.cc:3742
#: xml_doc.cc:3750 xml_doc.cc:3760 xml_doc.cc:3770 xml_doc.cc:3780
#: xml_doc.cc:3790 xml_doc.cc:3800 xml_doc.cc:3810 xml_doc.cc:3820
#: xml_doc.cc:3830 xml_doc.cc:3840 xml_doc.cc:3850 xml_doc.cc:3860
#: xml_doc.cc:3862 xml_doc.cc:3872
#, no-c-format
msgid "Angle (radians)"
