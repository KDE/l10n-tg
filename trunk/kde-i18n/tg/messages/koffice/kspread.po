#: xml_doc.cc:1042 xml_doc.cc:1047
msgid "SUM(value;value;...)"
msgstr "SUM(маъно;маъно;...)"

#: xml_doc.cc:1043
msgid "SUM(12;5;7) equals 24"
msgstr "SUM(12;5;7) баробар 24"

#: xml_doc.cc:1044
msgid "SUM(12.5;2) equals 14.5"
msgstr "SUM(12.5;2) баробар 14.5"

#: xml_doc.cc:1046
msgid ""
"The SUMA() function calculates the sum of all the values given as "
"parameters. You can calculate the sum of a range SUMA(A1:B5) or a list of "
"values like SUMA(12;5;12.5). If a parameter contains text or the boolean "
"value FALSE it is counted as 0, if a parameter evaluates to TRUE it is "
"counted as 1."
msgstr ""

#: xml_doc.cc:1048
msgid "SUMA(12;5; 7) equals 24"
msgstr "SUMA(12;5; 7) баробар 24"

#: xml_doc.cc:1049
msgid "SUMA(12.5; 2; TRUE) equals 15.5"
msgstr "SUMA(12.5; 2; TRUE) баробар 15.5"

#: xml_doc.cc:1051
msgid ""
"The PRODUCT() function calculates the product of all the values given as "
"parameters. You can calculate the product of a range: PRODUCT(A1:B5) or a "
"list of values like product(12;5;12.5). If no numeric values are found 0 is "
"returned."
msgstr ""

#: xml_doc.cc:1052
msgid "PRODUCT(value;value;...)"
msgstr "PRODUCT(маъно;маъно;...)"

#: xml_doc.cc:1053
msgid "PRODUCT(3;5;7) equals 105"
msgstr "PRODUCT(3;5;7) баробар 105"

#: xml_doc.cc:1054
msgid "PRODUCT(12.5;2) equals 25"
msgstr "PRODUCT(12.5;2) баробар 25"

#: xml_doc.cc:1056
msgid ""
"The KPRODUCT() function calculates the product of all the values given as "
"parameters. You can calculate the product of a range: KPRODUCT(A1:B5) or a "
"list of values like KPRODUCT(12;5;12.5). If no numeric values are found 1 is "
"returned."
msgstr ""

#: xml_doc.cc:1057
msgid "KPRODUCT(value;value;...)"
msgstr "KPRODUCT(маъно;маъно;...)"

#: xml_doc.cc:1058
msgid "KPRODUCT(3;5;7) equals 105"
msgstr "KPRODUCT(3;5;7) баробар 105"

#: xml_doc.cc:1059
msgid "KPRODUCT(12.5;2) equals 25"
msgstr "KPRODUCT(12.5;2) ,баробар 25"

#: xml_doc.cc:1061
msgid ""
"The DIV() function divides the first value by the other values in turn. You "
"can calculate using a range: DIV(A1:B5) or a list of values like DIV"
"(12;5;12.5)."
msgstr ""

#: xml_doc.cc:1062
msgid "DIV(value;value;...)"
msgstr "DIV(маъно;маъно;...)"

#: xml_doc.cc:1063
msgid "DIV(20;2;2) returns 5"
msgstr "DIV(20;2;2) бозгаштан 5"

#: xml_doc.cc:1064
msgid "DIV(25;2.5) returns 10"
msgstr "DIV(25;2.5) бозгаштан 10"

#: xml_doc.cc:1066
msgid ""
"The SUMSQ() function calculates the sum of all the squares of values given "
"as parameters. You can calculate the sum of a range SUMSQ(A1:B5) or a list "
"of values like SUMSQ(12;5;12.5)."
msgstr ""

#: xml_doc.cc:1067
msgid "SUMSQ(value;value;...)"
msgstr "SUMSQ(маъно;маъно;...)"

#: xml_doc.cc:1068
msgid "SUMSQ(12;5;7) equals 218"
msgstr "SUMSQ(12;5;7) баробар 218"

#: xml_doc.cc:1069
msgid "SUMSQ(12.5;2) equals 173"
msgstr "SUMSQ(12.5;2) баробар 173"

#: xml_doc.cc:1071
msgid "The MAX() function returns the largest value given in the parameters."
msgstr ""

#: xml_doc.cc:1072
msgid "MAX(value;value;...)"
msgstr "MAX(маъно;маъно;...)"

#: xml_doc.cc:1073
msgid "MAX(12;5;7) returns 12"
msgstr "MAX(12;5;7) бозгаштан 12"

#: xml_doc.cc:1074
msgid "MAX(12.5;2) returns 12.5"
msgstr "MAX(12.5;2) бозгаштан 12.5"

#: xml_doc.cc:1076
msgid ""
"The MAXA() function returns the largest value given in the parameters "
"without ignoring boolean values. TRUE evaluates to 1, FALSE evaluates to 0."
msgstr ""

#: xml_doc.cc:1077
msgid "MAXA(value;value;...)"
msgstr "MAXA(маъно;маъно;...)"

#: xml_doc.cc:1078
msgid "MAXA(12;5; 7) returns 12"
msgstr "MAXA(12;5; 7) бозгаштан 12"

#: xml_doc.cc:1079
msgid "MAXA(12.5; 2) returns 12.5"
msgstr "MAXA(12.5; 2) бозгаштан 12.5"

#: xml_doc.cc:1080
msgid "MAXA(0.5; 0.4; TRUE; 0.2) returns 1"
msgstr "MAXA(0.5; 0.4; TRUE; 0.2) бозгаштан 1"

#: xml_doc.cc:1082
msgid "The MIN() function returns the smallest value given in the parameters."
msgstr ""

#: xml_doc.cc:1083
msgid "MIN(value;value;...)"
msgstr "MIN(маъно;маъно;...)"

#: xml_doc.cc:1084
msgid "MIN(12;5;7) returns 5"
msgstr "MIN(12;5;7) бозгаштан 5"

#: xml_doc.cc:1085
msgid "MIN(12.5;2) returns 2"
msgstr "MIN(12.5;2) бозгаштан 2"

#: xml_doc.cc:1087
msgid ""
"The MINA() function returns the smallest value given in the parameters "
"without ignoring boolean values: TRUE evaluates to 1, FALSE to 0."
msgstr ""

#: xml_doc.cc:1088
msgid "MINA(value;value;...)"
msgstr "MINA(маъно;маъно;...)"

#: xml_doc.cc:1089
msgid "MINA(12;5; 7) returns 5"
msgstr "MINA(12;5; 7) бозгаштан 5"

#: xml_doc.cc:1090
msgid "MINA(12.5; 2) returns 2"
msgstr "MINA(12.5; 2) бозгаштан 2"

#: xml_doc.cc:1091
msgid "MINA(0.4; 2; FALSE; 0.7) returns 0"
msgstr "MINA(0.4; 2; FALSE; 0.7) бозгаштан 0"

#: xml_doc.cc:1093
msgid ""
"The MULTIPLY() function multiplies all the values given in the parameters. "
"You can multiply values given by a range MULTIPLY(A1:B5) or a list of values "
"like MULTIPLY(12;5;12.5)."
msgstr ""

#: xml_doc.cc:1094
msgid "MULTIPLY(value;value;...)"
msgstr "MULTIPLY(маъно;маъно;...)"

#: xml_doc.cc:1095
msgid "MULTIPLY(12;5;7) equals 420"
msgstr "MULTIPLY(12;5;7) баробар 420"

#: xml_doc.cc:1096
msgid "MULTIPLY(12.5;2) equals 25"
msgstr "MULTIPLY(12.5;2) баробар 25"

#: xml_doc.cc:1098
msgid ""
"The MULTINOMIAL() function returns the multinomial of each number in the "
"parameters. It uses this formula for MULTINOMIAL(a,b,c):"
msgstr ""

#: xml_doc.cc:1099
msgid "(a+b+c)! / a!b!c!"
msgstr "(a+b+c)! / a!b!c!"

#: xml_doc.cc:1100
msgid "MULTINOMIAL(value;value;...)"
msgstr "MULTINOMIAL(маъно;маъно;...)"

#: xml_doc.cc:1101
msgid "MULTINOMIAL(3;4;5) equals 27720"
msgstr "MULTINOMIAL(3;4;5) баробар 27720"

#: xml_doc.cc:1103
msgid ""
"The SQRT() function returns the non-negative square root of x. If x is "
"negative, \"NaN\" is returned."
msgstr ""

#: xml_doc.cc:1104
msgid "SQRT(x)"
msgstr "SQRT(x)"

#: xml_doc.cc:1105
msgid "SQRT(9) equals 3"
msgstr "SQRT(9) баробар 3"

#: xml_doc.cc:1106
msgid "SQRT(-9) equals \"NaN\""
msgstr "SQRT(-9) баробар \"NaN\""

#: xml_doc.cc:1108
msgid "The SQRTPI() function returns the non-negative square root of x * PI."
msgstr ""

#: xml_doc.cc:1109
msgid "SQRTPI(x)"
msgstr "SQRTPI(x)"

#: xml_doc.cc:1110
msgid "SQRTPI(2) equals 2.506628"
msgstr "SQRTPI(2) баробар 2.506628"

#: xml_doc.cc:1112
msgid "The LN() function returns the natural logarithm of x."
msgstr ""

#: xml_doc.cc:1113
msgid "LN(x)"
msgstr "LN(x)"

#: xml_doc.cc:1114
msgid "LN(0.8) equals -0.22314355"
msgstr "LN(0.8) баробар -0.22314355"

#: xml_doc.cc:1115
msgid "LN(0) equals -inf"
msgstr "LN(0) баробар -inf"

#: xml_doc.cc:1118
msgid "The LOGn() function returns the base n logarithm of x."
msgstr ""

#: xml_doc.cc:1119
msgid "LOGn(value;base)"
msgstr "LOGn(маъно;умумӣ)"

#: xml_doc.cc:1120
msgid "LOGn(12;10) equals 1.07918125"
msgstr "LOGn(12;10) баробар 1.07918125"

#: xml_doc.cc:1121
msgid "LOGn(12;2) equals 3.5849625"
msgstr "LOGn(12;2) баробар 3.5849625"

#: xml_doc.cc:1124
msgid "The ROOTN() function returns the non-negative nth root of x."
msgstr ""

#: xml_doc.cc:1125
msgid "ROOTN(x;n)"
msgstr "ROOTN(x;n)"

#: xml_doc.cc:1126
msgid "ROOTN(9;2) equals 3"
msgstr "ROOTN(9;2) баробар 3"

#: xml_doc.cc:1128
msgid "The CUR() function returns the non-negative cube root of x."
msgstr ""

#: xml_doc.cc:1129
msgid "CUR(x)"
msgstr "CUR(x)"

#: xml_doc.cc:1130
msgid "CUR(27) equals 3"
msgstr "CUR(27) баробар 3"

#: xml_doc.cc:1132
msgid "The LOG() function returns the base-10 logarithm of x."
msgstr ""

#: xml_doc.cc:1133
msgid "LOG(x)"
msgstr "LOG(x)"

#: xml_doc.cc:1134
msgid "LOG(0.8) equals -0.09691001"
msgstr "LOG(0.8) баробар -0.09691001"

#: xml_doc.cc:1135
msgid "LOG(0) equals -inf."
msgstr "LOG(0) баробар -inf."

#: xml_doc.cc:1137
msgid ""
"The EXP() function returns the value of e (the base of natural logarithms) "
"raised to the power of x."
msgstr ""

#: xml_doc.cc:1138
msgid "EXP(x)"
msgstr "EXP(x)"

#: xml_doc.cc:1139
msgid "EXP(9) equals 8 103.08392758"
msgstr "EXP(9) баробар 8 103.08392758"

#: xml_doc.cc:1140
msgid "EXP(-9) equals 0.00012341"
msgstr "EXP(-9) баробар 0.00012341"

#: xml_doc.cc:1142
msgid ""
"The CEIL() function rounds x up to the nearest integer, returning that value "
"as a double."
msgstr ""

#: xml_doc.cc:1143
msgid "CEIL(x)"
msgstr "CEIL(x)"

#: xml_doc.cc:1144
msgid "CEIL(12.5) equals 13"
msgstr "CEIL(12.5) баробар 13"

#: xml_doc.cc:1145
msgid "CEIL(-12.5) equals -12"
msgstr "CEIL(-12.5) баробар -12"

#: xml_doc.cc:1147
msgid "Significance (optional)"
msgstr ""

#: xml_doc.cc:1148
msgid ""
"The CEILING() function rounds x up to the nearest multiple of significance."
msgstr ""

#: xml_doc.cc:1149
msgid "CEILING(x)"
msgstr "CEILING(x)"

#: xml_doc.cc:1150
msgid "CEILING(12.5) equals 13"
msgstr "CEILING(12.5) баробар 13"

#: xml_doc.cc:1151
msgid "CEILING(6.43; 4) equals 8"
msgstr "CEILING(6.43; 4) баробар 8"

#: xml_doc.cc:1153
msgid ""
"The FLOOR() function rounds x down to the nearest integer, returning that "
"value as a double."
msgstr ""

#: xml_doc.cc:1154
msgid "FLOOR(x)"
msgstr "FLOOR(x)"

#: xml_doc.cc:1155
msgid "FLOOR(12.5) equals 12"
msgstr "FLOOR(12.5) баробар 12"

#: xml_doc.cc:1156
msgid "FLOOR(-12.5) equals -13"
msgstr "FLOOR(-12.5) баробар -13"

#: xml_doc.cc:1158
msgid ""
"The ABS() function returns the absolute value of the floating-point number x."
msgstr ""

#: xml_doc.cc:1159
msgid "ABS(x)"
msgstr "ABS(x)"

#: xml_doc.cc:1160
msgid "ABS(12.5) equals 12.5"
msgstr "ABS(12.5) баробар 12.5"

#: xml_doc.cc:1161
msgid "ABS(-12.5) equals 12.5"
msgstr "ABS(-12.5) баробар 12.5"

#: xml_doc.cc:1163
msgid "The INT() function returns the integer part of the value."
msgstr ""

#: xml_doc.cc:1164
msgid "INT(x)"
msgstr "INT(x)"

#: xml_doc.cc:1165
msgid "INT(12.55) equals 12"
msgstr "INT(12.55) баробар 12"

#: xml_doc.cc:1166
msgid "INT(15) equals 15"
msgstr "INT(15) баробар 15"

#: xml_doc.cc:1167
msgid "The RAND() function returns a pseudo-random number between 0 and 1."
msgstr ""

#: xml_doc.cc:1168
msgid "RAND()"
msgstr "RAND()"

#: xml_doc.cc:1169
msgid "RAND() equals for example 0.78309922..."
msgstr ""

#: xml_doc.cc:1170 xml_doc.cc:1174
msgid "A floating point value (greater 0)"
msgstr ""

#: xml_doc.cc:1171
msgid ""
"The RANDEXP() function returns an exponentially-distributed pseudo-random "
"number."
msgstr ""

#: xml_doc.cc:1172
msgid "RANDEXP(x)"
msgstr "RANDEXP(x)"

#: xml_doc.cc:1173
msgid "RANDEXP(0.88)"
msgstr "RANDEXP(0.88)"

#: xml_doc.cc:1176
msgid ""
"The RANDPOISSON() function returns a poisson-distributed pseudo-random "
"number."
msgstr ""

#: xml_doc.cc:1177
msgid "RANDPOISSON(x)"
msgstr "RANDPOISSON(x)"

#: xml_doc.cc:1178
msgid "RANDPOISSON(4)"
msgstr "RANDPOISSON(4)"

#: xml_doc.cc:1179 xml_doc.cc:1184 xml_doc.cc:1189
msgid "A floating point value (between 0 and 1)"
msgstr ""

#: xml_doc.cc:1180
msgid "Trials (greater 0)"
msgstr ""

#: xml_doc.cc:1181
msgid ""
"The RANDBINOM() function returns a binomially-distributed pseudo-random "
"number."
msgstr ""

#: xml_doc.cc:1182
msgid "RANDBINOM(x)"
msgstr "RANDBINOM(x)"

#: xml_doc.cc:1183
msgid "RANDBINOM(4)"
msgstr "RANDBINOM(4)"

#: xml_doc.cc:1185
msgid "Failures (greater 0)"
msgstr ""

#: xml_doc.cc:1186
msgid ""
"The RANDNEGBINOM() function returns a negative binomially-distributed pseudo-"
"random number."
msgstr ""

#: xml_doc.cc:1187
msgid "RANDNEGBINOM(x)"
msgstr "RANDNEGBINOM(x)"

#: xml_doc.cc:1188
msgid "RANDNEGBINOM(4)"
msgstr "RANDNEGBINOM(4)"

#: xml_doc.cc:1191
msgid ""
"The RANDBERNOULLI() function returns a Bernoulli-distributed pseudo-random "
"number."
msgstr ""

#: xml_doc.cc:1192
msgid "RANDBERNOULLI(x)"
msgstr "RANDBERNOULLI(x)"

#: xml_doc.cc:1193
msgid "RANDBERNOULLI(0.45)"
msgstr "RANDBERNOULLI(0.45)"

#: xml_doc.cc:1194
msgid "Bottom value"
msgstr "Маънои поён"

#: xml_doc.cc:1195
msgid "Top value"
msgstr "Маънои боло"

#: xml_doc.cc:1196
msgid ""
"The RANDBETWEEN() function returns a pseudo-random number between bottom and "
"top value. If bottom > top this function returns Err."
msgstr ""

#: xml_doc.cc:1197
msgid "RANDBETWEEN(bottom;top)"
msgstr "RANDBETWEEN(поён;боло)"

#: xml_doc.cc:1198
msgid "RANDBETWEEN(12;78) equals for example 61.0811..."
msgstr ""

#: xml_doc.cc:1200
msgid "Multiple"
msgstr "Зарбкунанда"

#: xml_doc.cc:1201
msgid ""
"The MROUND() function returns the value rounded to the specified multiple. "
"The value and the multiple must have the same sign"
msgstr ""

#: xml_doc.cc:1202
msgid "MROUND(value; multiple)"
msgstr "MROUND(маъно; зарбкунанда)"

#: xml_doc.cc:1203
msgid "MROUND(1.252; 0.5) equals 1.5"
msgstr "MROUND(1.252; 0.5) баробар 1.5"

#: xml_doc.cc:1204
msgid "MROUND(-1.252; -0.5) equals -1.5"
msgstr "MROUND(-1.252; -0.5) баробар -1.5"

#: xml_doc.cc:1206 xml_doc.cc:1215 xml_doc.cc:1222
msgid "Digits"
msgstr "Рақамҳо"

#: xml_doc.cc:1207
msgid ""
"The ROUND(value;[digits]) function returns value rounded. Digits is the "
"number of digits to which you want to round that number. If digits is zero "
"or omitted, value is rounded up to the nearest integer. If digits is smaller "
"than zero, the corresponding integer part of the number is rounded."
msgstr ""

#: xml_doc.cc:1208
msgid "ROUND(value;[digits])"
msgstr "ROUND(маъно;[рақамҳо])"

#: xml_doc.cc:1209
msgid "ROUND(1.252;2) equals 1.25"
msgstr "ROUND(1.252;2) баробар 1.25"

#: xml_doc.cc:1210
msgid "ROUND(-1.252;2) equals -1.25"
msgstr "ROUND(-1.252;2) баробар -1.25"

#: xml_doc.cc:1211
msgid "ROUND(1.258;2) equals 1.26"
msgstr "ROUND(1.258;2) баробар 1.26"

#: xml_doc.cc:1212
msgid "ROUND(-12.25;-1) equals -10"
msgstr "ROUND(-12.25;-1) баробар -10"

#: xml_doc.cc:1213
msgid "ROUND(-1.252;0) equals -1"
msgstr "ROUND(-1.252;0) баробар -1"

#: xml_doc.cc:1216
msgid ""
"The ROUNDUP(value;[digits]) function returns value rounded up. Digits is the "
"number of digits to which you want to round that number. If digits is zero "
"or omitted, value is rounded up to the nearest integer."
msgstr ""

#: xml_doc.cc:1217
msgid "ROUNDUP(value;[digits])"
msgstr "ROUNDUP(маъно;[рақамҳо])"

#: xml_doc.cc:1218
msgid "ROUNDUP(1.252;2) equals 1.26"
msgstr "ROUNDUP(1.252;2) баробар 1.26"

#: xml_doc.cc:1219
msgid "ROUNDUP(-1.252;2) equals -1.25"
msgstr "ROUNDUP(-1.252;2) баробар -1.25"

#: xml_doc.cc:1220
msgid "ROUNDUP(-1.252) equals -1"
msgstr "ROUNDUP(-1.252) баробар -1"

#: xml_doc.cc:1223
msgid ""
"The ROUNDDOWN(value;[digits]) function returns value rounded down. Digits is "
"the number of digits to which you want to round that number. If digits is "
"zero or omitted, value is rounded down to the nearest integer."
msgstr ""

#: xml_doc.cc:1224
msgid "ROUNDDOWN(value;[digits])"
msgstr "ROUNDDOWN(маъно;[рақамҳо])"

#: xml_doc.cc:1225
msgid "ROUNDDOWN(1.252;2) equals 1.25"
msgstr "ROUNDDOWN(1.252;2) баробар 1.25"

#: xml_doc.cc:1226
msgid "ROUNDDOWN(-1.252;2) equals -1.26"
msgstr "ROUNDDOWN(-1.252;2) баробар -1.26"

#: xml_doc.cc:1227
msgid "ROUNDDOWN(-1.252) equals -2"
msgstr "ROUNDDOWN(-1.252) баробар -2"

#: xml_doc.cc:1228
msgid "Nth term"
msgstr "Муқаддимаи N"

#: xml_doc.cc:1229
msgid ""
"Function FIB calculates the Nth term of a Fibonacci sequence (1, 1, 2, 3, 5, "
"8, 13, 21...), in which each number, after the first two, is the sum of the "
"two numbers immediately preceding it. @FIB(0) is defined to be 0."
msgstr ""

#: xml_doc.cc:1230
msgid "FIB(n)"
msgstr "FIB(n)"

#: xml_doc.cc:1231
msgid "FIB(9) returns 34"
msgstr "FIB(9) бозгаштан 34"

#: xml_doc.cc:1232
msgid "FIB(26) returns 121393"
msgstr "FIB(26) бозгаштан 121393"

#: xml_doc.cc:1233
msgid "Numerator"
msgstr "Сурат"

#: xml_doc.cc:1234
msgid "Denumerator"
msgstr "Махраҷ"

#: xml_doc.cc:1235
msgid "Function QUOTIENT returns the integer portion of numerator/denumerator."
msgstr ""

#: xml_doc.cc:1236
msgid "QUOTIENT(numerator;denumerator)"
msgstr "QUOTIENT(сурат;махраҷ)"

#: xml_doc.cc:1237
msgid "QUOTIENT(21;4) returns 5"
msgstr "QUOTIENT(21;4) бозгаштан 5"

#: xml_doc.cc:1238
msgid "Lookup & Reference"
msgstr "Ҷустуҷӯ ва эзоҳ"

#: xml_doc.cc:1239
msgid "Row number"
msgstr "Рақами қатор"

#: xml_doc.cc:1240
msgid "Column number"
msgstr "Рақами сутун"

#: xml_doc.cc:1241
msgid "Absolute number (optional)"
msgstr "Рақами мутлақ (параметри ғайриҳатмӣ)"

#: xml_doc.cc:1242 xml_doc.cc:1276
msgid "A1 style (optional)"
msgstr "Услуби A1 (параметри ғайриҳатмӣ)"

#: xml_doc.cc:1243
msgid "Sheet name"
msgstr "Номи варақ"

#: xml_doc.cc:1244
msgid ""
"The ADDRESS creates a cell address. Parameter Row is the row number and "
"Column is the column number."
msgstr ""

#: xml_doc.cc:1245
msgid ""
"Absolute number specifies the type of reference: 1 or omitted = Absolute, 2 "
"= Absolute row, relative column,  3 = Relative row; absolute column and 4 = "
"Relative."
msgstr ""

#: xml_doc.cc:1246
msgid ""
"A1 Style specifies the style of the address to return. If A1 is set to TRUE "
"(default) the address is returned in A1 style if it is set to FALSE in R1C1 "
"style."
msgstr ""

#: xml_doc.cc:1247
msgid "Sheet name is the text specifying the name of the sheet."
msgstr ""

#: xml_doc.cc:1248
msgid "ADDRESS(row; col; absolute; style; sheet name)"
msgstr "ADDRESS(қатор; сутун; мутлақ; услуб; номи варақ)"

#: xml_doc.cc:1249
msgid "ADDRESS(6; 4) returns $D$6"
msgstr "ADDRESS(6; 4) бозгаштан $D$6"

#: xml_doc.cc:1250
msgid "ADDRESS(6; 4; 2) returns D$6"
msgstr "ADDRESS(6; 4; 2) бозгаштан D$6"

#: xml_doc.cc:1251
msgid "ADDRESS(6; 4; 2; FALSE; \"Sheet1\") returns Sheet1!R6C[4]"
msgstr "ADDRESS(6; 4; 2; FALSE; \"Sheet1\") бозгаштан Sheet1!R6C[4]"

#: xml_doc.cc:1252
msgid "ADDRESS(6; 4; 1; FALSE; \"Sheet1\") returns Sheet1!R6C4"
msgstr "ADDRESS(6; 4; 1; FALSE; \"Sheet1\") бозгаштан Sheet1!R6C4"

#: xml_doc.cc:1253
msgid "ADDRESS(6; 4; 4; TRUE; \"Sheet1\") returns Sheet1!D6"
msgstr "ADDRESS(6; 4; 4; TRUE; \"Sheet1\") бозгаштан Sheet1!D6"

#: xml_doc.cc:1254 xml_doc.cc:1265 xml_doc.cc:1270 xml_doc.cc:1275
#: xml_doc.cc:1281 xml_doc.cc:1286
msgid "Reference"
msgstr "Истинод"

#: xml_doc.cc:1255
msgid ""
"Returns the number of areas in the reference string. An area can be asingle "
"cell or a set of cells."
msgstr ""

#: xml_doc.cc:1256
msgid "AREAS(reference)"
msgstr "AREAS(истинод)"

#: xml_doc.cc:1257
msgid "AREAS(A1) returns 1"
msgstr "AREAS(A1) бозгаштан 1"

#: xml_doc.cc:1258
