msgid "HOUR(time)"
msgstr "HOUR(вақт)"

#: xml_doc.cc:210
msgid "HOUR(\"22:10:12\") returns 22"
msgstr "HOUR(\"22:10:12\") бозгаштан 22"

#: xml_doc.cc:211
msgid "HOUR(0.1285) returns 3"
msgstr "HOUR(0.1285) бозгаштан 3"

