#: xml_doc.cc:2
#, no-c-format
msgid "Conversion"
msgstr "Ислоҳот"

#: xml_doc.cc:4 xml_doc.cc:28
#, no-c-format
msgid "Bool value to convert"
msgstr "Маънои мантиқ барои ислоҳот"

#: xml_doc.cc:6
#, no-c-format
msgid ""
"The BOOL2STRING() function returns a string value for a given boolean value. "
"This method is intended for using a boolean in methods which require a string"
msgstr ""
"Функсияи BOOL2STRING() сатре, ки ба мақодири "
"мантиқии ишорашуда низ мутобиқат "
"мекунад, бар хоҳад гардонд."

#: xml_doc.cc:8
#, no-c-format
msgid "BOOL2STRING(value)"
msgstr "BOOL2STRING(value)"

#: xml_doc.cc:10
#, no-c-format
msgid "BOOL2STRING(true) returns \"True\""
msgstr "BOOL2STRING(true) бозгаштан \"True\""

#: xml_doc.cc:12
#, no-c-format
msgid "BOOL2STRING(false) returns \"False\""
msgstr "BOOL2STRING(false) бозгаштан \"False\""

#: xml_doc.cc:14
#, no-c-format
msgid "upper(BOOL2STRING(find(\"nan\";\"banana\"))) returns TRUE"
msgstr "upper(BOOL2STRING(find(\"nan\";\"banana\"))) бозгаштан TRUE"

#: xml_doc.cc:16
#, no-c-format
msgid "Integer value to convert"
msgstr "Маънои пурра барои ислоҳот"

#: xml_doc.cc:18
#, no-c-format
msgid ""
"The INT2BOOL() function returns a boolean value for a given integer number. "
"This method is intended for using an integer in methods which require a "
"boolean. It only accepts 0 or 1. If any other value is given, false is "
"returned."
msgstr ""
"Функсияи INT2BOOL() мақодири мантиқиро, ки ба "
"рақами бутуни ишора шуда низ мутобиқат "
"мекунад, бар хоҳад гардонд. Ин тарз барои "
"параметрҳоро ба функсия додан, ки "
"мақодири мантиқиро талаб мекунанд, "
"пешаки муқаррар шудаанд. Ҳамчун параметр "
"додан мумкин аст танҳо ба 0 ва 1. Мавриди "
"диҳиши дигар рақам, false хурӯҷ хоҳад шуд."

#: xml_doc.cc:20
#, no-c-format
msgid "INT2BOOL(value)"
msgstr "INT2BOOL(маъно)"

#: xml_doc.cc:22
#, no-c-format
msgid "INT2BOOL(1) returns true"
msgstr "INT2BOOL(1) бозгаштан true"

#: xml_doc.cc:24
#, no-c-format
msgid "INT2BOOL(0) returns false"
msgstr "INT2BOOL(0) бозгаштан false"

#: xml_doc.cc:26
#, no-c-format
msgid "OR(INT2BOOL(1); false) returns true"
msgstr "OR(INT2BOOL(1); false) бозгаштан true"

#: xml_doc.cc:30
#, no-c-format
msgid ""
"The BOOL2INT() function returns an integer value for a given boolean value. "
"This method is intended for using a boolean value in methods which require "
"an integer."
msgstr ""
"Функсияи BOOL2INT() рақами бутунро, ки ба "
"мақодири мантиқӣ мутобиқат мекунад, бар "
"хоҳад гардонд. Ин тарз барои диҳиши "
"параметрҳо, ки мақодири рақамиро талаб "
"мекунад, пешакӣ муқаррар шудааст."

#: xml_doc.cc:32
#, no-c-format
msgid "BOOL2INT(value)"
msgstr "BOOL2INT(value)"

#: xml_doc.cc:34
#, no-c-format
msgid "BOOL2INT(True) returns 1"
msgstr "BOOL2INT(True) бозгаштан 1"

#: xml_doc.cc:36
#, no-c-format
msgid "BOOL2INT(False) returns 0"
msgstr "BOOL2INT(False) бозгаштан 0"

#: xml_doc.cc:38
#, no-c-format
msgid "number to convert into string"
msgstr "рақами тағири дар сатр"

#: xml_doc.cc:40
#, no-c-format
msgid ""
"The NUM2STRING() function returns a string value for a given number. This "
"method is intended for using a number in methods which require a string"
msgstr ""
"Функсияи NUM2STRING(), рақамро ба сатр табдил "
"хоҳад дод. Ин тарз барои диҳиши "
"параметрҳо ба функсия, ки мақодири "
"матниро талаб мекунанд, пешакӣ муқаррар "
"шудаанд."

#: xml_doc.cc:42
#, no-c-format
msgid "NUM2STRING(value)"
msgstr "NUM2STRING(value)"

#: xml_doc.cc:44
#, no-c-format
msgid "NUM2STRING(10) returns \"10\""
msgstr "NUM2STRING(10) бозгаштан \"10\""

#: xml_doc.cc:46
#, no-c-format
msgid "NUM2STRING(2.05) returns \"2.05\""
msgstr "NUM2STRING(2.05) бозгаштан \"2.05\""

#: xml_doc.cc:48
#, no-c-format
msgid "=find(\"101\";NUM2STRING(A1)) (A1 = 2.010102) returns True"
msgstr "=find(\"101\";NUM2STRING(A1)) (A1 = 2.010102) бозгаштан True"

#: xml_doc.cc:50
#, no-c-format
msgid "A one character string to convert"
msgstr "Сатри аз якум рамз"

#: xml_doc.cc:52
#, no-c-format
msgid "The CHARTOASCII() function returns the ASCII code for the given character."
msgstr ""
"Функсияи CHARTOASCII() коди ASCII-ро барои нишонаи "
"ишорашуда низ бар мегардонад."

#: xml_doc.cc:54
#, no-c-format
msgid "CHARTOASCII(value)"
msgstr "CHARTOASCII(value)"

#: xml_doc.cc:56
#, no-c-format
msgid "CHARTOASCII(\"v\") returns 118"
msgstr "CHARTOASCII(\"v\") бозгаштан 118"

#: xml_doc.cc:58
#, no-c-format
msgid "CHARTOASCII(r) is an error. The character must be in quotes."
msgstr ""
"CHARTOASCII(r) хатогиро бар мегардонад. Нишона "
"бояд дар нохунак бошад."

#: xml_doc.cc:60
#, no-c-format
msgid "The ASCII values to convert"
msgstr "Маънои рамзи ASCII"

#: xml_doc.cc:62
#, no-c-format
msgid "The ASCIITOCHAR() function returns the character for each given ASCII code"
msgstr ""
"Функсияи ASCIITOCHAR() нишонаро ба коди "
"шорашудаи ASCII, бар мегардонад"

#: xml_doc.cc:64
#, no-c-format
msgid "ASCIITOCHAR(value)"
msgstr "ASCIITOCHAR(value)"

#: xml_doc.cc:66
#, no-c-format
msgid "ASCIITOCHAR(118) returns \"v\""
msgstr "ASCIITOCHAR(118) бозгаштан \"v\""

#: xml_doc.cc:68
#, no-c-format
msgid "ASCIITOCHAR(75; 68; 69) returns \"KDE\""
msgstr "ASCIITOCHAR(75; 68; 69) бозгаштан \"KDE\""

#: xml_doc.cc:70 xml_doc.cc:82
#, no-c-format
msgid "Value in X"
msgstr "Маъно дар X"

#: xml_doc.cc:72 xml_doc.cc:84
#, no-c-format
msgid "Value in Y"
msgstr "Маъно дар Y"

#: xml_doc.cc:74
#, no-c-format
