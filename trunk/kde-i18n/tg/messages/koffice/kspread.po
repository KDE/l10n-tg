#, no-c-format
msgid "MONTHNAME(number)"
msgstr "MONTHNAME(рақам)"

#: xml_doc.cc:610
#, no-c-format
msgid "MONTHNAME(5) returns May"
msgstr "MONTHNAME(5) бозгаштан Май"

#: xml_doc.cc:612
#, no-c-format
msgid ""
"The CURRENTDATE() function returns the current date formatted with local "
"parameters."
msgstr ""
"Функсияи CURRENTDATE(), санаи равонро дар сатри "
"ба андоза дароварда бар мегардонад."

#: xml_doc.cc:614
#, no-c-format
msgid "CURRENTDATE()"
msgstr "CURRENTDATE()"

#: xml_doc.cc:616
#, no-c-format
msgid "CURRENTDATE() returns \"Saturday 13 April 2002\""
msgstr "CURRENTDATE() бозгаштан \"Шанбе 13 Апрел 2002\""

#: xml_doc.cc:618
#, no-c-format
msgid ""
"The TODAY() function returns the current date formatted with local "
"parameters. It is similar to  SHORTCURRENTDATE except that it returns a date."
msgstr ""
"Функсияи TODAY(), санаи равонро, ки бо "
"мутақобили тазимоти локалӣ ба андоза "
"дароварда буд, бар мегардонад."

#: xml_doc.cc:620
#, no-c-format
msgid "TODAY()"
msgstr "TODAY()"

#: xml_doc.cc:622
#, no-c-format
msgid "TODAY() returns \"Saturday 13 April 2002\""
msgstr "TODAY() бозгаштан \"Шанбе 13 Апрел 2002\""

#: xml_doc.cc:624
#, no-c-format
msgid ""
"The NOW() function returns the current date formatted with local parameters. "
"It is identical with CURRENTDATETIME and provided for compatibility with "
"other applications."
msgstr ""
"Функсияи NOW(), санаи равонро ки бо "
"мутақобили тазимоти локалӣ ба андоза "
"дароварда буд, бар мегардонад. Ин "
"функсияи мусовӣ CURRENTDATETIME аст ва барои "
"мувофиқот бо барномаҳои дигар низ пешаки "
"таъин шудааст."

#: xml_doc.cc:626
#, no-c-format
msgid "NOW()"
msgstr "NOW()"

#: xml_doc.cc:628
#, no-c-format
msgid "NOW() returns \"Saturday 13 April 2002 19:12:01\""
msgstr "NOW() бозгаштан \"Шанбе 13 Апрел 2002 19:12:01\""

#: xml_doc.cc:630
#, no-c-format
msgid ""
"The SHORTCURRENTDATE() function returns the current date formatted with "
"local parameters."
msgstr ""
"Функсияи SHORTCURRENTDATE(), санаи равонро дар "
"сатре, ки бо мутақобилияти локали равон "
"ба андоза дароварда буд, бар мегардонад."

#: xml_doc.cc:632
#, no-c-format
msgid "SHORTCURRENTDATE()"
msgstr "SHORTCURRENTDATE()"

#: xml_doc.cc:634
#, no-c-format
msgid "SHORTCURRENTDATE() returns \"04/13/02\""
msgstr "SHORTCURRENTDATE() бозгаштан \"04/13/02\""

#: xml_doc.cc:636
#, no-c-format
msgid ""
"The CURRENTDATETIME() function returns the current date and time formatted "
"with local parameters."
msgstr ""
"Функсияи CURRENTDATETIME(), сана ва муддати "
"равонро, ки бо истифодоти танзимоти "
"локалӣ ба андоза дароварда буд, бар "
"мегардонад."

#: xml_doc.cc:638
#, no-c-format
msgid "CURRENTDATETIME()"
msgstr "CURRENTDATETIME()"

#: xml_doc.cc:640
#, no-c-format
msgid "CURRENTDATETIME() returns \"Saturday 13 April 2002 19:12:01\""
msgstr ""
"CURRENTDATETIME() бозгаштан \"Шанбе 13 Апрел 2002 "
"19:12:01\""

#: xml_doc.cc:642
#, no-c-format
msgid ""
"The CURRENTTIME() function returns the current time formatted with local "
"parameters."
msgstr ""
"Функсияи CURRENTTIME(), муддати равонро дар "
"сатри ба андоза дароварда низ бар "
"мегардонад."

#: xml_doc.cc:644
#, no-c-format
msgid "CURRENTTIME()"
msgstr "CURRENTTIME()"

#: xml_doc.cc:646
#, no-c-format
msgid "CURRENTTIME() returns \"19:12:01\""
msgstr "CURRENTTIME() бозгаштан \"19:12:01\""

#: xml_doc.cc:650
#, no-c-format
msgid ""
"The EASTERSUNDAY() function returns the date which corresponds to Easter "
"Sunday in the year given as the parameter."
msgstr ""
"Функсияи EASTERSUNDAY(), санаи Писҳоро дар соли "
"дода шуда бар мегардонад."

#: xml_doc.cc:652
#, no-c-format
msgid "EASTERSUNDAY(year)"
msgstr "EASTERSUNDAY(сол)"

#: xml_doc.cc:654
#, no-c-format
msgid "EASTERSUNDAY(2003) returns \"20th April 2003\""
msgstr "EASTERSUNDAY(2003) бозгаштан \"20 Апрел 2003\""

#: xml_doc.cc:658
#, no-c-format
msgid ""
"The ISOWEEKNUM() function returns number of the week which the date falls "
"into. Note that this function is compliant with the ISO8601 standard: a week "
"always begins on a Monday, and ends on a Sunday. The first week of a year is "
"that week which contains the first Thursday of the year."
msgstr ""
"Функсияи ISOWEEKNUM(), рақами ҳафтаро дар як "
"сол, ки дар он санаи дода шуда рост меояд, "
"бар мегардонад. Таваҷҷӯъ: ин функсия бо "
"стандарти ISO8601 мувофиқ аст - ҳафта доимо "
"аз душанбе оғоз меёбад ва якшанбе ба "
"итмом мерасад. Ибтидои ҳафтаи сол - ин он "
"ҳафтаест, ки он дорои панҷшанбеи аввале "
"дар сол мебошад."

#: xml_doc.cc:660
#, no-c-format
msgid "ISOWEEKNUM(date)"
msgstr "ISOWEEKNUM(таърих)"

#: xml_doc.cc:662
#, no-c-format
msgid "ISOWEEKNUM(A1) returns 51 when A1 is \"21st of Dec\"."
msgstr ""
"ISOWEEKNUM(A1) бозгаштани 51, агар дар ячейка A1 "
"таърих \"21st of Dec\"аст."

