#, no-c-format
msgid "POLR(12;12) returns 16.9705"
msgstr "POLR(12;12) бозгаштан 16.9705"

#: xml_doc.cc:80
#, no-c-format
msgid "POLR(12;0) returns 12"
msgstr "POLR(12;0) бозгаштан 12"

#: xml_doc.cc:86
#, no-c-format
