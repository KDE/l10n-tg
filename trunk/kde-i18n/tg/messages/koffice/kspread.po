msgstr "DMAX(Асосӣ маълумот; \"Сарлавҳа\"; Мазмунҳо)"

#: xml_doc.cc:236
#, no-c-format
msgid "DMAX(A1:C5; \"Salary\"; A9:A11)"
msgstr "DMAX(A1:C5; \"Salary\"; A9:A11)"

