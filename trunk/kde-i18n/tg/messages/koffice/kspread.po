msgid "MINUTE(\"22:10:12\") returns 10"
msgstr "MINUTE(\"22:10:12\") бозгаштан 10"

#: xml_doc.cc:216
msgid "MINUTE(0.1234) returns 57"
msgstr "MINUTE(0.1234) бозгаштан 57"

