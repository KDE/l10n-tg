msgstr ""

#: xml_doc.cc:1283
msgid "ROW(reference)"
msgstr "ROW(истинод)"

#: xml_doc.cc:1284
msgid "ROW(A1) returns 1"
msgstr "ROW(A1) бозгаштан 1"

#: xml_doc.cc:1285
msgid "ROW(D2) returns 2"
msgstr "ROW(D2) бозгаштан 2"

