msgid ""
"Returns the largest value in a column of a database specified by a set of "
"conditions."
msgstr ""
"Миқдори зиёдеро дар сутуни бонки додаҳо "
"бо аҳамияте, ки фоқиди қаноат аст, бар "
"мегардонад."

#: xml_doc.cc:234
#, no-c-format
