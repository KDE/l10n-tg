msgstr "Умумӣ"

#: qeditor_part.cpp:865
msgid "Highlighting"
msgstr "Андак аз таг равшан кардан"

#: qeditor_view.cpp:685
msgid "Reloa&d"
msgstr "Аз нав пурбор &кардан"

#: qeditor_view.cpp:688
msgid "<b>Reload</b><p>Reloads the current document from disk."
msgstr ""
"<b>Дуруст кардан</b>"
"<p>Аз нав пур бор кардани ҳуҷҷат аз диск."

#: qeditor_view.cpp:691
msgid "Reverts the most recent editing actions."
msgstr "Бекор кардани ивазҳои охирин."

#: qeditor_view.cpp:693
msgid "Reverts the most recent undo operation."
msgstr "Бекор кардани ивазҳои охирини ботилӣ."

#: qeditor_view.cpp:696
msgid "Cuts the selected text and moves it to the clipboard."
msgstr ""
"Бурида ҷудо кардани матн аз буфери иваз "
"карда."

#: qeditor_view.cpp:698
msgid "Copies the selected text to the clipboard."
msgstr ""
"Нусха бардоштани матн аз буфери иваз "
"карда."

#: qeditor_view.cpp:701
msgid "Pastes previously copied or cut clipboard contents."
msgstr "Гузоштани матн аз буфери иваз карда."

#: qeditor_view.cpp:703
msgid "Selects the entire text of the current document."
msgstr "Тақсим кардани матни пурра."

#: qeditor_view.cpp:706
msgid ""
"Opens a dialog and lets you choose a line that you want the cursor to move "
"to."
msgstr "Рақами сатри даркориро гирифта бурдан."

#: qeditor_view.cpp:708
msgid "Looks up the first occurrence of a piece of text or regular expression."
msgstr ""
"Ёфтани даромадгоҳи матни якум ё изҳори "
"ботартиб."

#: qeditor_view.cpp:710
msgid ""
"Looks up a piece of text or regular expression and replace the result with "
"some given text."
msgstr ""
"Ёфтани матн ё изҳори ботартиб ва онро бо "
"матни муқрраршуда иваз кардан."

#: qeditor_view.cpp:712
msgid "&Indent"
msgstr "&Фосила"

#: qeditor_view.cpp:716
msgid "<b>Indent</b><p>Indents a selected block of text."
msgstr ""
"<b>Фосила</b>"
"<p>Пур бор кардани фосила барои матни "
"муқарраршуда."

#: qeditor_view.cpp:718
msgid "Collapse All Blocks"
msgstr "Маҳдуд кардани ҳамаи блокҳо"

#: qeditor_view.cpp:721
msgid "Collapse all blocks"
msgstr "Маҳдуд кардани ҳамаи блокҳо"

#: qeditor_view.cpp:722
msgid "<b>Collapse all blocks</b><p>Collapses all blocks in the current document."
msgstr ""
"<b>Маҳдуд кардани ҳамаи блокҳо</b>"
"<p>Маҳдуд кардани ҳамаи блокҳо дар ҳуҷҷат."

#: qeditor_view.cpp:724
msgid "Expand All Blocks"
msgstr "Кушодани ҳамаи блокҳо"

#: qeditor_view.cpp:727
msgid "Expand all blocks"
msgstr "Кушодани ҳамаи блокҳо"

#: qeditor_view.cpp:728
msgid "<b>Expand all blocks</b><p>Expands all blocks in the current document."
msgstr ""
"<b>Кушодани ҳамаи блокҳо</b>"
"<p>Кушодани ҳамаи блокҳо дар ҳуҷҷат."

#: qeditor_view.cpp:730
msgid "Start Macro"
msgstr "Сар кардани навиштан"

#: qeditor_view.cpp:733
msgid "Start macro"
msgstr "Сар кардани навиштан"

#: qeditor_view.cpp:734
msgid "<b>Start macro</b><p>Starts recording a macro based on the editor input."
msgstr ""
"<b>Сар кардани навиштан</b>"
"<p>Сар кардани навиштани амалиёт дар "
"таҳрир."

#: qeditor_view.cpp:736
msgid "Stop Macro"
msgstr "Нигоҳ доштани макрос"

#: qeditor_view.cpp:739
msgid "Stop macro"
msgstr "Нигоҳ доштани макрос"

#: qeditor_view.cpp:740
msgid "<b>Stop macro</b><p>Stops recording a macro."
msgstr ""
"<b>Нигоҳ доштани навишт</b>"
"<p>Нигоҳ доштани навишти макрос."

#: qeditor_view.cpp:742
msgid "Execute Macro"
msgstr "Иҷро кардани макрос"

#: qeditor_view.cpp:745
msgid "Execute macro"
msgstr "Иҷро кардани макрос"

#: qeditor_view.cpp:746
msgid "<b>Execute macro</b><p>Executes previously recorded macro."
msgstr ""
"<b>Иҷро кардани макрос</b>"
"<p>Иҷро кардани навиштаҳои пештараи "
"макрос."

#: qeditor_view.cpp:748
msgid "&Configure Editor..."
msgstr "&Мизроб кардани муҳаррир..."

#: qeditor_view.cpp:751
msgid "Configure editor"
msgstr "Мизроб кардани муҳаррир"

#: qeditor_view.cpp:752
msgid "<b>Configure editor</b><p>Opens an editor configuration dialog."
msgstr ""
"<b>Мизроб кардани муҳаррир.</b>"
"<p>Кушодани диалог бо мизробҳояш."

