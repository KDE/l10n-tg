#: addremovedlg.cpp:31
msgid "CVS Add"
msgstr "Афзоиш дар CVS"

#: addremovedlg.cpp:32
msgid "CVS Add Binary"
msgstr "Афзудани файли бинарӣ дар CVS"

#: addremovedlg.cpp:33
msgid "CVS Remove"
msgstr "Ҳузф кардан аз CVS"

#: addremovedlg.cpp:40
msgid "Add the following files to the repository:"
msgstr ""
"Афзудани файлҳои интихобшуда дар "
"репозиторий:"

#: addremovedlg.cpp:41
msgid "Add the following binary files to the repository:"
msgstr ""
"Афзудани файлҳои бинарии интихобшуда дар "
"репозиторий:"

#: addremovedlg.cpp:42
msgid "Remove the following files from the repository:"
msgstr ""
"Ҳузфи файлҳои интихобшуда дар "
"репозиторий:"

#: addremovedlg.cpp:62
#, fuzzy
msgid "This will also remove the files from your local working copy."
msgstr ""
"Ин ҳамеша файлҳо аз нусхаҳои кори локалӣ "
"низ ҳузф карда мешаванд!"

#: addrepositorydlg.cpp:31
msgid "Add Repository"
msgstr "Афзоиши репозиторий"

#: addrepositorydlg.cpp:39 checkoutdlg.cpp:66
msgid "&Repository:"
msgstr "&Репозиторий:"

#: addrepositorydlg.cpp:52
msgid "Use remote &shell (only for :ext: repositories):"
msgstr ""
"&Истифодаи пардаи дастурӣ (танҳо барои "
"репозиторияҳо :ext:):"

#: addrepositorydlg.cpp:59
msgid "Invoke this program on the server side:"
msgstr "Оғоз намудани ин барнома ба тарафи сервер:"

#: addrepositorydlg.cpp:68
msgid "Use different &compression level:"
msgstr "Дараҷаи &тазъиқ:"

#: addrepositorydlg.cpp:74
msgid "Download cvsignore file from server"
msgstr "Пурборкунии файли cvsignore аз рӯи сервер"

#: addrepositorydlg.cpp:166
msgid "Repository Settings"
msgstr "Танзимоти репозитория"

#: annotatectl.cpp:76
#, c-format
msgid "CVS Annotate: %1"
msgstr "Шарҳи мухтасар дар CVS: %1"

#: annotatectl.cpp:87
msgid "CVS Annotate"
msgstr "Шарҳи мухтасар дар CVS"

#: cervisiapart.cpp:144
#, fuzzy
msgid ""
"This KPart is non-functional, because the cvs DCOP service could not be "
"started."
msgstr ""
"KPart амал намекунад, оғоз намудани "
"хизматгузорӣ DCOP  cvs имконпазир нест!"

#: cervisiapart.cpp:155
msgid ""
"F - All files are hidden, the tree shows only folders\n"
"N - All up-to-date files are hidden\n"
"R - All removed files are hidden"
msgstr ""
"F - Тамоми файлҳо пинҳон ҳастанд, танҳо "
"каталогҳо тасвир ёфтаанд\n"
"N - Тамоми файлҳои ба рӯз расонидашуда "
"пинҳонанд\n"
"R - Тамоми файлҳои ҳузф кардашуда "
"пинҳонанд"

#: cervisiapart.cpp:192
msgid "Remote CVS working folders are not supported."
msgstr ""
"Каталогҳои ғайри маҳдуди CVS дастгирӣ "
"карда намешаванд."

#: cervisiapart.cpp:201
msgid "You cannot change to a different folder while there is a running cvs job."
msgstr ""
"Шумо ба дигар каталог гузашта "
"наметавонед то ҳолате, ки дастурӣ СVS иҷро "
"шудаистодааст."

#: cervisiapart.cpp:220
msgid "O&pen Sandbox..."
msgstr "&Боз кардани регдон..."

#: cervisiapart.cpp:223
msgid "Opens a CVS working folder in the main window"
msgstr ""
"Боз кардани каталоги кории CVS дар тирезаи "
"асосӣ"

#: cervisiapart.cpp:227
msgid "Recent Sandboxes"
msgstr "Регдонҳои ҷорӣ"

#: cervisiapart.cpp:231
msgid "&Insert ChangeLog Entry..."
msgstr "&Гузоштани сабт дар ChangeLog..."

#: cervisiapart.cpp:234
msgid "Inserts a new intro into the file ChangeLog in the toplevel folder"
msgstr ""
"Иловаи асбти нав дар файли ChangeLog дар "
"каталоги ибтидои"

#: cervisiapart.cpp:241
msgid "Updates (cvs update) the selected files and folders"
msgstr ""
"Аз навсозии (cvs update) файлҳо ва каталогҳои "
"интихобшуда"

#: cervisiapart.cpp:245
msgid "&Status"
msgstr "&Ҳолат"

#: cervisiapart.cpp:248
msgid "Updates the status (cvs -n update) of the selected files and folders"
msgstr ""
"Аз навсозии ҳолати (cvs -n update) файлҳо ва "
"каталогҳои интихобшуда"

#: cervisiapart.cpp:255
msgid "Opens the marked file for editing"
msgstr ""
"Боз намудани файҳои интихобшуда барои "
"муҳаррирӣят"

#: cervisiapart.cpp:259
msgid "Reso&lve..."
msgstr "&Ҳал намудани низоъ..."

#: cervisiapart.cpp:262
msgid "Opens the resolve dialog with the selected file"
msgstr ""
"Боз намудани мусоҳибаи ҳалкунии низоъ "
"барои файли интихобшуда"

#: cervisiapart.cpp:266
msgid "&Commit..."
msgstr "&Cупурдан..."

#: cervisiapart.cpp:269
msgid "Commits the selected files"
msgstr "Супурдани файлҳои интихобшуда"

#: cervisiapart.cpp:273
msgid "&Add to Repository..."
msgstr "&Aфзоиш дар репозиторий..."

#: cervisiapart.cpp:276
msgid "Adds (cvs add) the selected files to the repository"
msgstr ""
"Aфзудани (cvs add) файлҳои интихобшуда дар "
"репозтория"

#: cervisiapart.cpp:280
msgid "Add &Binary..."
msgstr "Aфзудан ҳамчун &бинарӣ..."

#: cervisiapart.cpp:283
msgid "Adds (cvs -kb add) the selected files as binaries to the repository"
msgstr ""
"Aфзудани (cvs -kb add) файлҳои интихобшуда "
"ҳамчун бинарӣ дар репозтория"

#: cervisiapart.cpp:287
msgid "&Remove From Repository..."
msgstr "&Ҳузф намудан аз репозитория..."

#: cervisiapart.cpp:290
msgid "Removes (cvs remove) the selected files from the repository"
msgstr ""
"Ҳузф намудани (cvs remove) файлҳои аз "
"репозитория интихобшуда"

#: cervisiapart.cpp:294
msgid "Rever&t"
msgstr "&Баргардонидан"

#: cervisiapart.cpp:297
msgid "Reverts (cvs update -C) the selected files (only cvs 1.11)"
msgstr ""
"Баргардонидани (cvs update -C) файлҳои "
"интихобшуда (танҳо дар cvs 1.11)"

#: cervisiapart.cpp:302
msgid "&Properties"
msgstr ""

#: cervisiapart.cpp:313
msgid "Stops any running sub-processes"
msgstr ""
"Боз доштани тамоми зерамалҳои "
"иҷрошудаистода"

#: cervisiapart.cpp:318
msgid "Browse &Log..."
msgstr "Азназаргузаронии &маҷала..."

#: cervisiapart.cpp:321
msgid "Shows the revision tree of the selected file"
msgstr ""
"Намоиши дарахти тафтиши файли "
"интихобшуда"

#: cervisiapart.cpp:326
msgid "Browse Multi-File Log..."
msgstr "Азназаргузаронии маҷалаи якчанд файлҳо..."

#: cervisiapart.cpp:330
msgid "&Annotate..."
msgstr "&Шарҳи мухтасар..."

#: cervisiapart.cpp:333
msgid "Shows a blame-annotated view of the selected file"
msgstr ""
"Намоиши шарҳи мухтасари файли "
"интихобшуда"

#: cervisiapart.cpp:337
msgid "&Difference to Repository (BASE)..."
msgstr "&Фарқият дар репозиторияи (BASE)..."

#: cervisiapart.cpp:340
msgid ""
"Shows the differences of the selected file to the checked out version (tag "
"BASE)"
msgstr ""
"Намоиши фарқияти файли интихобшуда ва "
"равияти қалбии он (нишонаи BASE)"

#: cervisiapart.cpp:344
msgid "Difference to Repository (HEAD)..."
msgstr "Фарқият дар репозиторияи (HEAD)..."

#: cervisiapart.cpp:347
msgid ""
"Shows the differences of the selected file to the newest version in the "
"repository (tag HEAD)"
msgstr ""
"Намоиши фарқияти файли интихобшуда ва "
"равияти баъдинаи он (нишонаи HEAD)"

#: cervisiapart.cpp:351
msgid "Last &Change..."
msgstr "Таъғироти &охирин..."

#: cervisiapart.cpp:354
msgid "Shows the differences between the last two revisions of the selected file"
msgstr ""
"Намоиши фарқияти байни ду тафтиши "
"охирини файлҳои интихобшуда"

#: cervisiapart.cpp:358
msgid "&History..."
msgstr "&Таърих..."

#: cervisiapart.cpp:361
msgid "Shows the CVS history as reported by the server"
msgstr "Намоиши таърихи CVS, бо сервер пешниҳодшуда"

#: cervisiapart.cpp:365
msgid "&Unfold File Tree"
msgstr "&Кушодани дарахти файлҳо"

#: cervisiapart.cpp:369
msgid "Opens all branches of the file tree"
msgstr "Кушодани тамоми шохаҳо дар рӯйхати файлҳо"

#: cervisiapart.cpp:373
msgid "&Fold File Tree"
msgstr "&Печондани дарахти файлҳо"

#: cervisiapart.cpp:376
msgid "Closes all branches of the file tree"
msgstr "Пӯшидани тамоми шохаҳо дар рӯйхати файлҳо"

#: cervisiapart.cpp:383
msgid "&Tag/Branch..."
msgstr "&Нишона/шоха..."

#: cervisiapart.cpp:386
msgid "Creates a tag or branch for the selected files"
msgstr ""
"Эҷоди нишона ё инки шоха барои файлҳои  "
"интихобшуда"

#: cervisiapart.cpp:390
msgid "&Delete Tag..."
msgstr "&Ҳузф намудани нишона..."

#: cervisiapart.cpp:393
msgid "Deletes a tag from the selected files"
msgstr ""
"Ҳузф намудани нишона аз файлҳои "
"интихобшуда"

#: cervisiapart.cpp:397
msgid "&Update to Tag/Date..."
msgstr "&Бозсозӣ то нишони/санаи..."

#: cervisiapart.cpp:400
msgid "Updates the selected files to a given tag, branch or date"
msgstr ""
"Аз нав созии файлҳои интихобшуда то "
"нишонаи ишорашуда шоха ё сана"

#: cervisiapart.cpp:404
msgid "Update to &HEAD"
msgstr "Бозсозӣ то &HEAD"

#: cervisiapart.cpp:407
msgid "Updates the selected files to the HEAD revision"
msgstr ""
"Бозсозии файлҳои интихобшуда то тафтиши "
"HEAD"

#: cervisiapart.cpp:411
msgid "&Merge..."
msgstr "&Mуттаҳид кардан..."

#: cervisiapart.cpp:414
msgid "Merges a branch or a set of modifications into the selected files"
msgstr ""
"Mуттаҳид кардани шоха ё маҷмӯи "
"таъғиротҳоифайлҳои интихобшуда"

#: cervisiapart.cpp:418
msgid "&Add Watch..."
msgstr "&Aфзудани мушоҳидот..."

#: cervisiapart.cpp:421
msgid "Adds a watch for the selected files"
msgstr ""
"Танзими мушоҳидот барои файлҳои "
"интихобшуда"

#: cervisiapart.cpp:425
msgid "&Remove Watch..."
msgstr "&Ҳузфи мушоҳидот..."

#: cervisiapart.cpp:428
msgid "Removes a watch from the selected files"
msgstr "Ҳузфи мушоҳидот аз файлҳои интихобшуда"

#: cervisiapart.cpp:432
msgid "Show &Watchers"
msgstr "Намоиши &мушоҳидот"

#: cervisiapart.cpp:435
msgid "Shows the watchers of the selected files"
msgstr ""
"Намоиши мушоҳидон барои файлҳои "
"интихобшуда"

#: cervisiapart.cpp:439
msgid "Ed&it Files"
msgstr "&Муҳарририяти файлҳо"

#: cervisiapart.cpp:442
msgid "Edits (cvs edit) the selected files"
msgstr "Муҳарририяти (cvs edit) файлҳои интихобшуда"

#: cervisiapart.cpp:446
msgid "U&nedit Files"
msgstr "Хотима додани &муҳарририяти файлҳо"

#: cervisiapart.cpp:449
msgid "Unedits (cvs unedit) the selected files"
msgstr ""
"Хотима додани муҳарририяти (cvs unedit) "
"файлҳои интихобшуда"

#: cervisiapart.cpp:453
msgid "Show &Editors"
msgstr "Намоиши &муҳаррир"

#: cervisiapart.cpp:456
msgid "Shows the editors of the selected files"
msgstr "Намоиши муҳаррирҳои файлҳои интихобшуда"

#: cervisiapart.cpp:460
msgid "&Lock Files"
msgstr "&Бастани файлҳо"

#: cervisiapart.cpp:463
msgid "Locks the selected files, so that others cannot modify them"
msgstr ""
"Бастани файлҳои интихобшуда, дигарон "
"онҳро таъғир дода наметавонанд"

#: cervisiapart.cpp:467
msgid "Unl&ock Files"
msgstr "&Боз кардани файлҳо"

#: cervisiapart.cpp:470
msgid "Unlocks the selected files"
msgstr "Боз кардани файлҳои интихобшуда"

#: cervisiapart.cpp:474
msgid "Create &Patch Against Repository..."
msgstr "&Эҷод намудани дарбеҳ барои репозитория..."

#: cervisiapart.cpp:477
msgid "Creates a patch from the modifications in your sandbox"
msgstr ""
"Эҷод намудани дарбеҳ аз таъғироти "
"регдони шумо"

#: cervisiapart.cpp:484
msgid "&Create..."
msgstr "&Эҷод намудан..."

#: cervisiapart.cpp:488
msgid "&Checkout..."
msgstr "&Озмоиш/пурборкунӣ..."

#: cervisiapart.cpp:491
msgid "Allows you to checkout a module from a repository"
msgstr ""
"Озмоидан ва пурборкунии модулро аз "
"репозитория рухсат медиҳад"

#: cervisiapart.cpp:495
msgid "&Import..."
msgstr "&Воридот..."

#: cervisiapart.cpp:498
msgid "Allows you to import a module into a repository"
msgstr "Иҷозати содироти модул дар репозитория"

#: cervisiapart.cpp:502
msgid "&Repositories..."
msgstr "&Репозиторияҳо..."

#: cervisiapart.cpp:505
msgid "Configures a list of repositories you regularly use"
msgstr ""
"Танзимоти рӯйхати репозиторияҳое, ки "
"шумо бештар истифода мебаред"

#: cervisiapart.cpp:512
msgid "Hide All &Files"
msgstr "Пӯшонидани &тамоми файлҳо"

#: cervisiapart.cpp:515
msgid "Show All &Files"
msgstr "Намоиши &тамоми файлҳо"

#: cervisiapart.cpp:516
msgid "Determines whether only folders are shown"
msgstr "Фақат намоиши каталогҳоро рухсат медиҳад"

#: cervisiapart.cpp:520
msgid "Hide Unmodified Files"
msgstr "Пӯшонидани файлҳои ғайри таъғирёфта"

#: cervisiapart.cpp:523
msgid "Show Unmodified Files"
msgstr "Намоиши файлҳои ғайри таъғирёфта"

#: cervisiapart.cpp:524
msgid "Determines whether files with status up-to-date or unknown are hidden"
msgstr ""
"Пӯшонидани файлҳои, ки бозсозии (\"ОК\") ё "
"файлҳои номаълумро талаб намекунанд"

#: cervisiapart.cpp:529
msgid "Hide Removed Files"
msgstr "Пӯшонидани файлҳои ҳузфшуда"

#: cervisiapart.cpp:532
msgid "Show Removed Files"
msgstr "Намоиши файлҳои ҳузфшуда"

#: cervisiapart.cpp:533
msgid "Determines whether removed files are hidden"
msgstr ""
"Пӯшонидани файлҳои аз CVS ҳузфшударо "
"рухсат медиҳад"

#: cervisiapart.cpp:537
msgid "Hide Non-CVS Files"
msgstr "Пӯшонидани файлҳои аз CVS набуда"

#: cervisiapart.cpp:540
msgid "Show Non-CVS Files"
msgstr "Намоиши файлҳои аз CVS набуда"

#: cervisiapart.cpp:541
msgid "Determines whether files not in CVS are hidden"
msgstr ""
"Пӯшонидани файлҳои ғайри CVS-ро рухсат "
"медиҳад"

#: cervisiapart.cpp:545
msgid "Hide Empty Folders"
msgstr "Пӯшонидани каталогҳои холӣ"

#: cervisiapart.cpp:548
msgid "Show Empty Folders"
msgstr "Намоиши каталогҳои холӣ"

#: cervisiapart.cpp:549
msgid "Determines whether folders without visible entries are hidden"
msgstr ""
"Пӯшонидани каталогҳое, ки дорои ҷузъҳои "
"айён нестанд рухсат медиҳанд"

#: cervisiapart.cpp:553
msgid "Create &Folders on Update"
msgstr "Эҷоди каталогҳо мавриди &бозсозӣ"

#: cervisiapart.cpp:556
msgid "Determines whether updates create folders"
msgstr ""
"Мавриди бозсозӣ эҷоди каталогҳоро рухсат "
"медиҳад "

#: cervisiapart.cpp:560
msgid "&Prune Empty Folders on Update"
msgstr "&Ҳузфи каталогҳои холӣ ҳангоми бозсозӣ"

#: cervisiapart.cpp:563
msgid "Determines whether updates remove empty folders"
msgstr ""
"Ҳангоми бозсозӣ ҳузфи каталогҳои холиро "
"рухсат медиҳад"

#: cervisiapart.cpp:567
msgid "&Update Recursively"
msgstr "&Бозсозии рекурсивӣ"

#: cervisiapart.cpp:570
msgid "Determines whether updates are recursive"
msgstr ""
"Иҷоза медиҳад ба тарзи рекурсивӣ бозсозӣ "
"кунед"

#: cervisiapart.cpp:574
msgid "C&ommit && Remove Recursively"
msgstr "&Ба тарзи рекурсивӣ додан ва ҳузф намудан"

#: cervisiapart.cpp:577
msgid "Determines whether commits and removes are recursive"
msgstr ""
"Ба тарзи рекурсивӣ додан ва ҳузф "
"намуданро рухсат медиҳад"

#: cervisiapart.cpp:581
msgid "Do cvs &edit Automatically When Necessary"
msgstr "Ба тарзи худкор иҷро нмудани cvs &edit "

#: cervisiapart.cpp:584
msgid "Determines whether automatic cvs editing is active"
msgstr ""
"Иҷоза медиҳад, ки таҳрири худкори cvs-ро "
"иҷро кунад"

#: cervisiapart.cpp:588
msgid "Configure Cervisia..."
msgstr "Танзимоти Cervisia..."

#: cervisiapart.cpp:591
msgid "Allows you to configure the Cervisia KPart"
msgstr "Танзимоти параметрҳои қисмҳои Cervisia"

#: cervisiapart.cpp:601
msgid "CVS &Manual"
msgstr "&Дастур аз рӯи CVS "

#: cervisiapart.cpp:604
msgid "Opens the help browser with the CVS documentation"
msgstr "Намоиши санадот аз рӯи CVS"

#: cervisiapart.cpp:639
msgid "Edit With"
msgstr "Боз кардан дар"

