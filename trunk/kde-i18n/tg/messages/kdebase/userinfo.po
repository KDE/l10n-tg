msgid "Settings"
msgstr "Гузоришҳо"

#: userinfo.cpp:107
msgid "Change Real &Name..."
msgstr "Ивази &Номи Ҳақиқӣ..."

#: userinfo.cpp:109
msgid "Change Pass&word..."
msgstr "Ивази &Гузарвожа..."

#: userinfo.cpp:113
msgid ""
"Click on this button to change your real name. Your password will be "
"required."
msgstr ""
"Барои ивази номи ҳақиқии худ ба ин тугма ангушт занед. Аз шумо гузарвожа "
"пурсида мешавад."

#: userinfo.cpp:114
msgid "Click on this button to change your password."
msgstr "Барои ивази гузарвожаи худ ба ин тугма ангушт занед."

#: userinfo.cpp:137 userinfo_chface.cpp:110
msgid "There was an error loading the image."
msgstr "Хатогӣ ҳангоми боркунии симо рух додааст."

#: userinfo.cpp:150 userinfo.cpp:209
msgid "Your administrator has disallowed changing your face."
msgstr "Идоракунандаи шумо ивази симои шуморо иҷзат надод."

#: userinfo.cpp:196
msgid ""
"%1 does not appear to be an image file.\n"
"Please use files with these extensions:\n"
"%2"
msgstr ""
"%1 эҳтимолан файли симо нест.\n"
"Марҳамат карда файлҳоро бо паҳншавии зерин истифода баред:\n"
"%2"

#: userinfo.cpp:245
msgid "Your password was wrong."
msgstr "Гузарвожаи шумо хато буд."

#: userinfo.cpp:247
#, c-format
msgid "An error occurred: %1"
msgstr "Хатогӣ ба амал омад: %1"

#: userinfo.cpp:249
msgid "An unknown error occurred."
msgstr "Хатогии номаълум ба амал омад."

#: userinfo.cpp:278 userinfo_chface.cpp:127 userinfo_chface.cpp:166
#, c-format
msgid ""
"There was an error saving the image:\n"
"%1"
msgstr ""
"Хатогии захиракунии симо ба амал омад:\n"
