#: rc.cpp:37
#, no-c-format
msgid ""
"To add new readers you have to modify /etc/readers.conf file and re-start "
"pcscd"
msgstr ""
"Барои илова кардани сохтори овозхон шумо "
"бояд  /etc/readers.conf filepcscd таъғир дода аз сар "
"компютерро кушта боз шуруъ кунед"

