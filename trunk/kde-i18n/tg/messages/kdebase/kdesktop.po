msgstr "<nobr><b>Экран қулф аст</b><br>"

#: lock/lockdlg.cc:76
msgid "<nobr><b>The screen is locked by %1</b><br>"
msgstr "<nobr><b>Экран қулф аст бо %1</b><br>"

#: lock/lockdlg.cc:86
msgid "&Start New Session"
msgstr "&Сессияи навро иҷро кунед"

