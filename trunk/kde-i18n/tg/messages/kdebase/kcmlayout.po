#: kcmlayout.cpp:802
msgid "Alt and Meta on the Alt keys (default)."
msgstr "Alt ва Meta дар рӯи кнопкаҳои Alt (пешфарз)."

#: kcmlayout.cpp:803
msgid "Meta is mapped to the Win-keys."
msgstr ""
"Meta бо кнопкаҳои Win-и барномаи нишондод "
"мешавад."

#: kcmlayout.cpp:804
msgid "Meta is mapped to the left Win-key."
msgstr ""
"Meta бо кнопкаи чапи Win-и барномаи нишондод "
"мешавад."

#: kcmlayout.cpp:805
msgid "Super is mapped to the Win-keys (default)."
msgstr ""
"Super бо кнопкаҳои чапи Win-и барномаи "
"нишондод мешавад (пешфарз)."

#: kcmlayout.cpp:806
msgid "Hyper is mapped to the Win-keys."
msgstr ""
"Hyper бо кнопкаҳои Win-и барномаи нишондод "
"мешавад."

