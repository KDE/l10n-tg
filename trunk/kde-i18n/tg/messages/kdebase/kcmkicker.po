#, no-c-format
msgid "Na&me (Description)"
msgstr "&Ном (Тавсифот)"

#: rc.cpp:272
#, no-c-format
msgid ""
"When this option is selected, items in the K Menu will appear with the "
"application's name and a brief description in brackets next to the icon."
msgstr ""
"Агар ин хосият интихоб гардад, пунктҳои K Меню бо номи замимаҳо "
"ва тавсифи кӯтоҳ дар қавс дар назди тасвир пайдо мешаванд."

#: rc.cpp:274
#, no-c-format
msgid "Des&cription (Name)"
msgstr "&Тавсифот (Ном)"

