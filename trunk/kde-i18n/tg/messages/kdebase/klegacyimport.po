#: legacyimport.cpp:23
msgid ""
"<QT><b>Legacy Theme Importer</b><P>KDE now supports utilizing older themes "
"from other platforms in your new KDE desktop. The most common type of legacy "
"theme is for the GTK toolkit, which is imported to KDE's Control Center with "
"this utility.<P>In order to do this you must specify at least one item: the "
"folder where the pixmaps for the theme is located. You may also have to "
"specify the theme's gtkrc file if it's not in the same folder as the "
"pixmaps. Both are usually in the folder \"gtk\" inside the theme's folder.</"
"QT>"
msgstr ""
"<QT><b>Воридкунандаи Мавзӯъҳои Кӯҳна</b><P>KDE ҳоло вориди мавзӯъҳои кӯҳнаро "
"аз дигар истгоҳҳо дар мизи кории навъи KDE-и шумо пуштибонӣ мекунад. Аз ҳама "
"намуди муштараки мавзӯъҳои кӯҳна - ин мавзӯъҳое мебошанд, ки ба воситаи ин "
"барномаи пуштибон ба Маркази Идораи KDE ворид карда мешаванд.<P>Барои иҷрои "
"он шумо бояд ақалан як пунктро таъин кунед: феҳристе, ки дар он тасвири "
"мавзӯъҳо ҷойгир шудаанд. Шумо инчунин бояд ҷойгиршавии файли gtkrc таъин "
"кунед, агар ки он дар ҳамон феҳрист ба монанди тасвири мавзӯъҳо набошад. "
"Одатан ҳарду дар феҳристи \"gtk\" дар дохили феҳристи мавзӯъҳо ҷойгиранд.</"
"QT>"

#: legacyimport.cpp:33
msgid "Step 1: Specify theme's pixmap folder:"
msgstr "Қадами 1: Феҳристро бо тасвири мавзӯъҳо таъин кунед:"

#: legacyimport.cpp:51
msgid "Specify pixmap Folder"
msgstr "Феҳристро бо тасвирҳо Таъин кунед"

#: legacyimport.cpp:55
msgid ""
"<QT><b>Legacy Theme Importer</b><P>A gtkrc file was not found in the "
"specified folder. If it exists somewhere other than where the pixmaps are "
"located enter it here.</QT>"
msgstr ""
"<QT><b>Воридкунандаи Мавзӯъҳои Кӯҳна</b><P>Файли gtkrc дар феҳристи "
"таъиншуда пайдо нагардид. Агар он дар ягон ҷои дигар бошад, онро дар ин ҷо "
"гузориш намоед.</QT>"

#: legacyimport.cpp:59
msgid "Step 2: Specify theme's gtkrc:"
msgstr "Қадами 2: gtkrc-ро барои мавзӯъ таъин кунед:"

#: legacyimport.cpp:76
msgid "Specify gtkrc Folder"
msgstr "Феҳристи gtkrc-ро Таъин кунед"

#: legacyimport.cpp:85
msgid "Legacy Import"
msgstr "Ворид Кардани Кӯҳнаҳо"

#: legacyimport.cpp:92
