#: kcmxinerama.cpp:71
#, c-format
msgid "Display %1"
msgstr "Намоиш %1"

#: kcmxinerama.cpp:87
msgid "Display Containing the Pointer"
msgstr "Намоиши бо ишоракунанда"

#: kcmxinerama.cpp:100
msgid ""
"<qt>"
"<p>This module is only for configuring systems with a single desktop spread "
"across multiple monitors. You do not appear to have this "
"configuration.</p></qt>"
msgstr ""
"<qt>"
"<p>Ин воҳид танҳо барои батанзимдарории системаҳо бо мизҳои кории "
"ягона, ки бо воситаи бисёр экранҳо ҷустуҷӯ шудааст. Он дар танзимдарории "
"шумо пайдо намешавад.</p></qt>"

#: kcmxinerama.cpp:177
msgid "Your settings will only affect newly started applications."
msgstr "Гузоришҳои шумо танҳо ба замимаҳои нав оғоз ёфта таъсир мебахшанд."

#: kcmxinerama.cpp:177
msgid "KDE Multiple Monitors"
msgstr "KDE Экранҳои Бисёр"

#: kcmxinerama.cpp:250
msgid ""
"<h1>Multiple Monitors</h1> This module allows you to configure KDE support "
"for multiple monitors."
msgstr ""
"<h1>Экранҳои Бисёр</h1> Ин воҳид ба шумо имконияти батанзимдарории "
"пуштибонии бисёр экранҳоро барои KDE медиҳад."

#: rc.cpp:2
#, no-c-format
msgid "X Coordinate"
msgstr "Тири X"

#: rc.cpp:4
#, no-c-format
msgid "Y Coordinate"
msgstr "Тири Y"

#: rc.cpp:10
#, no-c-format
msgid "Multiple Monitor Support"
msgstr "Пуштибонии Бисёр Экранҳо"

#: rc.cpp:12
#, no-c-format
msgid "Enable multiple monitor virtual desktop support"
msgstr "Даргиронидани пуштибонии мизҳои кории маҷозӣ дар бисёр экранҳо"

#: rc.cpp:14
#, no-c-format
msgid "Enable multiple monitor window resistance support"
msgstr "Даргиронидани пуштибонии муқовимати тирезавӣ дар бисёр экранҳо"

#: rc.cpp:16
#, no-c-format
msgid "Enable multiple monitor window placement support"
msgstr "Даргиронидани пуштибонии ҷойгирии тирезаҳо дар бисёр экранҳо"

#: rc.cpp:18
#, no-c-format
msgid "Enable multiple monitor window maximize support"
msgstr "Даргиронидани пуштибонии кушодани тирезаҳо дар бисёр экранҳо"

#: rc.cpp:20
#, no-c-format
msgid "Enable multiple monitor window fullscreen support"
msgstr "Даргиронидани пуштибонии экрани пурраи тирезаҳо дар бисёр экранҳо"

#: rc.cpp:22
#, no-c-format
msgid "&Identify All Displays"
msgstr "&Ҳама намоишгоҳҳоро муайян кунед"

#: rc.cpp:24
#, no-c-format
msgid "Show unmanaged windows on:"
msgstr "Нишон додани тирезаҳои ғайриидоравӣ дар:"

#: rc.cpp:26
#, no-c-format
msgid "Show KDE splash screen on:"
msgstr "Экрани қатраҳои KDE-ро нишон диҳед дар:"

