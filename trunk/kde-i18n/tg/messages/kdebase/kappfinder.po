"Summary: found %n applications"
msgstr ""
"n: Хулоса:  %n барномаҳо пайдо шуд\n"
"Хулоса:  %n барномаҳо пайдо шуд"

#: toplevel.cpp:287
#, fuzzy, c-format
msgid ""
"_n: %n application was added to the KDE menu system.\n"
