#: main.cpp:27
msgid "KDE's application finder"
msgstr " Барномаёби KDE"

#: main.cpp:30
msgid "Install .desktop files into directory <dir>"
msgstr "Насби файлҳои desktop дар <dir> "

#: main.cpp:36 toplevel.cpp:49
msgid "KAppfinder"
msgstr "KAppfinder"

#: toplevel.cpp:52
msgid ""
"The application finder looks for legacy applications on your system and adds "
"them to the KDE menu system. Click 'Scan' to begin, select the desired "
"applications and then click 'Apply'."
msgstr ""
"Барномаҳои насбшударо ёбед ва онҳоро ба "
"феҳрасти KDE илова кунед,  барои шурӯи "
"ҷустуҷӯ   тугмаро зер карда  барномаи "
"даркориро интихоб кунед     "

#: toplevel.cpp:62
msgid "Application"
msgstr "Барнома"

#: toplevel.cpp:63
msgid "Description"
msgstr "Тасвир"

#: toplevel.cpp:64
msgid "Command"
msgstr "Фармон"

#: toplevel.cpp:75
msgid "Summary:"
msgstr "Ҳосил"

#: toplevel.cpp:84
msgid "Unselect All"
msgstr "Барҳамдодани  интихоби ҳамаш"

#: toplevel.cpp:90
msgid "Scan"
msgstr "Мушоҳида"

