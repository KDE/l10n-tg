"\n"

#: kgverify.cpp:331
msgid "You are required to change your password immediately (password aged)."
msgstr ""
"Шумо талаби ивази фаврии гузарвожаи "
"худро намудед (гузарвожаи кӯҳна)."

#: kgverify.cpp:332
msgid "You are required to change your password immediately (root enforced)."
msgstr ""
"Шумо талаби ивази фаврии гузарвожаи "
"худро намудед (иҷроиши решавӣ)."

#: kgverify.cpp:333
msgid "You are not allowed to login at the moment."
msgstr ""
"Дар айни замон ба шумо иҷозати воридшавӣ "
"дода намешавад."

#: kgverify.cpp:334
msgid "Home folder not available."
msgstr "Феҳристи хонагӣ имконнопазир аст."

#: kgverify.cpp:335
msgid ""
"Logins are not allowed at the moment.\n"
"Try again later."
msgstr ""
"Дар аяни замон иҷозати воридшавӣ дода "
"намешавад.\n"
"Дертар бори дигар кӯшиш кунед."

#: kgverify.cpp:336
msgid "Your login shell is not listed in /etc/shells."
msgstr ""
"Муқоваи shell-и шумо номнавис дар /etc/shells "
"нашудааст."

#: kgverify.cpp:337
msgid "Root logins are not allowed."
msgstr ""
"Воридшавии монанди Root иҷозат дода "
"намешавад."

#: kgverify.cpp:338
#, fuzzy
msgid "Your account has expired; please contact your system administrator."
msgstr ""
"Мӯҳлати ҳисоби шумо ба итмом мерасад "
"(хатогӣ дар ивази гузарвожа)."

#: kgverify.cpp:348
msgid ""
"A critical error occurred.\n"
"Please look at KDM's logfile(s) for more information\n"
"or contact your system administrator."
msgstr ""
"Хатогии бузурге рух додааст.\n"
"Бо номнависи файл(ҳо)и KDMбарои гирифтани "
"маълумоти бисёртар нигаред\n"
"ё идоракунандаи системавӣ муроҷиат кунед."

