#: cddbconfigwidget.cpp:95 rc.cpp:30
#, no-c-format
msgid "HTTP"
msgstr "HTTP"

#: cddbconfigwidget.cpp:97 rc.cpp:28
#, no-c-format
msgid "CDDB"
msgstr "CDDB"

#: kcmcddb.cpp:118
msgid ""
"freedb submissions via SMTP have been disabled\n"
"because the email details you have entered are\n"
"incomplete. Please review your email settings\n"
"and try again."
msgstr ""
"фиристодани додаҳо оиди диски фишурда ба "
"воситаи SMTP хомӯш\n"
"шудааст аз сабаби он, ки ҷузъҳои пости "
"электроние, ки\n"
"шумо ворид намудаед, нопурраанд. Марҳамат "
"карда гузоришҳои пости\n"
"электронии худро аз назар гузаронед ва "
"бори дигар кӯшиш кунед."

#: kcmcddb.cpp:121
msgid "Freedb Submissions Disabled"
msgstr ""
"Фиристодани Додаҳо оиди Диски Фишурда "
"Хомӯш шудааст"

#: kcmcddb.cpp:203
msgid "CDDB is used to get information like artist, title and song-names in CD's"
msgstr ""
"CDDB барои гирифтани ахборот ба монанди "
"сароянда, унвон ва номҳои сурудҳо "
"истифода мешавад"

#: rc.cpp:2
#, no-c-format
msgid "CDDB Settings"
msgstr "Гузоришҳои CDDB"

#: rc.cpp:4
#, no-c-format
msgid "&Lookup"
msgstr "&Азназаргузаронӣ"

#: rc.cpp:6
#, no-c-format
msgid "Cache Folders"
msgstr "Феҳристҳои Ниҳонӣ"

#: rc.cpp:8
#, no-c-format
msgid "A&dd..."
msgstr "&Иловакунӣ..."

#: rc.cpp:10
#, no-c-format
msgid "R&emove"
msgstr "&Хориҷ кардан"

#: rc.cpp:12
#, no-c-format
msgid "&Up"
msgstr "&Ба боло"

#: rc.cpp:14
#, no-c-format
msgid "Do&wn"
msgstr "&Ба поён"

#: rc.cpp:16
#, no-c-format
msgid "CDDB Server"
msgstr "CDDB Хидматрасон"

#: rc.cpp:18
#, no-c-format
msgid "freedb.freedb.org"
msgstr "freedb.freedb.org"

#: rc.cpp:20
#, no-c-format
msgid "Name of CDDB server which will be used to look up CD information."
msgstr ""
"Номи CDDB хидматрасон, ки барои ҷустуҷӯи "
"ахборот оиди Диски Фишурда истифода "
"мешавад."

#: rc.cpp:22
#, no-c-format
msgid "Port to connect to on CDDB server."
msgstr ""
"Даргоҳ барои пайвастшавӣ бо CDDB "
"хидматрасон."

#: rc.cpp:24
#, no-c-format
msgid "&Port:"
msgstr "&Даргоҳ:"

#: rc.cpp:26
#, no-c-format
msgid "CDD&B server:"
msgstr "CDD&B хидматрасон:"

#: rc.cpp:32
#, no-c-format
msgid "Type of lookup which should be tried at the CDDB server."
msgstr "Навъи дастрасӣ ба CDDB хидматрасон."

#: rc.cpp:34
#, no-c-format
msgid "&Transport:"
msgstr "&Интиқол:"

#: rc.cpp:36
#, no-c-format
msgid "Mode"
msgstr "Усул"

#: rc.cpp:38
#, no-c-format
msgid "&Cache only"
msgstr "Танҳо &ниҳонӣ"

#: rc.cpp:40
#, no-c-format
msgid "Only check in the local cache for CD information."
msgstr ""
"Ахборот оиди Диски Фишурдаро танҳо дар "
"ниҳонии маҳаллӣ санҷед."

#: rc.cpp:42
#, no-c-format
msgid "Cache &and remote"
msgstr "Ниҳон &ва дурдаст"

#: rc.cpp:44
#, no-c-format
msgid ""
"Check for locally cached CD information before trying to look up at remote "
"CDDB server."
msgstr ""
"Пеш аз азназаргузаронии CDDB хидматрасон, "
"ахборотро оиди Диски Фишурда дар ниҳонии "
"маҳаллӣ, санҷед."

#: rc.cpp:46
#, no-c-format
msgid "&Remote only"
msgstr "Танҳо &дурдаст"

#: rc.cpp:48
#, no-c-format
msgid "Only try to look up at remote CDDB server."
msgstr ""
"Танҳо кӯшиши азназаргузарониро CDDB "
"хидматрасони дурдаст кунед."

#: rc.cpp:50
#, no-c-format
msgid "&Submit"
msgstr "&Фиристодан"

#: rc.cpp:52
#, no-c-format
msgid "Enable submission via SMTP"
msgstr ""
"Фиристодани ахборотро ба воситаи SMTP "
"даргиронед"

#: rc.cpp:54
#, no-c-format
msgid "SMTP Server"
msgstr "SMTP Хидматрасон"

#: rc.cpp:56
#, no-c-format
msgid "Use email addresses from control center"
msgstr ""
"Суроғаҳои пости электрониро аз маркази "
"идора истифода баред"

#: rc.cpp:58
#, no-c-format
msgid "Use the following email addresses"
msgstr ""
"Суроғаҳои пости электронии зеринро "
"истифода баред"

#: rc.cpp:60 rc.cpp:68
#, no-c-format
msgid "From:"
msgstr "Аз:"

#: rc.cpp:62 rc.cpp:70
#, no-c-format
msgid "Reply-To:"
msgstr "Ҷавоб гардонидан ба:"

#: rc.cpp:64 rc.cpp:72
#, no-c-format
msgid "Host:"
msgstr "Соҳиб:"

#: rc.cpp:66
#, no-c-format
msgid "Open the email address control panel"
msgstr ""
"Панели идоракунии суроғаҳои пости "
"электрониро кушоед"

#: rc.cpp:75
#, fuzzy, no-c-format
msgid "Username:"
msgstr "Номи корванд:"

#: rc.cpp:77
#, no-c-format
msgid "Port:"
msgstr "Даргоҳ:"

#: rc.cpp:79
#, no-c-format
msgid "Server needs authentication"
msgstr "Ба хидматрасон аслшиносӣ лозим аст"
