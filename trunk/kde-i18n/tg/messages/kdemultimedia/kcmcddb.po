#: cddbconfigwidget.cpp:95 rc.cpp:15
msgid "HTTP"
msgstr "HTTP"

#: cddbconfigwidget.cpp:97 rc.cpp:14
msgid "CDDB"
msgstr "CDDB"

#: kcmcddb.cpp:118
msgid ""
"freedb submissions via SMTP have been disabled\n"
"because the email details you have entered are\n"
"incomplete. Please review your email settings\n"
"and try again."
msgstr ""
"фиристодани додаҳо оиди диски фишурда ба воситаи SMTP хомӯш\n"
"шудааст аз сабаби он, ки ҷузъҳои пости электроние, ки\n"
"шумо ворид намудаед, нопурраанд. Марҳамат карда гузоришҳои пости\n"
"электронии худро аз назар гузаронед ва бори дигар кӯшиш кунед."

#: kcmcddb.cpp:121
msgid "Freedb Submissions Disabled"
msgstr "Фиристодани Додаҳо оиди Диски Фишурда Хомӯш шудааст"

#: kcmcddb.cpp:203
msgid "CDDB is used to get information like artist, title and song-names in CD's"
msgstr ""
"CDDB барои гирифтани ахборот ба монанди сароянда, "
"унвон ва номҳои сурудҳо истифода мешавад"

#: rc.cpp:1
msgid "CDDB Settings"
msgstr "Гузоришҳои CDDB"

#: rc.cpp:2
msgid "&Lookup"
msgstr "&Азназаргузаронӣ"

#: rc.cpp:3
msgid "Cache Folders"
msgstr "Феҳристҳои Ниҳонӣ"

#: rc.cpp:4
msgid "A&dd..."
msgstr "&Иловакунӣ..."

#: rc.cpp:5
msgid "R&emove"
msgstr "&Хориҷ кардан"

#: rc.cpp:6
msgid "&Up"
msgstr "&Ба боло"

#: rc.cpp:7
msgid "Do&wn"
msgstr "&Ба поён"

#: rc.cpp:8
msgid "CDDB Server"
msgstr "CDDB Хидматрасон"

#: rc.cpp:9
msgid "freedb.freedb.org"
msgstr "freedb.freedb.org"

#: rc.cpp:10
msgid "Name of CDDB server which will be used to look up CD information."
msgstr ""
"Номи CDDB хидматрасон, ки барои ҷустуҷӯи "
"ахборот оиди Диски Фишурда истифода мешавад."

#: rc.cpp:11
msgid "Port to connect to on CDDB server."
msgstr "Даргоҳ барои пайвастшавӣ бо CDDB хидматрасон."

#: rc.cpp:12
msgid "&Port:"
msgstr "&Даргоҳ:"

#: rc.cpp:13
msgid "CDD&B server:"
msgstr "CDD&B хидматрасон:"

#: rc.cpp:16
msgid "Type of lookup which should be tried at the CDDB server."
msgstr "Навъи дастрасӣ ба CDDB хидматрасон."

#: rc.cpp:17
msgid "&Transport:"
msgstr "&Интиқол:"

#: rc.cpp:18
msgid "Mode"
msgstr "Усул"

#: rc.cpp:19
msgid "&Cache only"
msgstr "Танҳо &ниҳонӣ"

#: rc.cpp:20
msgid "Only check in the local cache for CD information."
msgstr "Ахборот оиди Диски Фишурдаро танҳо дар ниҳонии маҳаллӣ санҷед."

#: rc.cpp:21
msgid "Cache &and remote"
msgstr "Ниҳон &ва дурдаст"

#: rc.cpp:22
msgid ""
"Check for locally cached CD information before trying to look up at remote "
"CDDB server."
msgstr ""
"Пеш аз азназаргузаронии CDDB хидматрасон, ахборотро оиди "
"Диски Фишурда дар ниҳонии маҳаллӣ, санҷед."

#: rc.cpp:23
msgid "&Remote only"
msgstr "Танҳо &дурдаст"

#: rc.cpp:24
msgid "Only try to look up at remote CDDB server."
msgstr "Танҳо кӯшиши азназаргузарониро CDDB хидматрасони дурдаст кунед."

#: rc.cpp:25
msgid "&Submit"
msgstr "&Фиристодан"

#: rc.cpp:26
msgid "Enable submission via SMTP"
msgstr "Фиристодани ахборотро ба воситаи SMTP даргиронед"

#: rc.cpp:27
msgid "SMTP Server"
msgstr "SMTP Хидматрасон"

#: rc.cpp:28
msgid "Use email addresses from control center"
msgstr "Суроғаҳои пости электрониро аз маркази идора истифода баред"

#: rc.cpp:29
msgid "Use the following email addresses"
msgstr "Суроғаҳои пости электронии зеринро истифода баред"

#: rc.cpp:30 rc.cpp:34
msgid "From:"
msgstr "Аз:"

#: rc.cpp:31 rc.cpp:35
msgid "Reply-To:"
msgstr "Ҷавоб гардонидан ба:"

#: rc.cpp:32 rc.cpp:36
msgid "Host:"
msgstr "Соҳиб:"

#: rc.cpp:33
msgid "Open the email address control panel"
msgstr "Панели идоракунии суроғаҳои пости электрониро кушоед"

#: rc.cpp:38
msgid "Username:"
msgstr "Номи корванд:"

#: rc.cpp:39
msgid "Port:"
msgstr "Даргоҳ:"

#: rc.cpp:40
msgid "Server needs authentication"
msgstr "Ба хидматрасон аслшиносӣ лозим аст"

