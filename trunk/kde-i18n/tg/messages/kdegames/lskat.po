#: aboutdlg.cpp:33
msgid "About Lieutenant Skat"
msgstr "Дар бораи Лейтенанти Скат"

#: aboutdlg.cpp:62
#, c-format
msgid ""
"Lieutenant\n"
"Skat\n"
"\n"
"Version %1"
msgstr ""
"Лейтенант\n"
"Скат\n"
"\n"
"Ривояти %1"

#: aboutdlg.cpp:69
msgid ""
"(c) 2000 Martin Heni\n"
"Email: martin@heni-online.de\n"
"\n"
"Game features:\n"
"  - Multiplayer network game\n"
"  - Up to two computer players\n"
"\n"
"\n"
" Many thanks to Laura for beta testing!"
msgstr ""
"(c) 2000 Martin Heni\n"
"Адрес: martin@heni-online.de\n"
"\n"
"Хусусияти бозӣ:\n"
"  - бозии шабақа барои бозингарони зиёд\n"
"  - то ду бозингарони компютерӣ\n"
"\n"
"\n"
"Раҳмати калон ба Лаура, ки бозиро озмоидааст!"

#: lskat.cpp:175 lskat.cpp:176
msgid "Starting a new game..."
msgstr "Аввали бозии нав..."

#: lskat.cpp:177
msgid "&End Game"
msgstr "&Итмоми бозӣ"

#: lskat.cpp:179
msgid "Ending the current game..."
msgstr "Бозиро ба итмом мерасонем..."

#: lskat.cpp:180
msgid "Aborts a currently played game. No winner will be declared."
msgstr "Бозии рафта истодаро ба итмом мерасонем. Ғолибон намебошанд."

#: lskat.cpp:181
msgid "&Clear Statistics"
msgstr "&Тоза кардани статистика"

#: lskat.cpp:183
msgid "Delete all time statistics..."
msgstr "Нест кардани ҳамаи статистикаи бозӣ."

#: lskat.cpp:184
msgid "Clears the all time statistics which is kept in all sessions."
msgstr "Тоза кардани ҳамаи статистикаи бозӣ, ҷамъ шудаи дар вақти бозӣ."

#: lskat.cpp:185
msgid "Send &Message..."
msgstr "Фиристодани &ахборот..."

#: lskat.cpp:187
msgid "Sending message to remote player..."
msgstr "Фиристодани ахборот ба бозингари шабақа..."

#: lskat.cpp:188
msgid "Allows you to talk with a remote player."
msgstr "Ба Шумо иҷозат медиҳад бо бозингари шабақа гуфтугӯӣ намоед."

#: lskat.cpp:190
msgid "Exiting..."
msgstr "Баромадан..."

#: lskat.cpp:191
msgid "Quits the program."
msgstr "Аз бозӣ баромадан."

#: lskat.cpp:193
msgid "&Show Statusbar"
msgstr "&Намоиши пайраҳаи вазъият"

#: lskat.cpp:195 lskat.cpp:196
msgid "Toggle the statusbar..."
msgstr "Интихоби пайраҳаи вазъият..."

#: lskat.cpp:198
msgid "Starting Player"
msgstr "Ворид шудани бозингари нав"

#: lskat.cpp:200
msgid "Changing starting player..."
msgstr "Дигар кардани бозингари нав..."

#: lskat.cpp:201
msgid "Chooses which player begins the next game."
msgstr "Интихоби бозингар, ки ба бозии оянда ворид мешавад."

#: lskat.cpp:203
msgid "Player &1"
msgstr "Бозингари &1"

#: lskat.cpp:204
msgid "Player &2"
msgstr "Бозингари &2"

#: lskat.cpp:207
msgid "Player &1 Played By"
msgstr "Бозингари &1 - ин"

#: lskat.cpp:209 lskat.cpp:210
msgid "Changing who plays player 1..."
msgstr "Дигаргун кардани бозингари 1..."

#: lskat.cpp:212
msgid "&Player"
msgstr "&Бозингар"

#: lskat.cpp:213
msgid "&Computer"
msgstr "&Компютер"

#: lskat.cpp:214
msgid "&Remote"
msgstr "&Шабақа"

#: lskat.cpp:216
msgid "Player &2 Played By"
msgstr "Бозингари &2 - ин"

#: lskat.cpp:218 lskat.cpp:219
msgid "Changing who plays player 2..."
msgstr "Дигаргун кардани бозингари 2..."

#: lskat.cpp:222
msgid "&Level"
msgstr "&Дараҷа"

#: lskat.cpp:224
msgid "Change level..."
msgstr "Таъғири дараҷа..."

#: lskat.cpp:225
msgid "Change the strength of the computer player."
msgstr "Таъғири дараҷаи бозингари компютер"

#: lskat.cpp:227
msgid "&Normal"
msgstr "&Муқаррар"

#: lskat.cpp:228
msgid "&Advanced"
msgstr "&Иловагӣ"

#: lskat.cpp:229
msgid "&Hard"
msgstr "&Мураккаб"

#: lskat.cpp:232
msgid "Select &Card Deck..."
msgstr "Интихоби &ранги корт..."

#: lskat.cpp:234
msgid "Configure card decks..."
msgstr "Танзими ранги корт..."

#: lskat.cpp:235
msgid "Choose how the cards should look."
msgstr "Интихоби пӯсти корт."

#: lskat.cpp:237
msgid "Change &Names..."
msgstr "Таъғири &номҳо..."

#: lskat.cpp:239 lskat.cpp:240
msgid "Configure player names..."
msgstr "Танзимим номҳои бозингар..."

#: lskat.cpp:260
msgid "This leaves space for the mover"
msgstr "Ин фосила барои бозингари гарданда"

#: lskat.cpp:261
msgid "23:45"
msgstr "23:45"

#: lskat.cpp:262 lskat.cpp:611 lskat.cpp:844 lskat.cpp:968
msgid "Ready"
msgstr "Тайёр"

#: lskat.cpp:265
msgid "(c) Martin Heni   "
msgstr "(c) Martin Heni   "

#: lskat.cpp:266
msgid "Welcome to Lieutenant Skat"
msgstr "Шуморо Лейтенанти Скат "

#: lskat.cpp:292 lskat.cpp:388 lskat.cpp:769 lskatview.cpp:295 main.cpp:38
msgid "Lieutenant Skat"
msgstr "Лейтенанти Скат"

#: lskat.cpp:412
msgid "Do you really want to clear the all time statistical data?"
msgstr "Шумо ҳақиқатан мехоҳед ҳамаи статистикаро тоза кунед?"

#: lskat.cpp:458
msgid "Game ended...start a new one..."
msgstr "Бозӣ ба итмом расид...бозиро аз сари нав сар кунед..."

#: lskat.cpp:672
msgid "No game running"
msgstr "Бозӣ нарафта истодааст"

#: lskat.cpp:675
msgid "%1 to move..."
msgstr "%1 барои ҳаракат..."

#: lskat.cpp:690
msgid ""
"Cannot start player 1. Maybe the network connection failed or the computer "
"player process file is not found."
msgstr ""
"Бозингари 1 гашта наметавонад. мумкин аст, пайвастагӣ дар шабақа нест, ёки "
"файли бозии компютерии бозингар ёфт нашуд."

#: lskat.cpp:699
msgid ""
"Cannot start player 2. Maybe the network connection failed or the computer "
"player process file is not found."
msgstr ""
"Бозингари 2 гашта наметавонад. мумкин аст, пайвастагӣ дар шабақа нест, ёки "
"файли бозии компютерии бозингар ёфт нашуд."

#: lskat.cpp:762
msgid "Remote connection to %1:%2..."
msgstr "Пайвстагии шабақа ба  %1:%2..."

#: lskat.cpp:766
msgid "Offering remote connection on port %1..."
msgstr "Мунтазами пайватшавии дар порти %1-ро дорам..."

#: lskat.cpp:768
msgid "Abort"
msgstr "Буриш"

#: lskat.cpp:834
msgid "About the program..."
msgstr "Дар бораи бозӣ."

#: lskat.cpp:865
msgid "Waiting for the computer to move..."
msgstr "Мунтазам ба пайвастшавии компютер дорам..."

#: lskat.cpp:880
msgid "Waiting for remote player..."
msgstr "Интизори бозингари шабақа ҳастам..."

#: lskat.cpp:886
msgid "Please make your move..."
msgstr "Илтимос, гардиши худро кунед..."

#: lskat.cpp:920
msgid "Remote connection lost for player 1..."
msgstr "Пайвастшавии бо бозингари 1 нест шуд..."

#: lskat.cpp:927
msgid "Remote connection lost for player 2..."
msgstr "Пайвастшавии бо бозингари 2 нест шуд..."

#: lskat.cpp:939
msgid "Message from remote player:\n"
msgstr "Ахборот аз бозингари шабақа:\n"

#: lskat.cpp:957
msgid "Remote player ended game..."
msgstr "Бозингари шабақа бозиро ба итмом расонд..."

#: lskat.cpp:982
msgid "You are network client...loading remote game..."
msgstr "Шумо клиенти шабақаедд...Бозии шабақаро пурбор мекунам..."

#: lskat.cpp:995
msgid "You are network server..."
msgstr "Шумо сервери шабақаед..."

#: lskat.cpp:1052
msgid ""
"Severe internal error. Move to illegal position.\n"
"Restart game and report bug to the developer.\n"
msgstr ""
"Хатогии дохилӣ мебошад. Вориди нодуруст.\n"
"Бозиро  аз сари нав сар кунед ва дар бораи хатогӣ ба тавлидгари барноманавис "
"хабар намоед.\n"

#: lskat.cpp:1078
msgid ""
"This move would not follow the rulebook.\n"
"Better think again!\n"
msgstr ""
"Чунин гардиш аз ҷиҳати хуб нест.\n"
"Боз як бори дигар кӯшиш кунед!\n"

#: lskat.cpp:1084
msgid "It is not your turn.\n"
msgstr "Ин гардиши шумо нест.\n"

#: lskat.cpp:1089
msgid "This move is not possible.\n"
msgstr "Чунин гардиш имконнопазир аст.\n"

