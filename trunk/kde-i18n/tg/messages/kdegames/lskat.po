msgid "Score:"
msgstr "Ҳисоб:"

#: lskatview.cpp:479 lskatview.cpp:483
msgid "%1 points"
msgstr "%1 хол"

#: lskatview.cpp:502 lskatview.cpp:519
msgid "%1 won to nil. Congratulations!"
msgstr "%1 ғолиби ҳақиқӣ мебошед. Табрик!"

#: lskatview.cpp:510 lskatview.cpp:527
msgid "%1 won with 90 points. Super!"
msgstr "%1 ғолиби ҳақиқӣ шудед. Табрик!"

#: lskatview.cpp:512 lskatview.cpp:529
msgid "%1 won over 90 points. Super!"
msgstr "%1 ғолиби ҳақиқӣ шудед. Табрик!"

#: lskatview.cpp:671
msgid "Move:"
msgstr "Ҳаракат:"

#: lskatview.cpp:703
msgid "Points:"
msgstr "Хол:"

#: lskatview.cpp:708
msgid "Won:"
msgstr "Ғолибият:"

#: lskatview.cpp:713
msgid "Games:"
msgstr "Бозиҳо:"

#: lskatview.cpp:845
msgid "Hold on... the other player hasn't been yet..."
msgstr "Интизор шавед... ҳоло ҳама ворид нашудаанд..."

#: lskatview.cpp:848
msgid "Hold your horses..."
msgstr "Аспҳоро пеш накунед..."

#: lskatview.cpp:851
msgid "Ah ah ah... only one go at a time..."
msgstr "Не не, танҳо як гардиш..."

#: lskatview.cpp:854
msgid "Please wait... it is not your turn."
msgstr "Интизор шавед, ҳозир гардиши шумо не."

