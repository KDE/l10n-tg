msgstr "Хатогии Номаълум; Рақам: %1"

#: konnectionhandling.cpp:244
msgid "Connection to server lost. Aborting the game."
msgstr ""
"Пайвастшавӣ бо хидматрасон гум шуд. "
"Кандашудани бозӣ."

