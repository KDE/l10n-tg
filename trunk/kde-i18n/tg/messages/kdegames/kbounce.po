#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Абророва Хиромон"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "H_Abrorova@rambler.ru"

#: kbounce.cpp:62
msgid "Level:"
msgstr "Сатҳ:"

#: kbounce.cpp:67
msgid "Score:"
msgstr "Холҳо:"

#: kbounce.cpp:74
msgid "Filled area:"
msgstr "Минтақаи пуршуда:"

#: kbounce.cpp:79
msgid "Lives:"
msgstr "Ҷонҳо:"

#: kbounce.cpp:84
msgid "Time:"
msgstr "Вақт:"

#: kbounce.cpp:101
msgid "Press %1 to start a game!"
msgstr "Барои оғози бозӣ %1-ро пахш кунед!"

#: kbounce.cpp:133
msgid "&Select Background Folder..."
msgstr "&Интихоби Феҳристи Паснамо..."

#: kbounce.cpp:136
msgid "Show &Backgrounds"
msgstr "Нишон додани &Паснамо"

#: kbounce.cpp:138
msgid "Hide &Backgrounds"
msgstr "Пинҳон кардани &Паснамо"

#: kbounce.cpp:142
msgid "&Play Sounds"
msgstr "&Бозикунии Овоз"

#: kbounce.cpp:178
msgid "Do you really want to close the running game?"
msgstr ""
"Дар ҳақиқат мехоҳед, ки бозии "
"корандозишударо пӯшед?"

#: kbounce.cpp:198
msgid "Game paused."
msgstr "Бозӣ таваққуф карда шуд."

#: kbounce.cpp:229
#, c-format
msgid "Game Over! Score: %1"
msgstr "Бозӣ ба Охир расид! Холҳо: %1"

#: kbounce.cpp:230
msgid "Game over. Press <Space> for a new game"
msgstr ""
"Бозӣ ба охир расид. Барои оғози бозии нав "
"<Фазо>-ро пахш кунед"

#: kbounce.cpp:250
msgid "Select Background Image Folder"
msgstr "Интихоби Феҳристи Симоҳои Паснамо"

#: kbounce.cpp:270
msgid "You may now turn on background images."
msgstr ""
"Ҳоло шумо метавонед симоҳои паснаморо "
"даргиронед."

#: kbounce.cpp:326
msgid "Game suspended"
msgstr "Бозӣ боздошта шуд"

#: kbounce.cpp:445
#, c-format
msgid ""
"You have successfully cleared more than 75% of the board.\n"
msgstr ""
"Шумо бо муваффақият 75%-и тахтаро тоза "
"кардед.\n"

#: kbounce.cpp:446
msgid ""
"%1 points: 15 points per remaining life\n"
msgstr ""
"%1 холҳо: 15 холҳо барои ҷони боқимонда\n"

#: kbounce.cpp:447
msgid ""
"%1 points: Bonus\n"
msgstr ""
"%1 холҳо: Мукофот\n"

#: kbounce.cpp:448
msgid ""
"%1 points: Total score for this level\n"
msgstr ""
"%1 холҳо: Холҳои умумии ин сатҳ\n"

#: kbounce.cpp:449
msgid "On to level %1. Remember you get %2 lives this time!"
msgstr ""
"Дар сатҳи %1. Дар хотир доред, ки ин дафъа "
"шумо %2 ҷон хоҳед дошт!"

#: main.cpp:29
msgid "KDE Bounce Ball Game"
msgstr "KDE Бозӣ бо Тӯбҳо"

#: main.cpp:34
msgid "KBounce"
msgstr "KБозӣ бо Тӯбҳо"

#: main.cpp:38
msgid "Original author"
msgstr "Муаллифи ибтидоӣ"

#: main.cpp:40
msgid "Contributions"
msgstr "Ҳамкорон"
