msgid "Next balls:"
msgstr "Тӯбчаҳои оянда:"

#: rc.cpp:4
#, no-c-format
msgid "Difficulty level"
msgstr "Оё намоиши маҷмӯи тӯбҳои оянда лозим аст."

#: rc.cpp:6
#, no-c-format
msgid "Whether to show the next set of balls."
msgstr ""
"Оё намоиши тӯбчаҳои рақамгузошташуда "
"истифода бурда шаванд."

#: rc.cpp:8
#, no-c-format
msgid "Whether to use numbered balls."
msgstr ""
"Оё намоиши тӯбчаҳои рақамгузошташуда "
"истифода бурда шаванд."
