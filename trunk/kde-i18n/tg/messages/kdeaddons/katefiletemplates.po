#: filetemplates.cpp:132
msgid "Any File..."
msgstr "Ягон файл..."

#: filetemplates.cpp:136
msgid "&Use Recent"
msgstr "&Истифодаи нав"

#: filetemplates.cpp:239
msgid "&Manage Templates..."
msgstr "&Идора кардани қолабҳо..."

#: filetemplates.cpp:243
msgid "New From &Template"
msgstr "Нав аз &Қолабҳо"

#: filetemplates.cpp:339
msgid "Open as Template"
msgstr "Кушодан мисли қолабҳо"

#: filetemplates.cpp:370
msgid ""
"<qt>Error opening the file"
"<br><strong>%1</strong>"
"<br>for reading. The document will not be created.</qt>"
msgstr ""
"<qt>Хатогӣ дар вақти кушодани "
"файли"
"<br><strong>%1</strong>"
"<br>барои хондан. Санад эҷод карда "
"намешавад.</qt>"

#: filetemplates.cpp:371 filetemplates.cpp:1093
msgid "Template Plugin"
msgstr "Модули қолаб"

#: filetemplates.cpp:481
#, c-format
msgid "Untitled %1"
msgstr "Беунвон %1"

#: filetemplates.cpp:643
msgid "Manage File Templates"
msgstr "Идора кардани қолабҳои файл"

#: filetemplates.cpp:660
msgid "&Template:"
msgstr "&Қолаб:"

#: filetemplates.cpp:665
msgid ""
"<p>"
"This string is used as the template's name and is displayed, for example, in "
"the Template menu. It should describe the meaning of the template, for "
"example 'HTML Document'.</p>"
msgstr ""
"<p>Ин банд барои номи қолаб ва намоиш "
"истифода карда шудааст, мисол, дар менюи "
"Қолаб. Ин бояд маънои қолабро тасвир "
"кунад, мисол 'Санади HTML'.</p>"

#: filetemplates.cpp:670
msgid "Press to select or change the icon for this template"
msgstr ""
"Барои интихоб кардан ё тағйир додани "
"ишора барои ин қолаб инро пахш кунед"

#: filetemplates.cpp:672
msgid "&Group:"
msgstr "&Гурӯҳ:"

#: filetemplates.cpp:676
msgid ""
"<p>The group is used for chosing a submenu for the plugin. If it is empty, "
"'Other' is used.</p>"
"<p>You can type any string to add a new group to your menu.</p>"
msgstr ""
"<p>Ин гурӯҳ барои интихоби зерменю барои "
"модул истифода шуда истодааст Агар ин "
"холӣ бошад, 'Дигар' истифода мешавад. "
"</p>"
"<p>Барои афзудани гурӯҳи нав ба менюи худ, "
"метавонед сатро чоп кунед.</p>"

#: filetemplates.cpp:680
msgid "Document &name:"
msgstr "Номи &санад:"

#: filetemplates.cpp:683
msgid ""
"<p>This string will be used to set a name for the new document, to display "
"in the title bar and file list.</p>"
"<p>If the string contains '%N', that will be replaced with a number "
"increasing with each similarly named file.</p>"
"<p> For example, if the Document Name is 'New shellscript (%N).sh', the "
"first document will be named 'New shellscript (1).sh', the second 'New "
"shellscipt (2).sh', and so on.</p>"
msgstr ""
"<p>Ин сатр барои танзими ном ба санади нав "
"истифода мешавад ва барои намоиши "
"сарлавҳаи сутун, инчунин рӯйхати файл "
"истифода бурда мешавад.</p>"
"<p>Агар сатр '%N'-ро нигоҳ дорад, вай ба "
"рақамҳое, ки бо ҳар як файли номбурдаи "
"оддӣ зиёд мешаванд, ҷойгир мешаванд.</p>"
"<p> Мисол, агар Номи Санад 'Ҷилди Скрипти "
"нав (%N).ҷ.с , бошад, санади аввал 'Ҷилди "
"Скрипти нав (1).ҷ.с , дуввумаш 'Ҷилди "
"Скрипти нав (2).ҷ.с. мешавад ва ғайра.</p>"

#: filetemplates.cpp:691
msgid "&Highlight:"
msgstr "&Равшан:"

#: filetemplates.cpp:692
msgid "None"
msgstr "Не"

#: filetemplates.cpp:694
msgid ""
"<p>Select the highlight to use for the template. If 'None' is chosen, the "
"property will not be set.</p>"
msgstr ""
"<p>Равшанро барои истифода бурдани қолаб, "
"интихоб кунед. Агар 'Не' интихоб шудааст "
"хусусият танзим нахоҳад шуд.</p>"

#: filetemplates.cpp:697
msgid "&Description:"
msgstr "&Тавсифот:"

#: filetemplates.cpp:700
msgid ""
"<p>"
"This string is used, for example, as context help for this template (such as "
"the 'whatsthis' help for the menu item.)</p>"
msgstr ""
"<p>Ин банд, мисол, мисли замина барои ин "
"қолаб ёрӣ мерасонад (монанди ёрии 'ин "
"чист' барои ишораи меню), истифода бурда "
"мешаванд.</p>"

#: filetemplates.cpp:704
msgid "&Author:"
msgstr "&Муаллиф:"

#: filetemplates.cpp:707
msgid ""
"<p>You can set this if you want to share your template with other "
"users.</p>"
"<p>the recommended form is like an Email address: 'Anders Lund "
"&lt;anders@alweb.dk&gt;'</p>"
msgstr ""
"<p>Агар хоҳед, ки қолиби худро бо дигар "
"истифодабарандаҳо тақсим кунед, "
"метавонед инро танзим кунед.</p>"
"<p>шакли тавсияшаванда монанди суроғаи "
"почтаи электронӣ аст: 'Anders Lund "
"&lt;anders@alweb.dk&gt;'</p>"

#: filetemplates.cpp:779
msgid ""
"<p>"
"If you want to base this template on an existing file or template, select "
"the appropriate option below.</p>"
msgstr ""
"<p>Агар шумо мехоҳед, ки ин қолабро дар "
"файли вуҷудшуда ё қолаб асос кунед, "
"интихоботи мувофиқро, ки дар поёнтар "
"ҷойгир аст, интихоб кунед.</p>"

#: filetemplates.cpp:786
msgid "Start with an &empty document"
msgstr "Сар кардан бо санади &холӣ"

#: filetemplates.cpp:791
msgid "Use an existing file:"
msgstr "Истифода бурдани файли вуҷудшуда:"

#: filetemplates.cpp:799
msgid "Use an existing template:"
msgstr "Истифода бурдани қолаби вуҷудшуда:"

#: filetemplates.cpp:829
msgid "Chose Template Origin"
msgstr "Интихоб кардани манбаъи қолаб"

#: filetemplates.cpp:834
msgid "Edit Template Properties"
msgstr "Тағйири хусусияти қолаб"

#: filetemplates.cpp:852
msgid ""
"<p>Chose a location for the template. If you store it in the template "
"directory, it will automatically be added to the template menu.</p>"
msgstr ""
"<p>Барои қолаб марҳилае интихоб кунед. "
"Агар шумо ӯро дар қолаби каталог захира "
"кунед вай худкорона ба менюи қолаб дохил "
"мешавад.</p>"

#: filetemplates.cpp:860
msgid "Template directory"
msgstr "Қолаби каталог"

#: filetemplates.cpp:867
msgid "Template &file name:"
msgstr "Қолаби &номи файл:"

#: filetemplates.cpp:872
msgid "Custom location:"
msgstr "Макон:"

#: filetemplates.cpp:886
msgid "Choose Location"
msgstr "Интихоби макон"

#: filetemplates.cpp:895
msgid ""
"<p>You can replace certain strings in the text with template macros."
"<p>If any of the data below is incorrect or missing, edit the data in the "
"KDE email information."
msgstr ""
"<p>Шумо метавонед сатрҳои муқарраршударо "
"дар матни бо қолабҳои макроҳо, ҷо "
"кунед."
"<p>Агар ягон рақам нодуруст ё ғоиб бошад, "
"рақамҳои дар ахбороти почтаи электронии "
"KDE-ро тағйир кунед."

#: filetemplates.cpp:901
msgid "Replace full name '%1' with the '%fullname' macro"
msgstr ""
"Номи пурраи '%1' бо '%номипурраи' макро "
"ҷойгузорӣ кунед"

#: filetemplates.cpp:908
msgid "Replace user name '%1' with the '%username' macro"
msgstr ""
"Номи истифодабарандаи '%1'-ро бо "
"'%истифодабаранадаи' макро, ҷойгузорӣ "
"кунед"

#: filetemplates.cpp:915
msgid "Replace email address '%1' with the '%email' macro"
msgstr ""
"Суроғаи почтаи электронии '%1'-ро бо "
"'%почтаи электронии' макро ҷойгузорӣ кунед"

#: filetemplates.cpp:922
msgid "Autoreplace Macros"
msgstr "Тағйир додани ҷойи макро ба тарзи худкор"

#: filetemplates.cpp:929
msgid ""
"<p>The template will now be created and saved to the chosen location. To "
"position the cursor put a caret ('^') character where you want it in files "
"created from the template.</p>"
msgstr ""
"<p>Қолаб ҳозир эҷод шуда ва ба фосилаҳои "
"интихобшуда захира мешавад. Дар ҳолати "
"курсор аломати карет ('^') -ро, ки мехоҳед "
"дар файлҳои аз қолиб эҷод шударо "
"гузоред.</p>"

#: filetemplates.cpp:935
msgid "Open the template for editing"
msgstr "Қолибро барои тағйир додан кушоед"

#: filetemplates.cpp:941
msgid "Create Template"
msgstr "Эҷоди қолиб"

#: filetemplates.cpp:1036
msgid ""
"<p>The file "
"<br><strong>'%1'</strong>"
"<br>"
" already exists; if you do not want to overwrite it, change the template "
"file name to something else."
msgstr ""
"<p>Файли "
"<br><strong>'%1'</strong>"
"<br> аллакай мавҷуд аст; агар нахоҳед, ки "
"онро тағйир диҳед, номи қолиби файлро ба "
"номи дигар тағйир диҳед."

#: filetemplates.cpp:1039
msgid "File Exists"
msgstr "Файл мавҷуд аст"

#: filetemplates.cpp:1039
msgid "Overwrite"
msgstr "Тағйир додан"

#: filetemplates.cpp:1091
msgid ""
"<qt>Error opening the file"
"<br><strong>%1</strong><br>for reading. The document will not be created</qt>"
msgstr ""
"<qt>Хатогӣ ҳангоми кушодани файли "
"<br><strong>%1</strong>"
"<br>барои хондан. Санадот эҷод карда "
"намешавад</qt>"

#: filetemplates.cpp:1161
msgid ""
"Unable to save the template to '%1'.\n"
"\n"
"The template will be opened, so you can save it from the editor."
msgstr ""
"Қодир ба захира кардани қолиб ба '%1' "
"нестам.\n"
"\n"
"Қолиб кушода мешавад ва бо чунин тарз "
"метавонед онро аз муҳаррир захира кунед."

#: filetemplates.cpp:1163
msgid "Save Failed"
msgstr "Захира хароб гашт"

#: filetemplates.cpp:1196
msgid "Template"
msgstr "Қолаб"

#: filetemplates.cpp:1200
msgid "New..."
msgstr "Нав..."

#: filetemplates.cpp:1204
msgid "Edit..."
msgstr "Тағйир..."
