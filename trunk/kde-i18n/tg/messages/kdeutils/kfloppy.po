msgid "Floppy drive:"
msgstr "Гардонандаи диски нарм:"

#: floppy.cpp:76 floppy.cpp:226
msgid "Primary"
msgstr "Ибтидоӣ"

#: floppy.cpp:77 floppy.cpp:230
msgid "Secondary"
msgstr "Дуюмин"

