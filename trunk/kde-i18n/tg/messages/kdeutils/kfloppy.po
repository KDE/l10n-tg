msgstr "3.5\" 1.44Мб"

#: floppy.cpp:87 floppy.cpp:241
msgid "3.5\" 720KB"
msgstr "3.5\" 720Кб"

#: floppy.cpp:88 floppy.cpp:245
msgid "5.25\" 1.2MB"
msgstr "5.25\" 1.2Мб"

#: floppy.cpp:89 floppy.cpp:249
msgid "5.25\" 360KB"
msgstr "5.25\" 360Кб"

