msgid "Ark Kparts"
msgstr "Kқисмҳои бойгонигар"

#: arkwidgetpart.cpp:105
msgid "You don't have permission to access that archive."
msgstr "Шумо рухсатро барои дастрасӣ ба бойгонӣ надоред."

#: arkwidgetpart.cpp:614
msgid "bzip does not support filename extensions that use capital letters."
msgstr ""
"bzip паҳншавии номи файлро, ки ҳарфҳои болоии "
"номнависро истифода мебаранд, пуштибонӣ намекунад."

#: arkwidgetpart.cpp:618
msgid "bzip only supports filenames with the extension \".bz\"."
msgstr "bzip танҳо номи файлҳоро ба паҳншавии \".bz\" пуштибонӣ мекунад."

#: arkwidgetpart.cpp:622
msgid "bzip2 does not support filename extensions that use capital letters."
msgstr ""
"bzip2 паҳншавии номи файлро, ки ҳарфҳои болоии "
"номнависро истифода мебаранд, пуштибонӣ намекунад."

#: arkwidgetpart.cpp:626
msgid "bzip2 only supports filenames with the extension \".bz2\"."
msgstr "bzip2 танҳо номи файлҳоро ба паҳншавии \".bz2\" пуштибонӣ мекунад."

#: arkwidgetpart.cpp:664
msgid "Gzip archives need to have an extension `gz'."
msgstr "Бойгониҳои Gzip бояд паҳншавии `gz'-ро дошта бошад."

#: arkwidgetpart.cpp:669
msgid "Zoo archives need to have an extension `zoo'."
msgstr "Бойгониҳои Zoo бояд паҳншавии `zoo'-ро дошта бошад."

