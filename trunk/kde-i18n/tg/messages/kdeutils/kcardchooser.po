#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Абророва Хиромон"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "H_Abrorova@rambler.ru"

#: main.cpp:33
msgid "Slot name of the card in question."
msgstr "Номи корт пурсон шудааст."

#: main.cpp:34
msgid "ATR of the card in question."
msgstr "Рамзи худмуайянкунии корт пурсон шудааст (ATR)"

#: main.cpp:42
msgid "KCardChooser"
msgstr "KИнтихоби Корт"

#: kcardchooser.ui.h:17 main.cpp:43 main.cpp:55
msgid "KDE Smartcard Chooser"
msgstr "KDE Интихоби Смарт-корт"

#: rc.cpp:1
msgid "Please select the card type which matches the card you have."
msgstr ""
"Марҳамат карда навъи кортҳоеро, ки ба корти шумо мувофиқат мекунанд, интихоб "
"кунед."

#: rc.cpp:2
msgid "Slot Properties"
msgstr "Хусусиятҳои Шикоф"

#: rc.cpp:3
msgid "Card ATR:"
msgstr "Рамзи Худмуайянсозии Корт (ATR):"

#: rc.cpp:5
msgid "Slot:"
msgstr "Шикоф:"

#: rc.cpp:6
msgid "Managed by:"
msgstr "Идора мешавад бо:"

#: rc.cpp:8
msgid "ATR match:"
msgstr "Мувофиқати Рамзи Худмуайянсозии Корт (ATR):"

#: rc.cpp:10
msgid "Available Libraries"
msgstr "Китобхонаҳои Имконпазир"

#: kcardchoosermain.cc:135
msgid "No ATR found. DCOP Error."
msgstr "ATR пайдо нагардид. Хатогии DCOP."

#: kcardchoosermain.cc:136 kcardchoosermain.cc:162 kcardchoosermain.cc:163
msgid "None"
msgstr "Нест"

#: kcardchoosermain.cc:161
msgid "No card inserted"
msgstr "Корт ҷойгир карда нашудааст"

#: kcardchoosermain.cc:175
msgid "No slot selected."
msgstr "Ягон шикоф интихоб нагардид:"

#: kcardchoosermain.cc:180
#, c-format
msgid "No card ATR detected in %1."
msgstr "Ягон корти ATR дар %1 муайян нагардид."

#: kcardchoosermain.cc:185
msgid "Please select an available card implementation."
msgstr "Марҳамат карда иҷрои корро бо кортҳо интихоб кунед."

#: kcardchoosermain.cc:192
msgid "Error accessing card database. Check 'ksmartcarddb' file."
msgstr ""
"Хатогии дастрасӣ ба манбаи додаҳои корт. Файли 'ksmartcarddb'-ро санҷед."

#: kcardchoosermain.cc:212
msgid "Slot '%1' not found in available slots."
msgstr "Шикофи '%1' дар рӯйхати шикофҳои дастрас пайдо нагардид."

#: kcardchoosermain.cc:235
msgid "No readers found. DCOP Error"
msgstr "Дастгоҳи хониш пайдо нагардид. Хатогии DCOP"

#: kcardchoosermain.cc:250
msgid "No readers found"
msgstr "Дастгоҳи хониш пайдо нагардид"

#: kcardchooser.ui.h:15
msgid ""
"Sorry, your card may not be supported in KDE natively.\n"
"Try to find a KDE driver for your card online."
msgstr ""
"Бубахшед, лекин корти шумо аз тарафи танзимкунии асосии KDE пуштибонӣ нашуда "
"метавонад.\n"
"Кӯшиш кунед, ки барои корти худ KDE гардонандаи мувофиқро дар шабака дарёбед."
