#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Victor Ibragimov"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "victor.ibragimov@gmail.com"

#: plugin_rellinks.cpp:65
#, kde-format
msgid "Rellinks"
msgstr "Алоқаи дубора"

#: plugin_rellinks.cpp:73
#, kde-format
msgid "&Top"
msgstr "&Аз боло"

#: plugin_rellinks.cpp:76
#, kde-format
msgid "<p>This link references a home page or the top of some hierarchy.</p>"
msgstr ""
"<p>Ин алоқа ба тарафи варақаи хонагин бадарға карда мешавад ё ин ки баландии "
"ягон иерархиҳо.</p> "

#: plugin_rellinks.cpp:80
#, kde-format
msgid "&Up"
msgstr "&Ба боло"

#: plugin_rellinks.cpp:83
#, kde-format
msgid ""
"<p>This link references the immediate parent of the current document.</p>"
msgstr ""
"<p>Ин алоқа бевосита ба ҳуҷҷати мавҷуд будаи волидайн бадарғакарда мешавад. "
"</p>"

#: plugin_rellinks.cpp:89
#, kde-format
msgid "&First"
msgstr "&Якум"

#: plugin_rellinks.cpp:92
#, kde-format
msgid ""
"<p>This link type tells search engines which document is considered by the "
"author to be the starting point of the collection.</p>"
msgstr ""
"<p>Ин намуди алоқа бо муҳаррики ковтуков гап мезанад, яъне ҳамон ҳуҷҷатҳое, "
"ки ҳамчун муаллиф ба ҳисоб мераванд, то ин нуқтаи ҷамъшавии равонкунанда "
"бошанд. </p> "

#: plugin_rellinks.cpp:96
#, kde-format
msgid "&Previous"
msgstr "&Ақиб"

#: plugin_rellinks.cpp:99
#, kde-format
msgid ""
"<p>This link references the previous document in an ordered series of "
"documents.</p>"
msgstr ""
"<p>Ин алоқа ба ҳуҷҷати пешина, ки дар қатори ҳуҷҷатҳо супориш дода буд, "
"бадарға карда мешавад. </p>"

#: plugin_rellinks.cpp:103
#, kde-format
msgid "&Next"
msgstr "&Навбатӣ"

#: plugin_rellinks.cpp:106
#, kde-format
msgid ""
"<p>This link references the next document in an ordered series of documents."
"</p>"
msgstr ""
"<p>Ин алоқа ба ҳуҷҷати оянда, ки дар қатори ҳуҷҷатҳо супориш дода буд, "
"бадарға карда мешавад. </p> "

#: plugin_rellinks.cpp:110
#, kde-format
msgid "&Last"
msgstr "&Охирин"

#: plugin_rellinks.cpp:113
#, kde-format
msgid "<p>This link references the end of a sequence of documents.</p>"
msgstr "<p>Ин алоқа ба охири ҳуҷҷатҳои пайдарпаӣ бадарға карда мешавад. </p> "

#: plugin_rellinks.cpp:118
#, kde-format
msgid "&Search"
msgstr "&Ҷустуҷӯ"

#: plugin_rellinks.cpp:121
#, kde-format
msgid "<p>This link references the search.</p>"
msgstr "<p>Ин алоқа барои бадарға кардани ҷустуҷӯ мебошад.</p>"

#: plugin_rellinks.cpp:125
#, kde-format
msgid "Document"
msgstr "Ҳуҷҷат"

#: plugin_rellinks.cpp:127
#, kde-format
msgid "<p>This menu contains the links referring the document information.</p>"
msgstr ""
"<p>Ин меню алоқаро дар худ нигоҳ медорад, вале ҳамоне, ки ахбороти ҳуҷҷат "
"алоқаманди дорад. </p>"

#: plugin_rellinks.cpp:131
#, kde-format
msgid "Table of &Contents"
msgstr "Му&ндариҷа"

#: plugin_rellinks.cpp:133
#, kde-format
msgid "<p>This link references the table of contents.</p>"
msgstr "<p>Ин алоқа ба мундариҷа бадарға карда мешавад.</p>"

#: plugin_rellinks.cpp:137
#, kde-format
msgid "Chapters"
msgstr "Бобҳо (фаслҳо)"

#: plugin_rellinks.cpp:142
#, kde-format
msgid "<p>This menu references the chapters of the document.</p>"
msgstr "<p>Ин меню ба бобҳои ҳуҷҷат бадарға карда мешаванд.</p>"

#: plugin_rellinks.cpp:145
#, kde-format
msgid "Sections"
msgstr "Қисматҳо"

#: plugin_rellinks.cpp:151
#, kde-format
msgid "<p>This menu references the sections of the document.</p>"
msgstr "<p>Ин меню ба қисмати ҳуҷҷатҳо бадарға карда мешаванд.</p>"

#: plugin_rellinks.cpp:154
#, kde-format
msgid "Subsections"
msgstr "Зербахшҳо"

#: plugin_rellinks.cpp:159
#, kde-format
msgid "<p>This menu references the subsections of the document.</p>"
msgstr "<p>Ин меню ба зербахшҳои ҳуҷҷатҳо бадарға карда мешаванд.</p>"

#: plugin_rellinks.cpp:162
#, kde-format
msgid "Appendix"
msgstr "Илова"

#: plugin_rellinks.cpp:167
#, kde-format
msgid "<p>This link references the appendix.</p>"
msgstr "<p>Ин алоқа ба илова бадарға карда мешавад.</p>"

#: plugin_rellinks.cpp:171
#, kde-format
msgid "&Glossary"
msgstr "&Вожанома"

#: plugin_rellinks.cpp:173
#, kde-format
msgid "<p>This link references the glossary.</p>"
msgstr "<p>Ин алоқа ба фарҳанги вожаҳо бадарға карда мешавад.</p>"

#: plugin_rellinks.cpp:178
#, kde-format
msgid "&Index"
msgstr "&Индекс"

#: plugin_rellinks.cpp:180
#, kde-format
msgid "<p>This link references the index.</p>"
msgstr "<p>Ин алоқа ба шохис бадарға карда мешавад.</p>"

#: plugin_rellinks.cpp:185
#, kde-format
msgid "More"
msgstr "Бештар"

#: plugin_rellinks.cpp:187
#, kde-format
msgid "<p>This menu contains other important links.</p>"
msgstr "<p>Ин меню аз дигар алоқаҳои махсус иборат аст.</p>"

#: plugin_rellinks.cpp:191
#, kde-format
msgid "&Help"
msgstr "&Роҳнамо"

#: plugin_rellinks.cpp:194
#, kde-format
msgid "<p>This link references the help.</p>"
msgstr "<p>Ин алоқа ба ёрдам бадарға карда мешавад.</p>"

#: plugin_rellinks.cpp:199
#, kde-format
msgid "&Authors"
msgstr "&Муаллифҳо"

#: plugin_rellinks.cpp:202
#, kde-format
msgid "<p>This link references the author.</p>"
msgstr "<p>Ин алоқа ба муаллифҳо бадарға карда мешавад.</p>"

#: plugin_rellinks.cpp:207
#, kde-format
msgid "Copy&right"
msgstr "Ҳуқуқ&ҳои муаллиф"

#: plugin_rellinks.cpp:210
#, kde-format
msgid "<p>This link references the copyright.</p>"
msgstr "<p>Ин алоқа ба ҳуқуқҳои муаллиф бадарға карда мешавад.</p>"

#: plugin_rellinks.cpp:214
#, kde-format
msgid "Bookmarks"
msgstr "Хатчӯбҳо"

#: plugin_rellinks.cpp:217
#, kde-format
msgid "<p>This menu references the bookmarks.</p>"
msgstr "<p>Ин меню ба гузориш бадарға карда мешаванд.</p>"

#: plugin_rellinks.cpp:221
#, kde-format
msgid "Other Versions"
msgstr "Версияҳои дигар"

#: plugin_rellinks.cpp:224
#, kde-format
msgid "<p>This link references the alternate versions of this document.</p>"
msgstr ""
"<p>Ин алоқа ба варианти тағирпазир ин ҳуҷҷат бадарға карда мешаванд.</p>"

#: plugin_rellinks.cpp:229
#, kde-format
msgid "Miscellaneous"
msgstr "Гуногун"

#: plugin_rellinks.cpp:232
#, kde-format
msgid "<p>Miscellaneous links.</p>"
msgstr "<p>Алоқаҳои гуногун.</p>"

#: plugin_rellinks.cpp:478 plugin_rellinks.cpp:493
#, kde-format
msgid "[Autodetected] %1"
msgstr "[Худмуайянкардашуда] %1"

