#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "Plasma Workspace"
msgstr "Фазои кории Plasma"

#: plasma_workspace.notifyrc:54
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Сабад: Холӣ шуд"

#: plasma_workspace.notifyrc:103
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Сабад холӣ карда шудааст"

#: plasma_workspace.notifyrc:156
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Пуркунии матн: Давpзанӣ"

#: plasma_workspace.notifyrc:203
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Рӯйхати мувофиқатҳо ба поён расид"

#: plasma_workspace.notifyrc:255
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Пуркунии матн: Ягон мувофиқат ёфт нашуд"

#: plasma_workspace.notifyrc:303
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Ягон мувофиқати пуркунӣ ёфт нашуд"

#: plasma_workspace.notifyrc:355
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Пуркунии матн: Мувофиқати қисман ёфт шуд"

#: plasma_workspace.notifyrc:403
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Дар ин ҷо зиёда аз як мувофиқати имконпазир ёфт шуд"

#: plasma_workspace.notifyrc:455
msgctxt "Name"
msgid "Fatal Error"
msgstr "Хатои ҷиддӣ"

#: plasma_workspace.notifyrc:503
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Хатои ҷиддие рӯй дод, ки барномаро қатъ кард"

#: plasma_workspace.notifyrc:556
msgctxt "Name"
msgid "Notification"
msgstr "Огоҳинома"

#: plasma_workspace.notifyrc:605
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Чизе махсус дар барнома рӯй дод"

#: plasma_workspace.notifyrc:657
msgctxt "Name"
msgid "Warning"
msgstr "Огоҳӣ"

#: plasma_workspace.notifyrc:706
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Хатое дар барнома рӯй дод, ки метавонад мушкилиеро ба вуҷуд орад"

#: plasma_workspace.notifyrc:757
msgctxt "Name"
msgid "Catastrophe"
msgstr "Садама"

#: plasma_workspace.notifyrc:805
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "Хатои хеле ҷиддӣ рӯй дод, ки ақаллан барномаро қатъ кард"

#: plasma_workspace.notifyrc:857
msgctxt "Name"
msgid "Application Crash"
msgstr "Вайроншавии барнома"

#: plasma_workspace.notifyrc:902
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Барномае ногаҳон пӯшида шуд"

#: plasma_workspace.notifyrc:950
msgctxt "Name"
msgid "Login"
msgstr "Воридшавӣ"

#: plasma_workspace.notifyrc:999
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Ҷаласаи нав оғоз карда истодааст"

#: plasma_workspace.notifyrc:1051
msgctxt "Name"
msgid "Logout"
msgstr "Баромад аз мизи корӣ"

#: plasma_workspace.notifyrc:1100
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Ҷаласа баромада истодааст"

#: plasma_workspace.notifyrc:1153
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Баромад қатъ карда шуд"

#: plasma_workspace.notifyrc:1202
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Баромади Plasma қатъ карда шуд"

#: plasma_workspace.notifyrc:1254
msgctxt "Name"
msgid "Print Error"
msgstr "Хатои чоп"

#: plasma_workspace.notifyrc:1303
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Хатои чоп рӯй дод"

#: plasma_workspace.notifyrc:1355
msgctxt "Name"
msgid "Information Message"
msgstr "Паёми иттилоотӣ"

#: plasma_workspace.notifyrc:1404
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Паёми иттилоотӣ нишон дода истодааст"

#: plasma_workspace.notifyrc:1456
msgctxt "Name"
msgid "Warning Message"
msgstr "Паёми огоҳӣ"

#: plasma_workspace.notifyrc:1505
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Паёми огоҳӣ нишон дода истодааст"

#: plasma_workspace.notifyrc:1557
msgctxt "Name"
msgid "Critical Message"
msgstr "Паёми танқидӣ"

#: plasma_workspace.notifyrc:1606
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Паёми танқидӣ нишон дода истодааст"

#: plasma_workspace.notifyrc:1658
msgctxt "Name"
msgid "Question"
msgstr "Савол"

#: plasma_workspace.notifyrc:1707
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Савол пурсида шуд"

#: plasma_workspace.notifyrc:1760
msgctxt "Name"
msgid "Beep"
msgstr "Бип"

#: plasma_workspace.notifyrc:1809
msgctxt "Comment"
msgid "Sound bell"
msgstr "Садои зангӯла"

#: plasma_workspace.notifyrc:1861
msgctxt "Name"
msgid "Widget failed to install"
msgstr "Насбкунии виҷет қатъ шуд"

#: plasma_workspace.notifyrc:1906
msgctxt "Comment"
msgid "A widget could not be installed"
msgstr "Виҷет насб карда намешавад"

#: plasma_workspace.notifyrc:1954
msgctxt "Name"
msgid "Widget deleted"
msgstr "Виҷет нест шуд"

#: plasma_workspace.notifyrc:2000
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Виҷет нест карда шуд"
