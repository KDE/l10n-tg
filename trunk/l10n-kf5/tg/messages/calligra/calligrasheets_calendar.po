msgid "Insert Calendar"
msgstr "Тақвимро ворид кунед"

#~ msgid ""
#~ "End date is before start date! Please make sure that end date comes after "
#~ "start date."
#~ msgstr ""
#~ "Санаи охирин пеш аз санаи аввалин меистад. Мутмаин шавед, ки санаи охирин "
#~ "баъд аз санаи аввалин меистад."

#~ msgid "Error"
#~ msgstr "Хато"

#~ msgid ""
#~ "Calendars should not be longer than 10 years. If you really need such "
#~ "long periods you need to split them up."
#~ msgstr ""
#~ "Тақвимҳо набояд, ки аз 10 сол зиёд бошанд. Агар чунин давраҳои зиёд ба "
#~ "шумо лозим ҳастанд, шумо бояд онҳоро тақсим кунед."

#~ msgid ""
#~ "Start and end dates are equal! Only one day will be inserted, do you want "
#~ "to continue?"
#~ msgstr ""
#~ "Санаи охирин ва санаи аввалин баробар ҳастанд! Танҳо як рӯз ворид карда "
#~ "мешавад. Давом медиҳед?"

#~ msgid "Warning"
#~ msgstr "Огоҳӣ"

#~ msgid ""
#~ "Creating a calendar for a longer period than a year can take up a lot of "
#~ "space, do you want to continue?"
