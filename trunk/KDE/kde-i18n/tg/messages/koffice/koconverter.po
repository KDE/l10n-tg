#: koconverter.cc:40
msgid "Input file"
msgstr "Файли даромадан"

#: koconverter.cc:41
msgid "Output file"
msgstr "Файли баромадан"

#: koconverter.cc:42
msgid "Make a backup of the destination file"
msgstr "Сохтани нусҳаи файли эҳтиётӣ"

#: koconverter.cc:43
msgid "Batch mode: do not show dialogs"
msgstr ""
"Диалогҳо дар тартиботи пакет пинҳон "
"накардан"

#: koconverter.cc:44
msgid "Interactive mode: show dialogs (default)"
msgstr ""
"Намоиши диалогҳо дар тартиботи "
"интерактивӣ (бо пешфарз)"

#: koconverter.cc:45
msgid "Mimetype of the output file"
msgstr "Шакли файли баромадан"

#: koconverter.cc:75
msgid "KOConverter"
msgstr "KOКонвертер"

#: koconverter.cc:76
msgid "KOffice Document Converter"
msgstr "Ҳуҷҷати Конвертери KOffice"

#: koconverter.cc:78
msgid "(c) 2001-2004 KOffice developers"
msgstr "(c) 2001-2004 тайёркунандаҳои KOffice"

#: koconverter.cc:120
msgid "Mimetype for input file %1 not found!"
msgstr "Шакли файли даромадан %1 ёфта нашуд!"

#: koconverter.cc:130
#, c-format
msgid "Mimetype not found %1"
msgstr "Шакл ёфта нашуд %1"

#: koconverter.cc:139
msgid "Mimetype not found, try using the -mimetype option"
msgstr ""
"Шакл ёфта нашуд, калиди -mimetype истифода "
"баред"

#: koconverter.cc:153
msgid "*** The conversion failed! ***"
msgstr ""

#: koconverter.cc:158
msgid "Two arguments required"
msgstr "Ду далелҳо воҷиб аст"

