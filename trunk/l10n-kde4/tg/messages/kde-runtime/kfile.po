#: fileprops.cpp:230
#, kde-format
msgid "kfile"
msgstr "kfile"

#: fileprops.cpp:231
#, kde-format
msgid "A command-line tool to read and modify metadata of files."
msgstr "Барномаи фармонҳо барои хондан ва тағйир кардани файлҳои metadata."

#: fileprops.cpp:232
#, kde-format
msgid "(c) 2002, Carsten Pfeiffer"
msgstr "(c) 2002, Carsten Pfeiffer"

#: fileprops.cpp:236
#, kde-format
msgid "Carsten Pfeiffer"
msgstr "Carsten Pfeiffer"

#: fileprops.cpp:245
#, kde-format
msgid "Do not print the mimetype of the given file(s)"
msgstr "Чоп накардани файлҳои mimetype додашуда"

#: fileprops.cpp:247
#, kde-format
msgid "List all supported metadata keys."
msgstr "Намоиши ҳамаи калидҳои  metadata."

#: fileprops.cpp:249
#, kde-format
msgid "List all metadata keys which have a value in the given file(s)."
msgstr "Намоиши ҳамаи калидҳои  metadata барои файлҳои додашуда."

#: fileprops.cpp:252
#, kde-format
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr ""
"Чоп накардани хабарнома, вақте ки файлҳои додашуда пуштибонии mimetype "
"надоранд."

#: fileprops.cpp:255
#, kde-format
msgid "Prints all metadata values, available in the given file(s)."
msgstr "Чоп кардани ҳамаи маълумоит metadata аз файлҳои додашуда."

#: fileprops.cpp:257
#, kde-format
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr ""
"Хусусиятҳои KDEро мекушояд барои намоиш ва тағйир кардани metadata дар "
"файлҳои додашуда"

#: fileprops.cpp:259
#, kde-format
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr ""
"Маълумоти 'калид'ро чоп мекунад. 'калид' метавонад бо вергул дар рӯйхат ҷудо "
"мешавад"

#: fileprops.cpp:261
#, kde-format
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr "Метавонад 'маънои' metadata барои 'key' муайян мекунад"

#: fileprops.cpp:263
#, kde-format
msgid "The file (or a number of files) to operate on."
msgstr "Иҷро кардани файл (ё якчанд файлҳо)."

#: fileprops.cpp:277
#, kde-format
msgid "No files specified"
msgstr "Ягон файл муайян нашудааст"

#: fileprops.cpp:297
#, kde-format
msgid "Cannot determine metadata"
msgstr "Файли metadata муайян карда нашуд"
