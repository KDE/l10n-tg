#: image_plugin.cpp:72
#, kde-format
msgid "You want to overwrite the left picture with the one on the right."
msgstr "Оё шумо мехоҳед тасвири чапро бо тасвири аз тарафи рост иваз кунед."

#: imagevisualizer.cpp:45
#, kde-format
msgid ""
"This picture is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"Ин тасвир дар мизбони маҳаллӣ\n"
"захира нашудааст.\n"
"Барои боркунӣ ин тамғаро зер кунед.\n"

#: imagevisualizer.cpp:53
#, kde-format
msgid "Unable to load image"
msgstr "Тасвир бор карда нашуд"

#: imagevisualizer.cpp:66
#, kde-format
msgctxt "The color depth of an image"
msgid "Depth: %1\n"
msgstr "Чуқурӣ: %1\n"

#: imagevisualizer.cpp:67
#, kde-format
msgctxt "The dimensions of an image"
msgid "Dimensions: %1x%2"
msgstr "Андоза: %1x%2"
