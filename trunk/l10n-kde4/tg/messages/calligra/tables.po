msgid "YEARS(date2; date1; mode)"
msgstr "YEARS(таърих2; таърих1; холат)"

#. i18n: file: functions/datetime.xml:291
#: xml_doc.cpp:536
msgid ""
"YEARS(\"2001-02-19\"; \"2002-02-26\"; 0) returns 1, because there is one "
