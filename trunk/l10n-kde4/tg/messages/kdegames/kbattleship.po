msgid "Shots"
msgstr "Тирпарониҳо"

#: kbattleship.cpp:621 kbattleship.cpp:653 rc.cpp:113
msgid "Hits"
msgstr "Ба нишон расида"

#: kbattleship.cpp:622 kbattleship.cpp:654 rc.cpp:119
msgid "Water"
msgstr "Ба нишон нарасида"

