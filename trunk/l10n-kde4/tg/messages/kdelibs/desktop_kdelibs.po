msgid "Editor"
msgstr "Таҳриргар"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:40
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Хатчӯбмонии худкор"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:94
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr "Аз рӯи қолиб сабт намудани хатчӯбҳо дар ҳуҷҷат"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:41
msgctxt "Name"
msgid "Insert File"
msgstr "Вориди файл"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:99
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Гузоштани ягон файли хондашаванда дар мавқеъи курсор"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:41
msgctxt "Name"
msgid "Data tools"
msgstr "Асбобҳои маълумотӣ"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:100
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr ""
"Иҷозаи истифодаи утилитаи луғат ва тафтиши имлоро (агар онҳо сабт карда шуда "
"бошанд) медиҳад"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:40
msgctxt "Name"
msgid "Time & Date"
msgstr "Вақт ва сана"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:93
msgctxt "Comment"
msgid "Insert current Time & Date"
msgstr "Гузоштани вақт ва санаи ҷорӣ"

#: kate/plugins/timedate/ktexteditor_timedate_config.desktop:9
msgctxt "Name"
msgid "Format of Time & Date insertion"
msgstr "Формати вақт ва сана"

