#: interfaces/kimproxy/interface/dbusinstantmessenger.desktop:5
#, fuzzy
msgctxt "Comment"
msgid "Instant Messenger with a D-Bus interface"
msgstr "Клиенти мубодилаи иттилоот бо интерфейси DCOP"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:1
msgctxt "Name"
msgid "Instant Messenger"
msgstr "Мубодилаи иттилоотҳо"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:51
msgctxt "Comment"
msgid ""
"The instant messenger allows two-way chat between individuals and groups."
msgstr ""
"Клиенти мубодилаи иттилоот барои мубодилаи иттилоот байни одамон ва гурӯҳҳо "
"хизмат мерасонад."

#: interfaces/kspeech/dcoptexttospeech.desktop:5
#, fuzzy
msgctxt "Comment"
msgid "Text-to-Speech Service with a D-Bus interface"
msgstr "Хизматгузории Мант-ба-Талаффуз бо интерфейси DCOP"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgctxt "Name"
msgid "Embedded Text Editor"
msgstr "Муҳаррири матнии эҷодшуда"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:61
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"Сервиси муҳаррири матнӣ барои барномаҳо, ки ба он намоиш ва таҳриркунии матн "
"лозим аст. Онро бояд барномаҳои KDE, ки дар он таҳриркунии матн лозим аст, "
"истифода барад."

#: interfaces/ktexteditor/ktexteditor.desktop:6
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr "Ҷузъи муҳаррири матни эҷодшаванда (бо дастгирии навъи ҳуҷҷат/намуд)"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:6
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "Модули KTextEditor"

#: kate/data/katepart.desktop:3
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Муҳаррири матнии эҷодшуда"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:3
msgctxt "Name"
msgid "KTextEditor Autobookmarker"
msgstr "Замимакунандаи худкори KTextEditor"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:54
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr "Аз рӯи қолиб сабт намудани замимаҳо дар ҳуҷҷат"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:3
msgctxt "Name"
msgid "KTextEditor Insert File Plugin"
msgstr "Модули гузоштани файли KTextEditor"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:62
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Гузоштани ягон файли хондашаванда дар мавқеъи курсор"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:3
msgctxt "Name"
msgid "KTextEditor KDataTool Plugin"
msgstr "Модули коркарди маълумотҳои KTextEditor"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:62
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr ""
"Иҷозаи истифодаи утилитаи луғат ва тафтиши имлоро (агар онҳо сабт карда шуда "
"бошанд) медиҳад"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:3
msgctxt "Name"
msgid "KTextEditor Word Completion Plugin"
msgstr "Модули худиловакунандаи калимаҳои KTextEditor"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:58
msgctxt "Comment"
msgid "Directional or popup-based completion from words in the document"
msgstr "Худиловакунандаи калима дар ҳуҷҷат"

