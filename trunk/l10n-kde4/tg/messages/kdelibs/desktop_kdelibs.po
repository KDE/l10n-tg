#: interfaces/kimproxy/interface/dbusinstantmessenger.desktop:4
msgctxt "Comment"
msgid "Instant Messenger with a D-Bus interface"
msgstr "Барномаи паёмнависӣ бо интерфейси D-Bus"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:1
msgctxt "Name"
msgid "Instant Messenger"
msgstr "Барномаи паёмнависӣ"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:66
msgctxt "Comment"
msgid "The instant messenger allows two-way chat between individuals and groups."
msgstr "Барномаи паёмнависӣ барои ирсоли иттилооти шахсӣ ва гурӯғӣ."

#: interfaces/kspeech/dbustexttospeech.desktop:4
msgctxt "Comment"
msgid "Text-to-Speech Service with a D-Bus interface"
msgstr "Хидмати Мант-ба-Талаффуз бо интерфейси D-Bus"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgctxt "Name"
msgid "Embedded Text Editor"
msgstr "Таҳриркунандаи матни дарунсохт"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:74
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"Хидмати таҳриркунандаи матн барномаҳоро бо намоишгари матн ва таҳриргар "
"имкон медиҳад. Барномаҳои KDE бо хосиятҳои таҳриргари матн бояд ин хидмат "
"истифода барад барад."

#: interfaces/ktexteditor/ktexteditor.desktop:5
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr "Компоненти таҳриркунандаи матни дарунсохт (бо ҷудокунандаи Санад/Намоиш)"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "Пайвандкунаки KTextEditor"

#: kate/data/katepart.desktop:2
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Таҳриркунандаи матни пешрафти дарунсохт"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:16
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Хатчӯбмонии худкор"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:70
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr "Аз рӯи қолиб сабт намудани хатчӯбҳо дар ҳуҷҷат"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:17
msgctxt "Name"
msgid "Insert File"
msgstr "Вориди файл"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:77
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Гузоштани ягон файли хондашаванда дар мавқеъи курсор"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:17
msgctxt "Name"
msgid "Data tools"
msgstr "Асбобҳои маълумотӣ"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:76
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr ""
"Иҷозаи истифодаи утилитаи луғат ва тафтиши имлоро (агар онҳо сабт карда шуда "
"бошанд) медиҳад"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:16
msgctxt "Name"
msgid "Time & Date"
msgstr "Вақт ва сана"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:71
msgctxt "Comment"
msgid "Insert current Time & Date"
msgstr "Гузоштани вақт ва санаи ҷорӣ"

#: kate/plugins/timedate/ktexteditor_timedate_config.desktop:9
msgctxt "Name"
msgid "Format of Time & Date insertion"
msgstr "Формати вақт ва сана"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:17
msgctxt "Name"
msgid "Word Completion"
msgstr "Пуркунии калимаҳо"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:76
msgctxt "Comment"
msgid "Directional or popup-based completion from words in the document"
msgstr "Худиловакунандаи калима дар ҳуҷҷат"

