#: wordcompletion/docwordcompletion.cpp:244
msgid "Pop Up Completion List"
msgstr "Берун кардани рӯйхати пуркарда"

#: wordcompletion/docwordcompletion.cpp:248
msgid "Automatic Completion Popup"
msgstr "Худкори берун кардани пуркардаҳо"

#: wordcompletion/docwordcompletion.cpp:255
msgid "Shell Completion"
msgstr "Пуркардани пӯст"

#: wordcompletion/docwordcompletion.cpp:262
msgid "Reuse Word Above"
msgstr "Боз истифодаи калимаи боло омада"

#: wordcompletion/docwordcompletion.cpp:267
msgid "Reuse Word Below"
msgstr "Боз истифодаи калимаи поён омада"

#: wordcompletion/docwordcompletion_config.cpp:43
msgid "Automatically &show completion list"
msgstr "Намоиши рӯйхати пуркардан бо худкор"

#: wordcompletion/docwordcompletion_config.cpp:56
#, fuzzy
msgctxt ""
"Translators: This is the first part of two strings which will comprise the "
"sentence 'Show completions when a word is at least N characters'. The first "
"part is on the right side of the N, which is represented by a spinbox "
"widget, followed by the second part: 'characters long'. Characters is a "
"ingeger number between and including 1 and 30. Feel free to leave the second "
"part of the sentence blank if it suits your language better. "
msgid "Show completions &when a word is at least"
msgstr "Намоиши пурри калима &агар дар ин калима минимум ҳарфҳо"

#: wordcompletion/docwordcompletion_config.cpp:64
#, fuzzy
msgctxt ""
"This is the second part of two strings that will comprise the sentence 'Show "
"completions when a word is at least N characters'"
msgid "characters long."
msgstr "миқдори ҳарфҳо"

#: wordcompletion/docwordcompletion_config.cpp:67
msgid ""
"Enable the automatic completion list popup as default. The popup can be "
"disabled on a view basis from the 'Tools' menu."
msgstr ""
"Рӯйхати пуркардани калимоҳои берун бо пешфарз фаъол созед. Шумо метавонед "
"ҳолати берунӣ аз дохили менюи асбобҳо ғайри фаъол созед."

#: wordcompletion/docwordcompletion_config.cpp:70
msgid ""
"Define the length a word should have before the completion list is displayed."
msgstr "Пеш аз рӯйхати пуркардан пайдо мешавад, муддати калима муайян кунед."

#: insertfile/insertfileplugin.cpp:87
msgid "Insert File..."
msgstr "Гузоштани файл..."

#: insertfile/insertfileplugin.cpp:99
msgid "Choose File to Insert"
msgstr "Барои гузоштан файле интихоб кунед"

#: insertfile/insertfileplugin.cpp:100
msgid "&Insert"
msgstr ""

#: insertfile/insertfileplugin.cpp:129
msgid ""
"Failed to load file:\n"
"\n"
msgstr ""
"Файлро пурбор карда нашуд:\n"
"\n"

#: insertfile/insertfileplugin.cpp:129 insertfile/insertfileplugin.cpp:150
#: insertfile/insertfileplugin.cpp:172
msgid "Insert File Error"
msgstr "Хато дар гузоштани файл"

#: insertfile/insertfileplugin.cpp:143
#, qt-format
msgid ""
"<p>The file <strong>%1</strong> does not exist or is not readable, aborting."
msgstr ""
"<p>Файли <strong>%1</strong> вуҷуд надорад ё файрон аст, пурбор карда "
"натаврнист."

#: insertfile/insertfileplugin.cpp:147
#, qt-format
msgid "<p>Unable to open file <strong>%1</strong>, aborting."
msgstr ""
"<p>Файлро пурбор карда нашуд<strong>%1</strong>, пурбор карда натавонист."

#: insertfile/insertfileplugin.cpp:170
#, qt-format
