msgstr "Дигаргун кардани фармони намоиши банд"

#: KPrConfig.cpp:555 KPrConfig.cpp:558
msgid "Change Display Field Code Command"
msgstr "Дигаргун кардани фармони намоиши рамзи соҳа"

#: KPrConfig.cpp:607
msgid "Document Defaults"
msgstr "Ҳуҷҷати Пешфарзҳо"

#: KPrConfig.cpp:618
msgid "Default font:"
msgstr "Ҳарфи пешфарз:"

#: KPrConfig.cpp:627
msgid "Choose..."
msgstr "Интихоби..."

#: KPrConfig.cpp:628
msgid ""
"Click here if you want to set a new font. The KDE default Select Font dialog "
"will then be displayed."
msgstr ""

#: KPrConfig.cpp:641
msgid "Global language:"
msgstr "Забони глобалӣ:"

#: KPrConfig.cpp:642
msgid ""
"Use this drop down box to determine the default language for the document. "
"This setting is used by the hyphenation and spelling tools."
msgstr ""

#: KPrConfig.cpp:651
msgid "Automatic hyphenation"
msgstr "Гузаштани калимаҳо бо роҳи автоматӣ"

#: KPrConfig.cpp:652
msgid ""
"Check this box if you want KPresenter to automatically hyphenate long words "
"when it determines the word wrap in text frames. This is not set by default."
msgstr ""

#: KPrConfig.cpp:661
msgid "Create backup file"
msgstr "Сохтани файли нусхаи эҳтиёт"

#: KPrConfig.cpp:662
msgid ""
