#: ksnapshot.cpp:169
msgid "Unable to Save Image"
msgstr "Тасвирро нигоҳ дошта натавонист"

#: ksnapshot.cpp:170
#, qt-format
msgid ""
"KSnapshot was unable to save the image to\n"
"%1."
msgstr ""
"Барномаи KSnapshot \n"
"тасвирро ба %1 нигоҳ дошта натавонист."

#: ksnapshot.cpp:225
msgid "Print Screenshot"
msgstr "Суратро чоп кунед"

#: ksnapshot.cpp:318
msgid "The screen has been successfully grabbed."
msgstr "Тиреза бо муваффақият гирифта шуд."

#: main.cpp:10
msgid "KDE Screenshot Utility"
msgstr "Утилитаи KDE Screenshot"

#: main.cpp:14
msgid "KSnapshot"
msgstr "KСурат"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 33
#: rc.cpp:4
#, no-c-format
msgid "Thumbnail of the current snapshot"
msgstr "Суратчаи ҳозираи снепшот"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 38
#: rc.cpp:8
#, no-c-format
msgid ""
"This is a thumbnail of the current snapshot.\n"
"\n"
"The image can be dragged to another application or document to copy the full "
"screenshot there. Try it with the Konqueror file manager."
msgstr ""
"Ин суратчаи ҳозира снепшот\n"
"\n"
"Ин тасвир ба дигар апплекасия ё документ кучондан мумкин аст барои "
"пурранусха бардоштани скриншот дар онҷо.Инро бо файли менеҷери Konqueror "
"кунед."

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 46
#: rc.cpp:14
#, no-c-format
msgid "&New Snapshot"
msgstr "&Сурати нав"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 52
#: rc.cpp:18
#, no-c-format
msgid "Click this button to take a new snapshot."
msgstr "Барои гирифтани тасвири лаҳзаи нав, ин кнопкаро зер кунед."

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 60
#: rc.cpp:22
#, no-c-format
msgid "&Save As..."
msgstr "&Нигоҳ доштан ҳамчун..."

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 66
#: rc.cpp:26
#, no-c-format
msgid ""
"Click this button to save the current snapshot. To quickly save the snapshot "
"without showing the file dialog, press Ctrl+Shift+S. The filename is "
"automatically incremented after each save."
msgstr ""
"Ин тугмаро пахш намоед барои нигоҳдори дар снепшоти ҳозираи .Барои тез "
"нигоҳдори кардани снепшот бе ягон нишон додани файл диалог,Ctrl+Shift+S-ро "
"пахш намоед.Исмифайл фавран ҷойгузор мешавад баъди чанд бор нигоҳдори."

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 91
#: rc.cpp:30
#, fuzzy, no-c-format
msgid "&Print..."
msgstr "&Сурат..."

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 97
#: rc.cpp:34
#, no-c-format
msgid "Click this button to print the current screenshot."
msgstr "Барои чоп кардани тасвир, ин кнопкаро зер кунед."

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 119
#: rc.cpp:38
#, no-c-format
msgid " sec"
msgstr " сек"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 122
#: rc.cpp:42
#, no-c-format
msgid "No delay"
msgstr "Бе таъхир"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 125
#: rc.cpp:46
#, no-c-format
msgid "Snapshot delay in seconds"
msgstr "   Андармон кардани тасвири лаҳзаӣ дар сонияҳо"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 135
#: rc.cpp:50
#, no-c-format
msgid ""
"<qt>\n"
"This is the number of seconds to wait after clicking the <i>New Snapshot</i> "
"button before taking the snapshot.\n"
"<p>\n"
"This is very useful for getting windows, menus and other items on the screen "
"set up just the way you want.\n"
"<p>\n"
"If <i>no delay</i> is set, the program will wait for a mouse click before "
"taking a snapshot.\n"
"</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"Ин рақами дақиқаҳоест,ки ,барои интизори баъди чанд "
"пахшнамуданиҳо<i>Cнепшоти Нав</i> тугма пеш аз гирифтани снепшот .\n"
"<p>\n"
"Ин хеле зарур аст барои гирифтани тирезаҳо,менюҳо ва дигар қисмҳои дар  "
"тиреза бо хоҳиши шумо гузоштагӣ.\n"
"<p>\n"
"Агар <i>бе ягон таҳхир</i>монда шавад,ин барнома интизори пахшавии пеш аз "
"гирифтани снепшот.\n"
"</p>\n"
"</qt>"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 143
#: rc.cpp:61
#, no-c-format
msgid "Snapshot &delay:"
msgstr "Таъхири &гирифтани тасвири лаҳзаӣ:"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 154
#: rc.cpp:65
#, no-c-format
msgid "Cap&ture mode:"
msgstr "Ҳолати &гирифтан:"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 182
#: rc.cpp:69
#, no-c-format
msgid "Include &window decorations"
msgstr "Декоратсияҳои &тиреза дарбар гиред"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 188
#: rc.cpp:73
#, no-c-format
msgid ""
"When enabled, snapshot of a window will also include the window decorations"
msgstr ""
"Агар мумкин шавад,снепшоти тиреза ҳам дохил мешавад барои  ороиши тирезаҳо"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 194
#: rc.cpp:77
#, no-c-format
msgid "Full Screen"
msgstr "Васеъи экран"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 199
#: rc.cpp:81
#, no-c-format
msgid "Window Under Cursor"
msgstr "Тиреза аз таги курсор"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 204
#: rc.cpp:85
#, no-c-format
msgid "Region"
msgstr "Ноҳия"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 215
#: rc.cpp:89
#, no-c-format
msgid ""
"<qt>Using this menu, you can select from the three following snapshot "
"modes:\n"
"<p>\n"
"<b>Full Screen</b> - captures the entire desktop.<br>\n"
"<b>Window Under Cursor</b> - captures only the window (or menu) that is "
"under the mouse cursor when the snapshot is taken.<br>\n"
"<b>Region</b> - captures only the region of the desktop that you specify. "
"When taking a new snapshot in this mode you will be able to select any area "
"of the screen by clicking and dragging the mouse.</p></qt>"
msgstr ""
"<qt>Бо истифодаи ин меню,шумо метавонед интихоб кунед сето снепшоти "
"меомадагӣ намудҳо:\n"
"<p>\n"
"<b>Тирезаи пурра</b>- тамоми десктопро иҳота мекунад.<br>\n"
"<b>Тиреза дар Поёни Курсор </b>-танҳо тирезаро (ё менюро),ки дар таги "
"курсори мушак кайе,ки снепшот гирифта шавад.<br>\n"
"<b>Ноҳия</b>-танҳо ноҳияи десктопро ки шумо истифода мебаред онро иҳота "
"мекунад. Дар вақте,ки снепшоти навро гирифтан дар ин намуд шумо метавонед "
"интихоб кунед дар ҳар кадом ноҳияи тиреза бо пахш кардан ва ҷунбондани мушак."
"</p></qt>/p>>"

