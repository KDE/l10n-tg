#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 207
#: rc.cpp:1245 rc.cpp:1254 rc.cpp:1278 rc.cpp:1296
#, fuzzy
msgid "Isotone"
msgstr "Йод"

#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 179
#. i18n: tag refitem
