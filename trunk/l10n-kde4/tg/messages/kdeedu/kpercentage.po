#: kpercentage.cpp:75
msgid "Number of tasks:"
msgstr "Миқдори масъалаҳо:"

#: kpercentage.cpp:76
msgid "Level:"
msgstr "Дараҷа:"

#: kpercentage.cpp:77
msgid "Choose an exercise type:"
msgstr "Навъи масъалае интихоб кунед:"

#: kpercentage.cpp:85
#, no-c-format
msgid "x% &of ?? = y"
msgstr "x% &аз ?? = y"

#: kpercentage.cpp:87
#, no-c-format
msgid "x% of &y = ??"
msgstr "x% аз &y = ??"

#: kpercentage.cpp:89
#, no-c-format
msgid "??% o&f x = y"
msgstr "??% а&з x = y"

#: kpercentage.cpp:90
msgid "??"
msgstr "??"

#: kpercentage.cpp:95
msgid "E&xit"
msgstr ""

#: kpercentage.cpp:99
msgid "Easy"
msgstr "Осон"

#: kpercentage.cpp:100
msgid "Medium"
msgstr "Миёна"

#: kpercentage.cpp:101
msgid "Crazy"
msgstr "Мураккаб"

#: kpercentage.cpp:174
msgid "Exercises with base value omitted"
msgstr "Ҳисоби рақаме аз кадом фоизҳо низ гирифта мешаванд"

#: kpercentage.cpp:175
msgid "Exercises with percent value omitted"
msgstr "Ҳисоби фоиз"

#: kpercentage.cpp:176
msgid "Exercises with percentage omitted"
msgstr "Ҳисоби фоизи додашуда аз рақам"

#: kpercentage.cpp:177
msgid "Several exercise types in random"
msgstr "Навъи масъалаҳои гуногун ба тартиби тассодуфӣ"

#: kpercentage.cpp:178
msgid "Choose the number of exercises from 1 to 10."
msgstr "Миқдори машқҳоро аз 1 то 10 ишора намоед."

#: kpercentage.cpp:179
msgid "Choose the level of difficulty."
msgstr "Якеи аз дараҷаҳои мураккаберо интихоб кунед."

#: kpercentage.cpp:180 kpercentage.cpp:191
msgid "Close KPercentage."
msgstr "Пӯшидани KPercentage."

#: kpercentage.cpp:181 kpercentage.cpp:192
msgid "Get some help."
msgstr "Ёрӣ гирифтан."

#: kpercentage.cpp:185
msgid ""
"Click here to start a sequence of exercises where the base value is omitted."
msgstr ""
"Ин тугмаро барои машқи ҳисобкунии рақам, аз кадом фоиз гирифта мешавад, клик "
"кунед."

#: kpercentage.cpp:186
msgid ""
"Click here to start a sequence of exercises where the percent value is "
"omitted."
msgstr "Ин тугмаро барои машқи ҳисобкунии миқдори фоиз пахш кунед."

#: kpercentage.cpp:187
msgid ""
"Click here to start a sequence of exercises where the percentage is omitted."
msgstr "Ин тугмаро барои машқи ҳисобкунии фоизи додашуда аз рақампахш кунед."

#: kpercentage.cpp:188
msgid ""
"Click here to start a sequence of exercises where one value is omitted at "
"random."
msgstr "Ин тугмаро барои машқи навъҳои гуногун низ пахш кунед."

#: kpercentage.cpp:189
msgid "Here you can adjust the number of exercises from 1 to 10."
msgstr "Мақодири машқҳоро аз 1 то 10 ишора кунед."

#: kpercentage.cpp:190
msgid "Choose one of the levels <i>easy</i>, <i>medium</i>, and <i>crazy</i>."
msgstr ""
"Якеи аз дараҷаҳои мураккаберо интихоб кунед:<i>осон</i>, <i>миёна</i> ё "
"<i>мураккаб</i>."

#: main.cpp:30
