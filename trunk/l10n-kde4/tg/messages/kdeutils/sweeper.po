#. i18n: tag string
#. i18n: file kprivacysettings.ui line 106
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 142
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 178
#: rc.cpp:30 rc.cpp:42 rc.cpp:54
msgid "To share with other companies"
msgstr "Барои баён кардани ахбороти худ ба дигар ширкатҳо"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 116
#: rc.cpp:33
msgid "Health Information"
msgstr "Ахборот оиди Саломатӣ"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 125
#: rc.cpp:36
msgid ""
"Warn me when I visit a site that uses my health or medical information: "
msgstr ""
"Ҳангоми ташрифи пойгоҳҳое, ки ахбороти саломатӣ ё тиббии маро истифода "
"мебаранд, огоҳ кунед: "

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 152
#: rc.cpp:45
msgid "Demographics"
msgstr "Демография"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 161
#: rc.cpp:48
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr ""
"Ҳангоми ташрифи пойгоҳҳо маро оиди истифодабарии ахбороти ғайришахсӣ, "
"идентификатсионӣ огоҳ кунед:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 171
#: rc.cpp:51
msgid "To determine my interests, habits or general behavior"
msgstr "Барои муайян кардани шавқҳои ман, одатҳои ман ва рафтори умумӣ"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 188
#: rc.cpp:57
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr ""
"Ҳангоми ташрифи пойгоҳҳо оиди баёни ахбороти ман ба дигар ширкатҳо, маро "
"огоҳ кунед"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 195
#: rc.cpp:60
#, fuzzy
msgid ""
"Warn me when I visit a site that does not let me know what information they "
"have about me"
msgstr ""
"Ҳангоми ташрифи пойгоҳҳое, ки имконияти донистани ахбороти онҳоро оиди ман "
"намедиҳанд, маро огоҳ кунед"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 202
#: rc.cpp:63
msgid "Personal Information"
msgstr "Ахбороти Шахсӣ"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 211
#: rc.cpp:66
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"Ҳангоми ташрифи пойгоҳҳое, ки бо ман алоқаро оиди дигар маҳсулотҳо ё "
"хидматҳо барпо сохта метавонанд, маро огоҳ кунед:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 221
#: rc.cpp:69
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr ""
"Ҳангоми ташрифи пойгоҳҳое, ки ахбороти шахсии маро истифода бурда "
"метавонанд, маро огоҳ кунед, барои:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 231
#: rc.cpp:72
msgid "Determine my habits, interests or general behavior"
msgstr "Муайянкунии одатҳои ман, шавқҳои ман ё рафтори умумӣ"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 243
#: rc.cpp:75
msgid "Via telephone"
msgstr "Бо телефон"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 250
#: rc.cpp:78
msgid "Via mail"
msgstr "Бо пост"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 264
#: rc.cpp:81
msgid "Via email"
msgstr "Бо пости электронӣ"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 271
#: rc.cpp:84
msgid "And do not allow me to remove my contact information"
msgstr "Ва ба ман иҷозати хориҷкунии ахбороти алоҳавиро намедиҳад"

