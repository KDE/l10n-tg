#, fuzzy, kde-format
msgid "&Encoding:"
msgstr "&Ба код даровардан:"

#. i18n: ectx: property (text), widget (QCheckBox, fBookmarksEndtags)
#. i18n: ectx: property (text), widget (QCheckBox)
