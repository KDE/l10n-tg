#: iraction.cpp:110
msgid "Exit mode"
msgstr "Усули хориҷшавӣ"

#: iraction.cpp:112
#, kde-format
msgid "Switch to %1"
msgstr "Гузориш ба %1"

#: iraction.cpp:115
msgid "Just start"
msgstr "Танҳо оғоз кунед"

#: iraction.cpp:130
msgid "Do actions before. "
msgstr "Иҷрои амалиётҳо то. "

#: iraction.cpp:131
msgid "Do actions after. "
msgstr "Иҷрои амалиётҳо пас аз. "

#: iraction.cpp:135
msgid "Auto-start. "
msgstr "Худоғозёбӣ. "

#: iraction.cpp:136
msgid "Repeatable. "
msgstr "Такрорёбанда. "

#: iraction.cpp:137
msgid "Do nothing if many instances. "
msgstr "Ҳеҷ гоҳ накардан ҳангоми будани якчанд намунаҳо. "

#: iraction.cpp:138
msgid "Send to top instance. "
msgstr "Бо намунаи болоӣ фиристед. "

#: iraction.cpp:139
msgid "Send to bottom instance. "
msgstr "Бо намунаи поёнӣ фиристед. "

#: iraction.cpp:139
msgid "Send to all instances. "
msgstr "Бо ҳамаи намунаи фиристед. "
