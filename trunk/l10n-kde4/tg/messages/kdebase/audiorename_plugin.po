#: audio_plugin.cpp:72
#, kde-format
msgid "An older file named '%1' already exists.\n"
msgstr "Як файли дигар бо номи '%1' аллакай мавҷуд аст.\n"

#: audio_plugin.cpp:74
#, kde-format
msgid "A similar file named '%1' already exists.\n"
msgstr "Як файли дигар монанди '%1' аллакай мавҷуд аст.\n"

#: audio_plugin.cpp:76
#, kde-format
msgid "A newer file named '%1' already exists.\n"
msgstr "Як файли дигари нав бо номи '%1' аллакай мавҷуд аст.\n"

#: audio_plugin.cpp:78
msgid "Source File"
msgstr "Файли аслӣ"

#: audio_plugin.cpp:79
msgid "Existing File"
msgstr "Файли мавҷудбуда"

#: audio_plugin.cpp:80
msgid "Would you like to replace the existing file with the one on the right?"
msgstr ""
"Оё шумо мехоҳед файли мавҷудбударо бо файли дар тарафи рост ҷойгузорӣ кунед?"

#: audiopreview.cpp:52
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"Ин файли аудио дар компютери ҷорӣ\n"
"нигоҳ дошта нашуд.\n"
"Барои боркунии файл ин нишонаро зер кунед.\n"

#: audiopreview.cpp:58
msgid "Unable to load audio file"
msgstr "Файли аудио бор карда намешавад"

#: audiopreview.cpp:89
#, kde-format
msgid "Artist: %1"
msgstr "Ҳофиз: %1"

#: audiopreview.cpp:92
#, kde-format
msgid "Title: %1"
msgstr "Сарлавҳа: %1"

#: audiopreview.cpp:95
#, kde-format
msgid "Comment: %1"
msgstr "Тафсилот:%1"

#: audiopreview.cpp:97
#, kde-format
msgctxt "Bitrate: 160 kbits/s"
msgid "Bitrate: %1 %2\n"
msgstr "Суръат: %1 %2\n"

#: audiopreview.cpp:99
#, kde-format
msgid "Sample rate: %1 %2\n"
msgstr "Суръати ҷорӣ: %1 %2\n"

#: audiopreview.cpp:100
msgid "Length: "
msgstr "Давомнокӣ: "
