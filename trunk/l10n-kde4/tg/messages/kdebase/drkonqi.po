#: backtrace.cpp:85
#, qt-format
msgid "Could not generate a backtrace as the debugger '%1' was not found."
msgstr ""
"Ақибҷӯйиро иҷро карда натавонист, барои он ки debugger -ро '%1' ёфта нашуд."

#: debugger.cpp:74
msgid "C&opy"
msgstr "Н&усха"

#: debugger.cpp:95
msgid "Done."
msgstr "Иҷро шуд."

