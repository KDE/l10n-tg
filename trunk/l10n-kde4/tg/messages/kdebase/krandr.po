"Resolution: %1 x %2\n"
"Orientation: %3"
msgstr ""
"Батанзимдарории нав:\n"
"Ҳалнокӣ: %1 x %2\n"
"Тамоюл: %3"

#: randr.cpp:204
#, qt-format
