msgstr "Намоиши &ақрабаки сониявӣ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 35
#: rc.cpp:12
msgid "Show the time in text"
msgstr "Намоиши вақт дар матн"

#. i18n: tag string
#. i18n: file clockConfig.ui line 38
#: rc.cpp:15
