msgstr "Ф&армон:"

#. i18n: tag string
#. i18n: file minicli.ui line 503
#: rc.cpp:310
msgid ""
"Enter the name of the application you want to run or the URL you want to view"
msgstr ""
"Номи барномае ки шумо сар додан мехоҳед ворид намоед ё ин ки адреси URL "
"барои тамошо."

