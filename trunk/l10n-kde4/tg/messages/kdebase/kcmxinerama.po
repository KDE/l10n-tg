#: kcmxinerama.cpp:61
msgid ""
"<h1>Multiple Monitors</h1> This module allows you to configure KDE support "
"for multiple monitors."
msgstr ""
"<h1>Экранҳои Бисёр</h1> Ин воҳид ба шумо имконияти батанзимдарории "
"пуштибонии бисёр экранҳоро барои KDE медиҳад."

#: kcmxinerama.cpp:85
#, qt-format
msgid "Display %1"
msgstr "Намоиш %1"

#: kcmxinerama.cpp:96
msgid "Display Containing the Pointer"
msgstr "Намоиши бо ишоракунанда"

#: kcmxinerama.cpp:109
msgid ""
"<qt><p>This module is only for configuring systems with a single desktop "
"spread across multiple monitors. You do not appear to have this "
"configuration.</p></qt>"
msgstr ""
"<qt><p>Ин воҳид танҳо барои батанзимдарории системаҳо бо мизҳои кории ягона, "
"ки бо воситаи бисёр экранҳо ҷустуҷӯ шудааст. Он дар танзимдарории шумо пайдо "
"намешавад.</p></qt>"

#: kcmxinerama.cpp:185
#, fuzzy
msgid "Some settings may affect only newly started applications."
msgstr "Гузоришҳои шумо танҳо ба замимаҳои нав оғоз ёфта таъсир мебахшанд."

#: kcmxinerama.cpp:185
msgid "KDE Multiple Monitors"
msgstr "KDE Экранҳои Бисёр"

