msgid "Out of memory"
msgstr "Аз ҳофиза берун"

#: kpgp.cpp:274
msgid ""
"You just entered an invalid passphrase.\n"
"Do you want to try again, or cancel and view the message undecrypted?"
msgstr ""
"Шумо гузариши ибораи нодурустро вуруд "
"кардед.\n"
"Шумо мехоҳед боз кушиш кунед, ё ин ки бекор "
"кунед ва хабари рамз накушодаро нигаред?"

