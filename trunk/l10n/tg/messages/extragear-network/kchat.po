msgid "Send &encrypted"
msgstr "Фиристодани &рамзгузошта"

#: kpgp.cpp:436
msgid ""
"You entered an invalid passphrase.\n"
"Do you want to try again, continue and leave the message unsigned, or cancel "
"sending the message?"
msgstr ""
"Шумо иборагузори нодурустро вуруд кардед.\n"
"Шумо мехоҳед ки боз як бори дигар кушиш "
"кунед, давом додаҳед ва хабарро имзо "
"нагузошта партофта равед, ё ин ки "
"фиристодани хабарро бекор кунед?"

#: kpgp.cpp:444 kpgp.cpp:473
msgid "Send &unsigned"
msgstr "Фиристодани &аломатнашуда"

#: kpgp.cpp:466
msgid ""
"_: %1 = 'signing failed' error message\n"
"%1\n"
"Do you want to send the message unsigned, or cancel sending the message?"
msgstr ""
"%1\n"
"Шумо мехоҳед ки хабарро имзо нагузошта "
"фиристед, ё ин ки фиристодани хабарро бекор "
"кунед?"

#: kpgp.cpp:485
msgid ""
"_: %1 = 'bad keys' error message\n"
"%1\n"
"Do you want to encrypt anyway, leave the message unchanged, or cancel sending "
"the message?"
msgstr ""
"%1\n"
"Шумо мехоҳед ки рамз гузоред, хабарро иваз "
"нокарда монед, ё ин ки фиристодани хабарро "
"бекор кунед?"

#: kpgp.cpp:512
msgid ""
"_: %1 = 'missing keys' error message\n"
"%1\n"
"Do you want to leave the message unchanged, or cancel sending the message?"
msgstr ""
"%1\n"
"Шумо мехоҳед ки хабарро иваз нокарда монед, "
"ё ин ки фиристодани хабарро бекор кунед?"

#: kpgp.cpp:519
msgid "&Send unchanged"
msgstr "&Тафтиш ношударо фиристед"

