msgstr "Name=Тугмачаи қулфкунӣ фаъол аст"

#: kbstateapplet/eventsrc:223
msgid ""
"Comment=A lock key (e.g., Caps Lock or Num Lock) has changed its state and and "
"is now active"
msgstr ""
"Comment=Тугмачаи қулфкунӣ (масъалан, Caps Lock ё ин ки Num Lock) ҳолати худро "
"тағйир дода акнун фаъоланд"

#: kbstateapplet/eventsrc:254
msgid "Name=A lock key has been deactivated"
msgstr "Name=Тугмаи қулфкунӣ ғайрифаъол аст"

#: kbstateapplet/eventsrc:281
msgid ""
"Comment=A lock key (e.g., Caps Lock or Num Lock) has changed its state and is "
"now inactive"
msgstr ""
"Comment=Тугмачаи қулфкунӣ (масъалан, Caps Lock ё ин ки Num Lock) ҳолати худро "
"тағйир дода акнун ғайрифаъоланд"

