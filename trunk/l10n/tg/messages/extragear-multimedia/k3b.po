msgstr "Ҳолати AC3"

#: videoEncoding/k3bdivxavset.cpp:94
msgid "Enable this if you want the original digital sound (AC3)."
msgstr "Истифода бурдани нусхаи асли садои рақамӣ (AC3)."

#: videoEncoding/k3bdivxavset.cpp:98
msgid " 64 kbits"
msgstr " 64 КБит/с"

#: videoEncoding/k3bdivxavset.cpp:99
