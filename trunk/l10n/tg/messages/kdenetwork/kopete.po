msgstr "ИСТИФОДАБАРӢ: /clear - Силули мухобиротии фаъоли чатро тоза мекунад."

#: libkopete/kopetecommandhandler.cpp:123
msgid ""
"USAGE: /away [<reason>] - Marks you as away/back for the current account only."
msgstr ""
