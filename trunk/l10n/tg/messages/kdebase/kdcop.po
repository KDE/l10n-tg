#: kdcopwindow.cpp:831
msgid "DCOP call failed"
msgstr "Сигнали DCOP шикаст"

#: kdcopwindow.cpp:833
#, c-format
msgid "<p>DCOP call failed.</p>%1"
msgstr "<p>Сигнали DCOP шикаст.</p>%1"

#: kdcopwindow.cpp:844
msgid ""
"<p>Application is still registered with DCOP; I do not know why this call "
"failed.</p>"
msgstr ""
"<p>Замимаи то ба ҳол бо DCOP номнависӣ шудааст; "
"намедонам, ки барои чи он нодуруст номида "
"шудааст.</p>"

#: kdcopwindow.cpp:856
msgid "<p>The application appears to have unregistered with DCOP.</p>"
msgstr ""
"<p>Замимаи пайдошуда бо DCOP кор карда "
"наметавонад.</p>"

