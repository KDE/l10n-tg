#: konq_run.cc:145
msgid ""
"There appears to be a configuration error. You have associated Konqueror with "
"%1, but it cannot handle this file type."
msgstr ""
"Хатои танзимот. Konqueror барои намоиши файлҳои "
"навъи %1 ишора шудааст, аммо он ин навъи "
"файлро пуштибонӣ накарда истодааст."

#: konq_run.cc:266
msgid "Do you really want to execute '%1'?"
msgstr "Оё мавқеъан мехоҳед '%1'-ро иҷро кунед?"

#: konq_run.cc:280
msgid "Open '%1' using '%2'?"
msgstr "Кушодани '%1' дар '%2'?"

#: konq_run.cc:282
msgid "Open '%1'?"
msgstr "Кушодани '%1'?"

#: konq_run.cc:285
msgid "Save to Disk"
msgstr "Захира кардан ба диск"
