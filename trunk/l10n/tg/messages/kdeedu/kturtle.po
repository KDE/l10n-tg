#: executer.cpp:222
#, c-format
msgid "Call to undefined function: %1."
msgstr "Истифодаи фармони номуайян: %1."

#: executer.cpp:233
msgid "Call to function '%1' with wrong number of parameters."
msgstr "Истифодаи фармони '%1' бо рақами нодуруст аз параметрҳо."

#: executer.cpp:276
msgid "Function %1 did not return a value."
msgstr "Фармони %1 ягон натиҷа барои иҷро надод."

#: executer.cpp:527
msgid "Can only multiply numbers."
msgstr "Танҳо рақамҳо зарб карда метавонад."

#: executer.cpp:538
msgid "Cannot divide by zero."
msgstr "Ба сифр тақсим карда намешавад."

#: executer.cpp:541
msgid "Can only divide numbers."
msgstr "Танҳо рақамҳо тақсим карда метавонад."

#: executer.cpp:553
msgid "Can only subtract numbers."
msgstr "Танҳо рақамҳо тарҳ карда метавонад."

#: executer.cpp:814
msgid "The penwidth cannot be set to something smaller than 1, or bigger than 10000."
msgstr "Параметри ғафсии қалам бо рақамҳои на каму 1 на зиёду 10000 истифода баред."

#: executer.cpp:841
msgid "The parameters of function %1 must be within range: 0 to 350."
msgstr "Параметри фармони %1 бо рақамҳои аз 0 то 350 истифода баред."

#: executer.cpp:879
msgid "The parameters of the %1 command must be numbers in the range: 1 to 10000."
msgstr "Параметри фрамони %1 бо рақамҳои на каму 1 на зиёду 10000 истифода баред."

#: executer.cpp:919 executer.cpp:940
msgid "The parameters of the %1 command must be numbers in the range: 0 to 255."
msgstr "Параметри фармони %1 бо рақамҳои аз 0 то 255 истифода баред."

#: executer.cpp:978
msgid "The print command needs input"
msgstr "Барои чоп шумо бояд фармони 'print' истифода баред"

#: executer.cpp:1058
msgid "The %1 command accepts no parameters."
msgstr "Фармони %1 параметрҳоро қабул намекунад."

#: executer.cpp:1070
msgid ""
"_n: The %1 command was called with %2 but needs 1 parameter.\n"
"The %1 command was called with %2 but needs %n parameters."
msgstr ""
"Фармони %1 бо %2 истифода шуд, лекин ин бояд бо 1 параметр истифода шавад.\n"
"Фармони %1 бо %2 истифода шуд, лекин ин бояд бо %n параметр истифода шавад."

#: executer.cpp:1074
msgid ""
"_n: The %1 command was called with %2 but only accepts 1 parameter.\n"
"The %1 command was called with %2 but only accepts %n parameters."
msgstr ""
"Фармони %1 бо %2 истифода шуд, лекин ин танҳо 1 параметр қабул мекунад.\n"
"Фармони %1 бо %2 истифода шуд, лекин ин танҳо %n параметр қабул мекунад."

#: executer.cpp:1095
msgid "The %1 command only accepts a string as its parameter."
msgstr "Фармони %1 танҳо сатр бо параметри худ қабул мекунад."

#: executer.cpp:1097
msgid "The %1 command only accepts strings as its parameters."
msgstr "Фармони %1 танҳо сатрҳо бо параметрҳои худ қабул мекунад."

#: executer.cpp:1102
msgid "The %1 command only accepts a number as its parameter."
msgstr "Фармони %1 танҳо рақам бо параметри худ қабул мекунад."

#: executer.cpp:1104
msgid "The %1 command only accepts numbers as its parameters."
msgstr "Фармони %1 танҳо рақамҳо бо параметрҳои худ қабул мекунад."

