#: main.cc:304
#, c-format
msgid "Related Words - %1"
msgstr "Калимаҳои алоқадор - %1"

#: main.cc:399
msgid ""
"The thesaurus file '%1' was not found. Please use 'Change Language...' to "
"select a thesaurus file."
msgstr ""
"Файли луғат'%1' ёфта нашуд.Барои интихоби "
"файли луғат'Дигаргункунии забон...'истифода "
"баред."

#: main.cc:418
msgid "Failed to execute grep."
msgstr "Хатогии иҷрокунии барномаи grep."

#: main.cc:430
#, c-format
msgid "<b>Error:</b> Failed to execute grep. Output:<br>%1"
msgstr ""
"<b>Хатоги::</b> Сар додани програмаи grep "
"номумкин аст. Хабаррасони:<br>%1"

#: main.cc:589
msgid "Synonyms/Hypernyms - Ordered by Frequency"
msgstr ""
"Синонимҳо /гиперболҳо -ба ҷафсии "
"такроркуни ҷойгир кардан."

#: main.cc:590
msgid "Synonyms - Ordered by Similarity of Meaning (verbs only)"
msgstr ""
"Синонимҳо - бо маъни ҷойгир кардан (танҳо "
"барои феъл)"

#: main.cc:591
msgid "Antonyms - Words with Opposite Meanings"
msgstr "Антонимҳо - калимаҳои муқобилмаъно"

#: main.cc:592
#, c-format
msgid "Hyponyms - ... is a (kind of) %1"
msgstr "Гиперболҳо - ...ин(ба вуҷуд меояд аз)%1"

#: main.cc:593
msgid "Meronyms - %1 has a ..."
msgstr "Маҷозҳо - %1 доранд...."

#: main.cc:595
#, c-format
msgid "Holonyms - ... has a %1"
msgstr "Галонимҳо -... %1доранд"

#: main.cc:596
msgid "Attributes"
msgstr "Хусусиятҳо"

#: main.cc:597
msgid "Cause To (for some verbs only)"
msgstr "Интихоб аз(танҳо барои баъзе феълҳо)"

#: main.cc:598
msgid "Verb Entailment (for some verbs only)"
msgstr "Шаклҳои феъл(танҳо барои баъзе фелҳо)."

#: main.cc:599
msgid "Familiarity & Polysemy Count"
msgstr "Миқдори ҳамрешаҳои монанд"

#: main.cc:601
msgid "Verb Frames (examples of use)"
msgstr "Гуруҳои феъл(мисолҳо барои истифода)"

#: main.cc:602
msgid "List of Compound Words"
msgstr "Рӯйхати калимаҳои мураккаб"

#: main.cc:603
msgid "Overview of Senses"
msgstr "Тафсири ҳис"

#: main.cc:631
msgid ""
"<b>Error:</b> Failed to execute WordNet program 'wn'. WordNet has to be "
"installed on your computer if you want to use it, and 'wn' has to be in your "
"PATH. You can get WordNet at <a href=\"http://www.cogsci.princeton.edu/~wn/\">"
"http://www.cogsci.princeton.edu/~wn/</a>. Note that WordNet only supports the "
"English language."
msgstr ""
"<b>Хатоги:</b> Барномаи WordNet'wn'иҷро кардан "
"номумкин аст. WordNet бояд дар компютери шумо "
"барқарор шавад. Барои дуруст ба кор "
"андохтани барнома,зарур аст роҳ то "
"файли'wn'дар муҳити тағирёбандаи PATH нишон "
"дода шавад.Шумо метавонед барономаи WordNet бо "
"адреси href=\"http://www.cogsci.princeton.edu/~wn/\">"
"http://www.cogsci.princeton.edu/~wn/</a>дарёфтан. Қайд кардан "
"шарт аст ,киWordNet танҳо забони англисиро "
"нигоҳ дорад."

#: main.cc:649
#, c-format
msgid "<b>Error:</b> Failed to execute WordNet program 'wn'. Output:<br>%1"
msgstr ""
"<b>Хатоги:</b> БарномаиWordNet 'wn'. Хабаррасонӣ:<br>"
"%1"

#: main.cc:656
msgid "No match for '%1'."
msgstr "Монанди ба '%1' нест."
