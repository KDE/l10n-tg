#: xml_doc.cc:1848
#, no-c-format
msgid "INTRATE(settlement; maturity; investment; redemption; basis)"
msgstr "INTRATE(таърихи ҳисоб; таърихи адо; ҳосили ҷамъ,гашта гирифтан; базис)"

