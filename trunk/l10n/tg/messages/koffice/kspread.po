#: xml_doc.cc:5706
#, no-c-format
msgid "TOGGLE(\"hello\") returns \"HELLO\""
msgstr "TOGGLE(\"hello\") бозгаштан \"HELLO\""

#. i18n: file extensions/text.xml line 426
#: xml_doc.cc:5709
#, no-c-format
msgid "TOGGLE(\"HELLO\") returns \"hello\""
msgstr "TOGGLE(\"HELLO\") бозгаштан \"hello\""

#. i18n: file extensions/text.xml line 427
#: xml_doc.cc:5712
#, no-c-format
msgid "TOGGLE(\"HeLlO\") returns \"hElLo\""
msgstr "TOGGLE(\"HeLlO\") бозгаштан \"hElLo\""

#. i18n: file extensions/text.xml line 441
#: xml_doc.cc:5718
#, no-c-format
