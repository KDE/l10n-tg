#: xml_doc.cc:2430
#, no-c-format
msgid "N(value)"
msgstr "N(маъно)"

#. i18n: file extensions/information.xml line 17
#: xml_doc.cc:2433
#, no-c-format
msgid "N(3.14) returns 3.14"
msgstr "N(3.14) бозгаштан 3.14"

