#: kcmmediacontrol.cpp:197
msgid ""
"<h1>MediaControl</h1> This module allows you to configure the MediaControl "
"applet for KDE's panel."
msgstr ""
"<h1>Аз идора гузаштн</h1>Ин воҳид ба шумо "
"интихоби пайкардаро аз идора гузаштан ба "
"панели KDE ёри медиҳад."

#: rc.cpp:1
msgid "KCMMediaControlWidget"
msgstr "KCM  Аз идора паҳнтар гузаштан"

#: rc.cpp:4
msgid "General"
msgstr "Асосӣ"

#: rc.cpp:5
msgid "Media-Player"
msgstr "Медиа-Плейр"

#: rc.cpp:6
msgid "Select the multimedia-player you are using in this box"
msgstr ""
"Мультимедиа- бозингарро интихоб кунед "
"кадомеашро шумо дар ин қуттӣ истифода "
"бурда истодаед. "

#: rc.cpp:8
msgid "Mousewheel scrolling amount:"
msgstr "Теъдоди паймоиши мӯш:"

#: rc.cpp:9
msgid "Sets the amount a mousewheel will scroll in the current file"
msgstr ""
"Гузоштани теъдод паймонии мӯш дар ҷорӣи "
"файл мегардад"

#: rc.cpp:10
msgid "Themes"
msgstr "Мавзӯъҳо"

#: rc.cpp:11
msgid "Use themes"
msgstr "Мавзӯъҳоро истифода баред"

#: rc.cpp:12
msgid "default"
msgstr "пешфарз"

#: rc.cpp:13
msgid "Preview"
msgstr " Пешаки аз назар гузаронидан"

#: rc.cpp:14
msgid "Shows you how the selected theme will look"
msgstr ""
"Ба шумо нишон медиҳад ки  маънои "
"ҷудокардашгуда  чихел тамошо карда мешавад"

