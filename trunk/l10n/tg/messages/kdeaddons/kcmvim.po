msgid "KDE Vim Embedding Control Module"
msgstr "KDE Vim Дар дарун сохтани Контрол Модул"

#: kcmvim.cpp:44
msgid "The Vim KPart is developed by the KVim Team."
msgstr "Vim KPart ин  бо ҳамроҳи Vim KPart кушода шудааст."

#: kcmvim.cpp:89 kcmvim.cpp:109 kcmvim.cpp:152
msgid "KVim - Vim-KDE"
