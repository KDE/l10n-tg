#. i18n: file signatureconfigurationdialog.ui line 353
#: rc.cpp:671
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Opaque signed messages</h1>\n"
"When this option is selected, both the signature and the signed data will be "
"encoded into one ASN.1 block. Messages will be readable only by Mail User "
"Agents supporting ASN.1 decoding.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Иттилоотҳои имзошудаи ғайришаффоф</h1>\n"
"Агар ин параметр сабт шуда бошад, имзо ва маълумотҳои имзошуда дар як блоки "
"ASN.1 рамзгузорӣмешаванд. Иттилоотро метавон танҳо бо он барномаи почтавӣ "
"бихонд, ки он аз нав рамзгузории ASN.1-ро пуштибонӣ кунад.\n"
"</qt>"

