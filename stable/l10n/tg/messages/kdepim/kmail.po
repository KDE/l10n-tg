#. i18n: file signatureconfigurationdialog.ui line 571
#: rc.cpp:767 rc.cpp:997
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn When Trying To Send Unsigned Messages</h1>\n"
"If this box is checked, you will be warned when you try to send parts of or the "
"whole message unsigned.\n"
"<p>\n"
"It is recommended to leave this option turned on for maximum integrity.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Огоҳонидан ҳангоми сайъи фиристодани иттилоотҳои имзонашуда</h1>\n"
"Агар ин параметр сабт шуда бошад, ҳангоми сайъи фиристодани иттилоотҳои "
"имзонашуда ё қисмҳои иттилоот, огоҳӣ хурӯҷ мешавад.\n"
"<p>\n"
"Барои комилии максимум, ин параметрро фаъол мондан тавсия мешавад.\n"
"</qt>"

#. i18n: file signatureconfigurationdialog.ui line 579
#: rc.cpp:775
#, fuzzy, no-c-format
msgid "Warn if CA certificate e&xpires in less than:"
msgstr "О&гоҳӣ кардан оиди гузаштани мӯҳлати амали сертификати СА кам аз"

#. i18n: file signatureconfigurationdialog.ui line 593
#: rc.cpp:781 rc.cpp:809 rc.cpp:823
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn If Certificate Expires</h1>\n"
"If this option is checked, then you will be warned when trying to use a "
"certificate for signing that expires within the specified amount of days.\n"
"<p>\n"
"It is recommended to keep this option turned on to avoid using certificates "
"that expire in the near future.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Огоҳонидан оиди гузаштани мӯҳлати амали сертификат</h1>\n"
"Агар ин параметр сабт шуда бошад, шумо ҳангоми сайъи истифодаи сертификат, ки "
"мӯҳлати амали он кам аз мақодири рӯзи ишорашуда мегузарад, огоҳӣ қабул "
"мекунед.\n"
"<p>\n"
"Барои истифода набурдани сертификат, ки мӯҳлати амали он дар оянда хоҳад "
"гузашт, ин параметрро фаъол сохтан тавсия мешавад.\n"
"</qt>"

#. i18n: file signatureconfigurationdialog.ui line 618
#: rc.cpp:795 rc.cpp:1048
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn If Signature Certificate Expires</h1>\n"
"Select the minimum number of days the signature certificate should be valid "
"without issuing a warning.\n"
"<p>\n"
"The recommended SPHINX setting is 14 days.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Огоҳонидан оиди гузаштани мӯҳлати амали сертификати имзо</h1>\n"
"Мақодири рӯзро то хотима ёфтани мӯҳлати амали сертификат, ки дар он муддат бояд "
"огоҳӣ хурӯҷ шавад, ишора кунед.\n"
"<p>\n"
"Аҳамияти SPHINX-и тавсияшаванда - 14 рӯз аст.\n"
"</qt>"

#. i18n: file signatureconfigurationdialog.ui line 626
