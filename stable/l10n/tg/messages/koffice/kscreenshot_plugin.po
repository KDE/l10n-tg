#: screenshot.cpp:54
msgid "&Screenshot..."
msgstr "&Сурат..."

#~ msgid "Thumbnail of the current snapshot"
#~ msgstr "Суратчаи ҳозираи снепшот"

#~ msgid ""
#~ "This is a thumbnail of the current snapshot.\n"
#~ "\n"
#~ "The image can be dragged to another application or document to copy the full screenshot there. Try it with the Konqueror file manager."
#~ msgstr ""
#~ "Ин суратчаи ҳозира снепшот\n"
#~ "\n"
#~ "Ин тасвир ба дигар апплекасия ё документ кучондан мумкин аст барои пурранусха бардоштани скриншот дар онҷо.Инро бо файли менеҷери Konqueror кунед."

#~ msgid "&New Snapshot"
#~ msgstr "&Сурати нав"

#~ msgid "Click this button to take a new snapshot."
#~ msgstr "Барои гирифтани тасвири лаҳзаи нав, ин кнопкаро зер кунед."

#~ msgid "&Save As..."
#~ msgstr "&Нигоҳ доштан ҳамчун..."

#~ msgid "Click this button to save the current snapshot. To quickly save the snapshot without showing the file dialog, press Ctrl+Shift+S. The filename is automatically incremented after each save."
#~ msgstr "Ин тугмаро пахш намоед барои нигоҳдори дар снепшоти ҳозираи .Барои тез нигоҳдори кардани снепшот бе ягон нишон додани файл диалог,Ctrl+Shift+S-ро пахш намоед.Исмифайл фавран ҷойгузор мешавад баъди чанд бор нигоҳдори."

#~ msgid "Click this button to print the current screenshot."
#~ msgstr "Барои чоп кардани тасвир, ин кнопкаро зер кунед."

#~ msgid " sec"
#~ msgstr " сек"

#~ msgid "No delay"
#~ msgstr "Бе таъхир"

#~ msgid "Snapshot delay in seconds"
#~ msgstr "   Андармон кардани тасвири лаҳзаӣ дар сонияҳо"

#~ msgid ""
#~ "<qt>\n"
#~ "This is the number of seconds to wait after clicking the <i>New Snapshot</i> button before taking the snapshot.\n"
#~ "<p>\n"
#~ "This is very useful for getting windows, menus and other items on the screen set up just the way you want.\n"
#~ "<p>\n"
#~ "If <i>no delay</i> is set, the program will wait for a mouse click before taking a snapshot.\n"
#~ "</p>\n"
#~ "</qt>"
#~ msgstr ""
#~ "<qt>\n"
#~ "Ин рақами дақиқаҳоест,ки ,барои интизори баъди чанд пахшнамуданиҳо<i>Cнепшоти Нав</i> тугма пеш аз гирифтани снепшот .\n"
#~ "<p>\n"
#~ "Ин хеле зарур аст барои гирифтани тирезаҳо,менюҳо ва дигар қисмҳои дар  тиреза бо хоҳиши шумо гузоштагӣ.\n"
#~ "<p>\n"
#~ "Агар <i>бе ягон таҳхир</i>монда шавад,ин барнома интизори пахшавии пеш аз гирифтани снепшот.\n"
#~ "</p>\n"
#~ "</qt>"

#~ msgid "Snapshot &delay:"
#~ msgstr "Таъхири &гирифтани тасвири лаҳзаӣ:"

#~ msgid "Cap&ture mode:"
#~ msgstr "Ҳолати &гирифтан:"

#~ msgid "Include &window decorations"
#~ msgstr "Декоратсияҳои &тиреза дарбар гиред"

#~ msgid "When enabled, snapshot of a window will also include the window decorations"
#~ msgstr "Агар мумкин шавад,снепшоти тиреза ҳам дохил мешавад барои  ороиши тирезаҳо"

#~ msgid "Full Screen"
#~ msgstr "Васеъи экран"

#~ msgid "Window Under Cursor"
#~ msgstr "Тиреза аз таги курсор"

#~ msgid "Region"
#~ msgstr "Ноҳия"

#~ msgid ""
#~ "<qt>Using this menu, you can select from the three following snapshot modes:\n"
#~ "<p>\n"
#~ "<b>Full Screen</b> - captures the entire desktop.<br>\n"
#~ "<b>Window Under Cursor</b> - captures only the window (or menu) that is under the mouse cursor when the snapshot is taken.<br>\n"
#~ "<b>Region</b> - captures only the region of the desktop that you specify. When taking a new snapshot in this mode you will be able to select any area of the screen by clicking and dragging the mouse.</p></qt>"
#~ msgstr ""
#~ "<qt>Бо истифодаи ин меню,шумо метавонед интихоб кунед сето снепшоти меомадагӣ намудҳо:\n"
#~ "<p>\n"
#~ "<b>Тирезаи пурра</b>- тамоми десктопро иҳота мекунад.<br>\n"
#~ "<b>Тиреза дар Поёни Курсор </b>-танҳо тирезаро (ё менюро),ки дар таги курсори мушак кайе,ки снепшот гирифта шавад.<br>\n"
#~ "<b>Ноҳия</b>-танҳо ноҳияи десктопро ки шумо истифода мебаред онро иҳота мекунад. Дар вақте,ки снепшоти навро гирифтан дар ин намуд шумо метавонед интихоб кунед дар ҳар кадом ноҳияи тиреза бо пахш кардан ва ҷунбондани мушак.</p></qt>/p>>"

#~ msgid "Tools"
#~ msgstr "Асбобҳо"
