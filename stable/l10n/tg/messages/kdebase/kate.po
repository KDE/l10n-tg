#: app/katemwmodonhddialog.cpp:244
msgid ""
"The diff command failed. Please make sure that diff(1) is installed and in your "
"PATH."
msgstr ""
"Нуқсони дастури diff. Мутмаин шавед, ки барномаиdiff(1) насб шудааст ва дар "
