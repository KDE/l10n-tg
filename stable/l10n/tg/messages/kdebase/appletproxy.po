#: appletproxy.cpp:65
msgid "The applet's desktop file"
msgstr "Файли .desktop,-и апплет"

#: appletproxy.cpp:66
msgid "The config file to be used"
msgstr "Файли танзимот барои истифодабарӣ"

#: appletproxy.cpp:67
msgid "DCOP callback id of the applet container"
msgstr "Идентификатори DCOP барои қуттии апплет"

#: appletproxy.cpp:73 appletproxy.cpp:75
msgid "Panel applet proxy."
msgstr "Савҳаи барномаи proxy."

#: appletproxy.cpp:97
msgid "No desktop file specified"
msgstr "Файли мизи корӣ нишон дода нашудааст"

#: appletproxy.cpp:132
msgid ""
"The applet proxy could not be started due to DCOP communication problems."
msgstr "Наметавон проксии апплетро фаъол намуд. Хатои алоқа бо DCOP."

#: appletproxy.cpp:133 appletproxy.cpp:141 appletproxy.cpp:174
#: appletproxy.cpp:195 appletproxy.cpp:297 appletproxy.cpp:319
msgid "Applet Loading Error"
msgstr "Хатои боргирии апплет"

#: appletproxy.cpp:140
msgid ""
"The applet proxy could not be started due to DCOP registration problems."
msgstr "Наметавон проксии апплетро фаъол намуд. Хатои бақайдгирӣ ба DCOP."

#: appletproxy.cpp:173
#, c-format
msgid "The applet proxy could not load the applet information from %1."
msgstr "Иттилооти оиди апплет дар проксии апплетҳо аз %1 пурбор карда нашуд."

#: appletproxy.cpp:194
msgid "The applet %1 could not be loaded via the applet proxy."
msgstr "Апплети %1 бо ёрии проксии апплетҳо пурбор карда нашуд."

#: appletproxy.cpp:296
msgid ""
"The applet proxy could not dock into the panel due to DCOP communication "
"problems."
msgstr "Проксии апплетҳо дар панел сохта нашуд. Хатои алоқа бо DCOP."

#: appletproxy.cpp:318
msgid "The applet proxy could not dock into the panel."
msgstr "Натавонистам проксии апплетҳоро дар панел ҹой кунам."

