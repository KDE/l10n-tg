msgstr "Таркиби кнопка"

#: kcmlayout.cpp:854
msgid "Shift with numpad keys works as in MS Windows."
msgstr "Кнопкаҳои Shift бо numpad монанди MS Windows кор мекунад."

#: kcmlayout.cpp:855
msgid "Special keys (Ctrl+Alt+<key>) handled in a server."
