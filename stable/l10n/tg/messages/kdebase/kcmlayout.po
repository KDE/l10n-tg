msgid "Left Win-key changes group"
msgstr "Кнопкаи Win-и чап гурӯҳро ивваз мекунад"

#: kcmlayout.cpp:820
msgid "Right Win-key changes group"
msgstr "Кнопкаи Win-и рост гурӯҳро ивваз мекунад"

