#: drkonqi/presets/developerrc:165
msgid ""
"Name=The application %progname (%appname), pid %pid, crashed and caused the "
"signal %signum (%signame)."
msgstr ""
"Name=Дар барномаи %progname (%appname), аз амали id-и %pid, нуқсони хатарнок ба "
"амал омад, ки сигнали %signum (%signame)-ро роҳ дод."

#: drkonqi/presets/developerrc:240
msgid ""
"Name=You might want to fix your program. Take a look at the backtrace tab."
msgstr ""
"Name=Шояд шумо мехоҳед барномаро тасҳеҳ кунед. Ҳисоботи тасҳеҳгарро аз назар "
"гузаронед."

