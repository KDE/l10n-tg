msgstr ""
"Name=Дар барномаи %progname (%appname), аз амали id-и %pid, нуқсони хатарнок ба "
"амал омад, ки сигнали %signum (%signame)-ро роҳ дод."

#: kdebase/drkonqi/presets/developerrc:231
msgid ""
"Name=You might want to fix your program. Take a look at the backtrace tab."
