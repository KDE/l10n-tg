msgstr "Name=SIGILL"

#: drkonqi/presets/developerrc:315
msgid "Comment=Illegal instruction."
msgstr "Comment=Дастурамали нораво."

#: drkonqi/presets/developerrc:393 drkonqi/presets/enduserrc:374
msgid "Name=SIGABRT"
msgstr "Name=SIGABRT"

#: drkonqi/presets/developerrc:395
msgid "Comment=Aborted."
msgstr "Comment=Қатъ гардид."

#: drkonqi/presets/developerrc:473 drkonqi/presets/enduserrc:449
msgid "Name=SIGFPE"
msgstr "Name=SIGFPE"

#: drkonqi/presets/developerrc:475
msgid "Comment=Floating point exception."
msgstr "Comment=Ҳолати истисно ҳангоми ҳисоб намудан бо нуқтаи шиновар."

#: drkonqi/presets/developerrc:546 drkonqi/presets/enduserrc:525
msgid "Name=SIGSEGV"
