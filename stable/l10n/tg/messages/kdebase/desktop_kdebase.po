#: kdebase/drkonqi/presets/developerrc:304
msgid "Comment=Illegal instruction."
msgstr "Comment=Дастурамали нораво."

#: kdebase/drkonqi/presets/developerrc:379
#: kdebase/drkonqi/presets/enduserrc:356
msgid "Name=SIGABRT"
msgstr "Name=SIGABRT"

#: kdebase/drkonqi/presets/developerrc:382
msgid "Comment=Aborted."
msgstr "Comment=Қатъ гардид."

#: kdebase/drkonqi/presets/developerrc:457
#: kdebase/drkonqi/presets/enduserrc:428
msgid "Name=SIGFPE"
msgstr "Name=SIGFPE"

#: kdebase/drkonqi/presets/developerrc:460
msgid "Comment=Floating point exception."
msgstr "Comment=Ҳолати истисно ҳангоми ҳисоб намудан бо нуқтаи шиновар."

#: kdebase/drkonqi/presets/developerrc:528
#: kdebase/drkonqi/presets/enduserrc:501
msgid "Name=SIGSEGV"
msgstr "Name=SIGSEGV"

#: kdebase/drkonqi/presets/developerrc:531
