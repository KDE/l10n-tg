#: mediacontrol.cpp:98 mediacontrol.cpp:151 mediacontrolconfig.cpp:47
msgid "MediaControl"
msgstr "Идоракунии мултимедиа"

#: mediacontrol.cpp:100
msgid "A small control-applet for various media players"
msgstr ""
"На он қадар апплети калон барои "
"сафҳамонакҳои гуногун"

#: mediacontrol.cpp:114
msgid "Main Developer"
msgstr "Маъдани асосӣ"

#: mediacontrol.cpp:116
msgid "Initial About-Dialog"
msgstr "Маълумоти ибтидоӣ \"дар бораи барнома\""

#: mediacontrol.cpp:119 mediacontrol.cpp:121
msgid "Button-Pixmaps"
msgstr "Тасвири тугмаҳо"

#: mediacontrol.cpp:123
msgid "Fix for Noatun-Support"
msgstr ""
"Ислоҳ намудани хатогиҳо ҳангоми кор "
"кардан бо Noatun"

#: mediacontrol.cpp:125
msgid "Fix for Vertical Slider"
msgstr ""
"Ислоҳ намудани хатогиҳо ҳангоми кор "
"кардан бо пешаки ранг молида шуда"

#: mediacontrol.cpp:127
msgid "Volume Control Implementation"
msgstr "Иҷрокунии идоракунандаи баландии овоз"

#: mediacontrol.cpp:129
msgid "Fix for JuK-Support"
msgstr ""
"Ислоҳ намудани хатогиҳо ҳангоми кор "
"кардан бо Noatun"

#: mediacontrol.cpp:152
msgid "Configure MediaControl..."
msgstr "Идоракунандаи медияро созед..."

#: mediacontrol.cpp:154
msgid "About MediaControl"
msgstr "Дар бораи апплет \"Идораи мултимедиа\""

#: mediacontrol.cpp:212
msgid "Start the player"
msgstr "Сар додани сафҳамонак"

#: mediacontrol.cpp:417
msgid "There was trouble loading theme %1. Please choose a different theme."
msgstr ""
"Ҳангоми пурборкунии мавзӯи %1 масъалае ба "
"вуҷуд омад. Марҳамат карда дигар мавзӯро "
"интихоб намоед."

#: playerInterface.cpp:33
msgid "Could not start media player."
msgstr ""
"Сафҳамонаки овоздорро сар дода "
"натавонистам."

