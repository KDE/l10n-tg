#: vimpart_factory.cpp:77
msgid "VimPart"
msgstr "VimPart"

#: vimpart_factory.cpp:78
msgid "VimPart - Vim embedded in KDE"
msgstr "VimPart - Vim, дар даруни KDE сохта шудааст"

#: vimpart_factory.cpp:80
msgid "(c) 2002"
msgstr "(c) 2002"

#: vimpart_factory.cpp:81
msgid "Initial Version"
msgstr "Ривояти ибтидоӣ"

#: vimpart_factory.cpp:82
msgid "KTextEditor implementation; improvements"
msgstr "Баамалбарории KTextEditor, беҳтаркунӣ"

#: vimpart_shell.cpp:39
msgid "&Open File..."
msgstr "&Кушодани файл..."

#: vimpart_shell.cpp:119
msgid "No libvimpart found."
msgstr "Libvimpart ёфта нашуд."

#: vimpart_shell.cpp:148
msgid "Files to load"
msgstr "Пурборкунии файлҳо"

#: vimpart_shell.cpp:152
msgid "Test Shell for the vim kpart."
msgstr "Лифофаи санҷишӣ барои қисмати vim."

#: vimview.cpp:138
msgid "Save the current document"
msgstr "Нигоҳ доштани ҳуҷҷати зерин"

#: vimview.cpp:142
msgid "Revert the most recent editing actions"
msgstr "Такрор кардани кори охирин"

#: vimview.cpp:146
msgid "Revert the most recent undo operation"
msgstr "Такрор кардани кори барҳамдода"

#: vimview.cpp:150
msgid "Cut the selected text and move it to the clipboard"
msgstr ""
"Матни ҷудо карда шударо буридан ва онро ба буфери мубодила нусха бардоштан"

#: vimview.cpp:154
msgid "Paste previously copied or cut clipboard contents"
msgstr "Дохилии буфери мубодиларо гузоштан"

#: vimview.cpp:159
msgid "Closes the current document."
msgstr "Пӯшидани ҳуҷҷати зерин."

#: vimview.cpp:163
msgid ""
"Use this command to copy the currently selected text to the system clipboard."
msgstr ""
"Ин фармонро барои нусха бардории матни ҷудо карда шударо дар буфери мубодила "
"истифода баред."

#: vimview.cpp:167
msgid "Save the current document to disk, with a name of your choice."
msgstr ""
"Нигоҳ доштани ҳуҷҷати зерин дар диски с бо номе, ки шумо интихоб мекунед."

#: vimview.cpp:171
msgid ""
"This command opens a dialog and lets you choose a line that you want the cursor "
"to move to."
msgstr ""
"Ин фармон гуфтугӯро мекушояд ва ба шумо имкон медиҳад, ки кадом сатре, ки шумо "
"ҳаракат додан мехоҳед ба воситаи курсор имконоти интихоб намуданро доред."

#: vimview.cpp:175
msgid "Select the entire text of the current document."
msgstr "Ҳамаи матни ҳуҷҷати зеринро ҷудо кардан."

#: vimview.cpp:179
msgid "Find text in the current document."
msgstr "Ёфтани матн дар ҳуҷҷати зерин."

#: vimwidget.cpp:83 vimwidget.cpp:93
msgid "Please use the KDE control module and configure the Vim component."
msgstr ""
"Модули дурусткунии KDE-ро барои дурусткунии қисмати Vim истифода баред."

#: vimwidget.cpp:83 vimwidget.cpp:93 vimwidget.cpp:102 vimwidget.cpp:110
#: vimwidget.cpp:117
msgid "Vim Error"
msgstr "Хато Vim"

#: vimwidget.cpp:98
msgid ""
"\n"
"Unable to start the Vim editing control. Use the KDE Control Center to "
"reconfigure and test your Vim component.\n"
msgstr ""
"\n"
"Наметавон муҳаррири назораткунандаи Vim-ро сар диҳам. Назораткунандаи Марказии "
"KDE-ро бозсозиш намоед ва санҷиш намудани ҷузъи Vim-ро ҳам иҷро намоед.\n"

#: vimwidget.cpp:101
msgid ""
"Please use the KDE control module and configure the Vim component.\n"
msgstr ""
"Марҳамат карда назораткунандаи KDE-ро истифода намоед ва ҷузъи пайкарабандро "
"ҳам.\n"

#: vimwidget.cpp:109
msgid ""
"Vim executable '%1' does not exist or is not accessible.\n"
msgstr ""
"Барномаи '%1' вуҷуд надорад ё ин ки дастрас нест.\n"

#: vimwidget.cpp:116
msgid ""
"Vim executable '%1' is not executable.\n"
msgstr ""
"Барномаи '%1' файли иҷрокунанда намебошад.\n"

#: xvim_win.cpp:25
msgid "Select Mode"
msgstr "Интихоби ҳолат"

#: xvim_win.cpp:27
msgid "Evaluate expressions"
msgstr "Арзиш намудани баён"

#: xvim_win.cpp:29
msgid "Send keys"
msgstr "Параметрҳо"

#: xvim_win.cpp:55
#, c-format
msgid "Error code: %1"
msgstr "Коди хато: %1"

#: xvim_win.cpp:57
#, c-format
msgid "Result: %1"
msgstr "Натиҷа: %1"

#: xvimstart.cpp:32
msgid "XVIM"
msgstr "XVIM"

#: xvimstart.cpp:32
msgid "A Vim remote command tool"
msgstr "Асбоби фармони Vim-ро дур намоед"
