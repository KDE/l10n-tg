msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "youth_opportunities@tajik.net,rkovacs@khujand.org"

#: kdesu.cpp:94
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:95
msgid "Runs a program with elevated privileges."
msgstr "Запустить программу с повышенными привилегиями."

#: kdesu.cpp:97
msgid "Copyright (c) 1998-2000 Geert Jansen, Pietro Iglio"
msgstr "Copyright (c) 1998-2000 Geert Jansen, Pietro Iglio"

#: kdesu.cpp:98
msgid "Geert Jansen"
msgstr "Geert Jansen"

#: kdesu.cpp:98
msgid "Maintainer"
msgstr "Тасдиқкунанда"

#: kdesu.cpp:100
msgid "Pietro Iglio"
msgstr "Pietro Iglio"

#: kdesu.cpp:100
msgid "Original author"
msgstr "Муаллифи аслӣ"

#: kdesu.cpp:109
msgid "Specifies the command to run as separate arguments"
msgstr "Фармонро барои иҷро кардан ҳамчун далели ҷудоӣ муайян мекунад"

#: kdesu.cpp:110
msgid "Specifies the command to run as one string"
msgstr "Фармонро барои иҷро кардан ҳамчун як ҷараён муайян мекунад"

#: kdesu.cpp:111
msgid "Run command under target uid if <file> is not writable"
msgstr ""
"Запустить программу под заданным uid, если нет права на запись в <file>"

#: kdesu.cpp:112
msgid "Specifies the target uid"
msgstr "Указывает uid запуска программы"

#: kdesu.cpp:113
msgid "Do not keep password"
msgstr "Паролро захира накунед"

#: kdesu.cpp:114
msgid "Stop the daemon (forgets all passwords)"
msgstr "Остановить службу kdesu (забыть все пароли)"

#: kdesu.cpp:115
msgid "Enable terminal output (no password keeping)"
msgstr "Включить вывод на терминал (без сохранения паролей)"

#: kdesu.cpp:116
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest"
msgstr "Задать приоритет 0 <= приоритет <= 100, (0 - самый низкий)"

#: kdesu.cpp:117
msgid "Use realtime scheduling"
msgstr "Использовать планировщик реального времени"

#: kdesu.cpp:118
msgid "Do not display ignore button"
msgstr "Не показывать кнопку «Игнорировать»"

#: kdesu.cpp:119
msgid "Specify icon to use in the password dialog"
msgstr "Значок, используемый в диалоге"

#: kdesu.cpp:120
msgid "Do not show the command to be run in the dialog"
msgstr "Не показывать в диалоге команду, которая будет выполняться"

#: kdesu.cpp:124
msgctxt ""
"Transient means that the kdesu app will be attached to the app specified by "
"the winid so that it is like a dialog box rather than some separate program"
msgid "Makes the dialog transient for an X app specified by winid"
msgstr "Барои барномаҳои X дар асоси winid диалогро шаффоф мекунад"

#: kdesu.cpp:125
msgid "Embed into a window"
msgstr ""

#: kdesu.cpp:155
#, kde-format
msgid "Cannot execute command '%1'."
msgstr "Наметавонад фармони '%1' иҷро кунад."

#: kdesu.cpp:235
#, kde-format
msgid "Illegal priority: %1"
msgstr "Недопустимый приоритет «%1»"

#: kdesu.cpp:260
msgid "No command specified."
msgstr "Команда не указана."

#: kdesu.cpp:372
msgid "Su returned with an error.\n"
msgstr "Su вернул ошибку.\n"

#: kdesu.cpp:395
msgid "Command:"
msgstr "Фармон:"

#: kdesu.cpp:403
msgid "realtime: "
msgstr "вақти_ҳозира: "

#: kdesu.cpp:406
msgid "Priority:"
msgstr "Бо тартиб:"

#: sudlg.cpp:30
#, kde-format
msgid "Run as %1"
msgstr "Иҷро кунед ба %1"

#: sudlg.cpp:34
msgid "Please enter your password below."
msgstr "Лутфан паролро ворид кунед."

#: sudlg.cpp:38
msgid ""
"The action you requested needs <b>root privileges</b>. Please enter "
"<b>root's</b> password below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Для выполнения данного действия необходимы <b>пользователя «root»</b>. "
"Введите его <b>пароль</b> или нажмите «Игнорировать» для продолжения работы "
"с текущими правами."

#: sudlg.cpp:42
msgid ""
"The action you requested needs <b>root privileges</b>. Please enter "
"<b>root's</b> password below."
msgstr ""
"Для выполнения данного действия необходимы <b>права пользователя «root»</b>. "
"Введите его <b>пароль</b>."

#: sudlg.cpp:46
#, kde-format
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for <b>%1</b> below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Для выполнения данного действия необходимы дополнительные привилегии. "
"Введите пароль пользователя <b>%1</b> или нажмите «Игнорировать» для "
"продолжения с текущими правами."

#: sudlg.cpp:51
#, kde-format
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for <b>%1</b> below."
msgstr ""
"Для выполнения данного действия необходимы дополнительные привилегии. "
"Введите пароль пользователя <b>%1</b>."

#: sudlg.cpp:77
msgid "Conversation with su failed."
msgstr "Кор кардан ҳамроҳи SU нашуд."

#: sudlg.cpp:84
msgid ""
"The program 'su' could not be found.<br />Ensure your PATH is set correctly."
msgstr ""
"Программа «su» не найдена.<br />Убедитесь, что переменная PATH установлена "
"правильно."

#: sudlg.cpp:94
msgid ""
"Permission denied.<br />Possibly incorrect password, please try again.<br /"
">On some systems, you need to be in a special group (often: wheel) to use "
"this program."
msgstr ""
"Иҷозат надоред.<br />Эҳтимол парол нодуруст аст. Аз нав кӯшиш кунед.<br /"
">Дар баъзе системаҳо барои истифода кардани барномаи зерин шумо бояд аъзои "
"гуруӯҳи (wheel) махсус бошед."

#: sudlg.cpp:101
msgid "Internal error: illegal return from SuProcess::checkInstall()"
msgstr "Внутренняя ошибка: SuProcess::checkInstall() вернул ошибочное значение"

