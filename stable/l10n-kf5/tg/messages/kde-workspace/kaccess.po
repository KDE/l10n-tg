msgstr ""
"Вы действительно хотите активировать \"%1\" и деактивировать \"%2\", \"%3\" "
"и \"%4\"?"

#: kaccess.cpp:729
#, kde-format
msgid "Do you really want to activate \"%1\" and \"%2\"?"
