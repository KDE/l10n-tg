msgstr "Вы действительно хотите активировать \"%1\"?"

#: kaccess.cpp:715
#, kde-format
msgid "Do you really want to activate \"%1\" and to deactivate \"%2\"?"
msgstr "Вы действительно хотите активировать \"%1\" и деактивировать \"%2\"?"

