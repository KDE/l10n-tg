#: kaccess.cpp:695
#, kde-format
msgid "Do you really want to deactivate \"%1\"?"
msgstr "Вы действительно хотите деактивировать \"%1\"?"

#: kaccess.cpp:698
#, kde-format
msgid "Do you really want to deactivate \"%1\" and \"%2\"?"
msgstr "Вы действительно хотите деактивировать \"%1\" и %2\"?"

#: kaccess.cpp:701
#, kde-format
