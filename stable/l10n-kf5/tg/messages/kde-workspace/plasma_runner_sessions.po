#: sessionrunner.cpp:250
#, kde-format
msgid ""
"<p>You have chosen to open another desktop session.<br />The current session "
"will be hidden and a new login screen will be displayed.<br />An F-key is "
"assigned to each session; F%1 is usually assigned to the first session, F%2 "
"to the second session and so on. You can switch between sessions by pressing "
"Ctrl, Alt and the appropriate F-key at the same time. Additionally, the KDE "
"Panel and Desktop menus have actions for switching between sessions.</p>"
msgstr ""
"<p>Шумо сеанси мизи кории дигарро интихоб кардед.<br />Сеанси ҷорӣ пинҳон "
"карда мешавад ва экрани вуруди нав нишон дода мешавад.<br />Тугмаи F барои "
"ҳар як сеанс таъин карда шуд; Тугмаи F%1 барои сеанси аввалин таъин карда "
"шуд, тугмаи F%2 барои сеанси дуввум таъин карда шуд ва дигар. Шумо метавонед "
"бо истифодаи тугмаҳои Ctrl, Alt ва тугмаи F мизҳои кориро мубодила кунед. "
"Шумо ҳам метавонед панели KDE ва менюи мизи корӣ дар байни сеансҳо мубодила "
"кунед.</p>"

#~ msgid "&Start New Session"
#~ msgstr "&Оғозкунии сеанси нав"
