#: main.cpp:44
#, kde-format
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"Файли дурдастро боз карда ва дар - KIO Exec сурати мушоҳидаи тағйироти барои "
"боргузориро савол мекунад"

#: main.cpp:52
#, kde-format
msgid "'command' expected.\n"
msgstr "'дастур' лозим аст.\n"

#: main.cpp:81
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"Нишони интернетии %1\n"
"нодуруст аст"

#: main.cpp:83
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Нишони интернетии дурдасти %1\n"
"ғайриқобили истифода бо калиди --tempfiles"

#: main.cpp:216
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Файли зоҳиран муваққатӣ\n"
"%1\n"
"тағйир дода шудааст.\n"
"Оё ҳанӯз мехоҳед онро ҳузф кунед?"

#: main.cpp:217 main.cpp:224
#, kde-format
msgid "File Changed"
msgstr "Файли тағйир кардашуда"

#: main.cpp:217
#, kde-format
msgid "Do Not Delete"
msgstr "Нест Накардан"

#: main.cpp:223
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Файли\n"
"%1\n"
"тағйир кардааст.\n"
"Оё мехоҳед тағйиротро бор кунед?"

#: main.cpp:224
#, kde-format
msgid "Upload"
msgstr "Бор кардан"

#: main.cpp:224
#, kde-format
msgid "Do Not Upload"
msgstr "Бор накардан"

