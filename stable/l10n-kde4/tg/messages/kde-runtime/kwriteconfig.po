#: kwriteconfig.cpp:35
#, kde-format
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:37
#, kde-format
msgid "Write KConfig entries - for use in shell scripts"
msgstr "KConfig - барои истифода дар ҷилди дастнависҳо"

#: kwriteconfig.cpp:39
#, kde-format
