#: kde-menu.cpp:93
#, kde-format
msgid "Menu item '%1' could not be highlighted."
msgstr "Қисми '%1' меню равшан карда намешавад."

#: kde-menu.cpp:106
#, kde-format
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""
"Баномаи дархости менюи KDE.\n"
"Ин барнома ёрӣ медиҳад, барномаҳои муайяншударо дар меню ҷустуҷӯ кунед.\n"
"Амалиёти --highlight (равшанкунӣ) барои равшанкардани барномаҳо дар\n"
"менюи KDE истифода шудааст."

#: kde-menu.cpp:111
#, kde-format
msgid "kde-menu"
msgstr "kde-menu"

#: kde-menu.cpp:113
#, kde-format
