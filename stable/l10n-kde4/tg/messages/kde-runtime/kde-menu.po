msgstr "(c) 2003 Waldo Bastian"

#: kde-menu.cpp:114
#, kde-format
msgid "Waldo Bastian"
msgstr "Waldo Bastian"

#: kde-menu.cpp:114
#, kde-format
msgid "Author"
msgstr "Муаллиф"

#: kde-menu.cpp:119
#, kde-format
msgid "Output data in UTF-8 instead of local encoding"
msgstr "Намоиши маълумот дар UTF-8 ғайр аз рамзгузории маҳаллӣ"

#: kde-menu.cpp:120
#, kde-format
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr ""
"Намоиши суроғаи қисми меню ба\n"
"ҷои баномаҳо"

#: kde-menu.cpp:121
#, kde-format
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr ""
"Намоиши номи қисми меню ба\n"
"ҷои баномаҳо"

#: kde-menu.cpp:122
#, kde-format
msgid "Highlight the entry in the menu"
msgstr "Равшанкунии воридот дар меню"

#: kde-menu.cpp:123
#, kde-format
msgid "Do not check if sycoca database is up to date"
msgstr "Агар маълумоти sycoca нав аст, санҷиш лозим нест"

#: kde-menu.cpp:124
#, kde-format
msgid "The id of the menu entry to locate"
msgstr "Суроғаи қисм дар меню"

#: kde-menu.cpp:133
#, kde-format
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr ""
"Шумо бояд суроғаи қисми менюро муайян кунед, масалан 'kde4-konsole.desktop'"

#: kde-menu.cpp:142
#, kde-format
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr ""
"Шумо бояд суроғаи қисми меню --print-menu-id, номи қисми меню --print-menu-"
"name ё равшанкуниро муайян кунед"

#: kde-menu.cpp:164
#, kde-format
msgid "No menu item '%1'."
msgstr "Қисми '%1' дар меню мавҷуд нест."

#: kde-menu.cpp:168
#, kde-format
msgid "Menu item '%1' not found in menu."
msgstr "Қисми '%1' дар меню ёфт нашуд."
