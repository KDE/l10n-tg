#: audio_plugin.cpp:74
#, kde-format
msgid "An older file named '%1' already exists.\n"
msgstr "Файли кӯҳна бо номи '%1' аллакай мавҷуд аст.\n"

#: audio_plugin.cpp:76
#, kde-format
msgid "A similar file named '%1' already exists.\n"
msgstr "Файли монанд бо номи '%1' аллакай мавҷуд аст.\n"

#: audio_plugin.cpp:78
#, kde-format
msgid "A newer file named '%1' already exists.\n"
msgstr "Файли навтарин бо номи '%1' аллакай мавҷуд аст.\n"

#: audio_plugin.cpp:80
#, kde-format
msgid "Source File"
msgstr "Файли аслӣ"

#: audio_plugin.cpp:81
#, kde-format
msgid "Existing File"
msgstr "Файли мавҷудбуда"

#: audio_plugin.cpp:82
#, kde-format
msgid "Would you like to replace the existing file with the one on the right?"
msgstr ""
"Оё шумо мехоҳед файли мавҷудбударо бо файли дар тарафи рост иваз кунед?"

#: audiopreview.cpp:51
#, kde-format
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"Ин файли аудиоӣ дар мизбони\n"
"маҳаллӣ нигоҳ дошта нашуд.\n"
"Барои боркунии файл ин нишонаро зер кунед.\n"

#: audiopreview.cpp:57
#, kde-format
msgid "Unable to load audio file"
msgstr "Файли аудиоӣ бор карда намешавад"

#: audiopreview.cpp:88
#, kde-format
msgid "Artist: %1"
msgstr "Ҳофиз: %1"

#: audiopreview.cpp:91
#, kde-format
msgid "Title: %1"
msgstr "Сарлавҳа: %1"

#: audiopreview.cpp:94
#, kde-format
msgid "Comment: %1"
msgstr "Шарҳ: %1"

#: audiopreview.cpp:96
#, kde-format
msgctxt "Bitrate: 160 kbits/s"
msgid "Bitrate: %1 %2\n"
msgstr "Суръат: %1 %2\n"

#: audiopreview.cpp:98
#, kde-format
msgid "Sample rate: %1 %2\n"
msgstr "Суръати намунавӣ: %1 %2\n"

#: audiopreview.cpp:99
#, kde-format
msgid "Length: "
msgstr "Давомнокӣ: "
