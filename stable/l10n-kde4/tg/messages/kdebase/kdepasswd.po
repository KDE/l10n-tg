#, fuzzy
msgid "Conversation with 'passwd' failed."
msgstr "Мубодила ба барномаи `гузарвожа' бо нокомӣ анҷомид."

#: passwddlg.cpp:47
#, fuzzy
msgid "Could not find the program 'passwd'."
