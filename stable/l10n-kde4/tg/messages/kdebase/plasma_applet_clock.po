#. i18n: tag string
#. i18n: file clockConfig.ui line 24
#: rc.cpp:3
msgid "Appearance"
msgstr "Намоиш"

#. i18n: tag string
#. i18n: file clockConfig.ui line 35
#: rc.cpp:6
msgid "Show the seconds"
msgstr "Намоиши ақрабаки сониявӣ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 38
#: rc.cpp:9
msgid "Check this if you want to show the seconds."
msgstr "Интихоб кунед, агар мехоҳед ақрабаки сониявӣ пайдо шавад."

#. i18n: tag string
#. i18n: file clockConfig.ui line 41
#: rc.cpp:12
msgid "Show &seconds"
msgstr "Намоиши &ақрабаки сониявӣ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 48
#: rc.cpp:15
msgid "Show the time in text"
msgstr "Намоиши вақт дар матн"

#. i18n: tag string
#. i18n: file clockConfig.ui line 51
#: rc.cpp:18
msgid "Check this if you want to display the time as text within the clock."
msgstr "Интихоб кунед, агар мехоҳед дисплеи вақт дар матн пайдо шавад."

#. i18n: tag string
#. i18n: file clockConfig.ui line 54
#: rc.cpp:21
msgid "Also show the time as text"
msgstr "Аллакай вақтро дар матн нишон диҳед"

#. i18n: tag string
#. i18n: file clockConfig.ui line 66
#: rc.cpp:24
msgid "Timezones"
msgstr "Минтақаи вақт"

#. i18n: tag string
#. i18n: file clockConfig.ui line 77
#: rc.cpp:27
msgid "Use &local timezone"
msgstr "Истифодаи минтақаи вақти &маҳаллӣ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 91
#: rc.cpp:30
msgid "Area"
