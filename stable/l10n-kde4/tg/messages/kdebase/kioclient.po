#: kioclient.cpp:42
msgid "KIO Client"
msgstr "Корбари KIO"

#: kioclient.cpp:43
msgid "Command-line tool for network-transparent operations"
msgstr "Барномаи фармонҳо барои иҷрои амалҳои шабака"

#: kioclient.cpp:54
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Синтакс:\n"

#: kioclient.cpp:55
msgid ""
"  kioclient openProperties 'url'\n"
"            # Opens a properties menu\n"
"\n"
msgstr ""
"  kioclient openProperties 'url'\n"
"            # Менюи хусусиятҳоро мекушояд\n"
"\n"

#: kioclient.cpp:57
msgid ""
"  kioclient exec 'url' ['mimetype']\n"
"            # Tries to open the document pointed to by 'url', in the "
"application\n"
"            #   associated with it in KDE. You may omit 'mimetype'.\n"
"            #   In this case the mimetype is determined\n"
"            #   automatically. Of course URL may be the URL of a\n"
"            #   document, or it may be a *.desktop file.\n"
msgstr ""
"  kioclient exec 'url' ['mimetype']\n"
"            #  Ҳуҷҷатҳоро бо 'url' дар барномаҳои KDE мекушояд\n"
"            #   Ва ҳамчун 'mimetype' мекушояд. Дар ин ҳолат\n"
"            #   mimetype  ба худкор муайян шудааст.\n"
"            #   URL метавонад URL ҳуҷҷат бошад ё ин метавонад\n"
"            #   монанди файли *.desktop мауян шавад.\n"

#: kioclient.cpp:63
msgid ""
"  kioclient move 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kioclient move 'src' 'dest'\n"
"            # Таҳвилкунии URL 'src' ба 'dest'.\n"
"            #   'src' метавонад ҳамчун рӯйхати URL бошад.\n"

#: kioclient.cpp:68
msgid ""
"  kioclient download ['src']\n"
"            # Copies the URL 'src' to a user-specified location'.\n"
"            #   'src' may be a list of URLs, if not present then\n"
"            #   a URL will be requested.\n"
"\n"
msgstr ""
"  kioclient download ['src']\n"
"            #  URL 'src' ба ҷои муайяншуда нусха мемонад.\n"
"            #   'src' метавонад ҳамчун рӯйхати URL бошад.\n"
"            #    URL номавҷуд дархост мешавад.\n"
"\n"

#: kioclient.cpp:72
msgid ""
"  kioclient copy 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"\n"
msgstr ""
"  kioclient copy 'src' 'dest'\n"
"            #  Нусхабардории URL 'src' ба 'dest'.\n"
"            #  'src' метавонад ҳамчун рӯйхати URL бошад.\n"
"\n"

#: kioclient.cpp:75
msgid ""
"  kioclient cat 'url'\n"
"            # Writes out the contents of 'url' to stdout\n"
"\n"
msgstr ""
"  kioclient cat 'url'\n"
"            # Дорои файлро аз 'url' ба stdout менависад\n"
"\n"

#: kioclient.cpp:78
msgid ""
"*** Examples:\n"
"  kioclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // Mounts the CDROM\n"
"\n"
msgstr ""
"*** Мисолҳо:\n"
"  kioclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // CDROM'ро васл мекунад\n"
"\n"

#: kioclient.cpp:81
msgid ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with default binding\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Файлро бо васлҳои стандартӣ мекушояд\n"
"\n"

#: kioclient.cpp:83
msgid ""
"  kioclient exec file:/home/weis/data/test.html Netscape\n"
"             // Opens the file with netscape\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html Netscape\n"
"             // Файлро бо netscape мекушояд\n"
"\n"

#: kioclient.cpp:85
msgid ""
"  kioclient exec ftp://localhost/\n"
"             // Opens new window with URL\n"
"\n"
msgstr ""
"  kioclient exec ftp://localhost/\n"
"             // Тирезаи навро бо URL мекушояд\n"
"\n"

#: kioclient.cpp:87
msgid ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Барномаи emacs оғоз мекунад\n"
"\n"

#: kioclient.cpp:89
msgid ""
"  kioclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Opens the CDROM's mount directory\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Феҳрасти CDROM'ро мекушояд\n"
"\n"

#: kioclient.cpp:91
msgid ""
"  kioclient exec .\n"
"             // Opens the current directory. Very convenient.\n"
"\n"
msgstr ""
"  kioclient exec .\n"
"             // Ҷузвдони ҷориро мекушояд. Хеле оддӣ аст.\n"
"\n"

#: kioclient.cpp:102
msgid "Non-interactive use: no message boxes"
msgstr "Истифодабарии умумӣ: паймдон мавҷуд нест"

#: kioclient.cpp:104
msgid "URL or URLs"
msgstr "URL ё URL'ҳо"

#: kioclient.cpp:106 kioclient.cpp:109
msgid "Source URL or URLs"
msgstr "Манбаъи Source URL ё URL'ҳо"

#: kioclient.cpp:107 kioclient.cpp:110
msgid "Destination URL"
msgstr "Ҷойришавии URL"

#: kioclient.cpp:112
msgid "Show available commands"
msgstr "Намоиши фармонҳои дастрас"

#: kioclient.cpp:113
msgid "Command (see --commands)"
msgstr "Фармон (ворид кунед --commands)"

#: kioclient.cpp:114
msgid "Arguments for command"
msgstr "Вурудҳои фармонӣ"

#: kioclient.cpp:149
msgid "Syntax Error: Not enough arguments\n"
msgstr "Хатои наҳвӣ: Нишонвандҳо нокифояанд\n"

#: kioclient.cpp:154
msgid "Syntax Error: Too many arguments\n"
msgstr "Хатои наҳвӣ: Нишонвандҳо ниҳоят зиёданд\n"

#: kioclient.cpp:285
msgid "Unable to download from an invalid URL."
msgstr "Аз URL нодуруст гирифта намешавад."

#: kioclient.cpp:323
#, kde-format
msgid "Syntax Error: Unknown command '%1'\n"
msgstr "Хатои наҳвӣ: Фармони номаълум '%1'\n"
