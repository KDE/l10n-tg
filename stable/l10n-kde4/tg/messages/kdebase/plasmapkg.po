#: main.cpp:38
msgid "Install, list, remove Plasma packages"
msgstr "Установка, просмотр и удаление пакетов Plasma"

#: main.cpp:75
msgid "Plasma Package Manager"
msgstr "Управление пакетами Plasma"

#: main.cpp:77
