#: kio_nepomuk.cpp:117
#, kde-format
msgctxt "@info"
msgid ""
"Please insert the removable medium <resource>%1</resource> to access this "
"file."
msgstr ""
"Барои кушодани ин файл, лутфан диски <resource>%1</resource> ҷудошавандаро "
"ворд кунед."

#: kio_nepomuk.cpp:137
msgid ""
"Do you really want to delete the resource and all relations to and from it?"
msgstr "Оё шумо мехоҳед ин манбаъро бо ҳамаи муносибатҳои он тоза кунед?"

#: kio_nepomuk.cpp:140
msgid "Delete Resource"
msgstr "Нест кардани манбаъ"

#: kio_nepomuk.cpp:277
msgid ""
"The Nepomuk system is not activated. Unable to answer queries without it."
msgstr ""
"Системаи Nepomuk ғайри фаъол аст. Ҷавоб додан ба дархостҳо бе ин система "
"ноимкон аст."

