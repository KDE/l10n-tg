msgstr "Нигаҳдорандаи экранро барпо созед."

#: random.cpp:75
#, fuzzy
msgid "Run in the specified XWindow"
msgstr "Дар XТирезаи таъиншуда корандозӣ кунед."

#: random.cpp:77
#, fuzzy
msgid "Run in the root XWindow"
msgstr "Дар XТирезаи решавӣ корандозӣ кунед."

