#: managerbase.cpp:61
#, kde-format
msgid "Backend loaded but wrong type obtained, expected %1"
msgstr ""
"Пуштибонӣ ба кор дароварда шуд, лекин навъи нодуруст қабул карда шуд, %1 "
"интизорӣ шудааст"

#: managerbase.cpp:79
#, kde-format
msgid "No %1 Backend found"
msgstr "Пуштибонии %1 ёфт нашуд"

#: managerbase.cpp:84
#, kde-format
msgid "Unable to use any of the %1 Backends"
msgstr "Ягон модули пуштибонии %1 истифода карда намешавад"

