#: random.cpp:48
#, kde-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"Истифодабарӣ: %1 [-setup] [args]\n"
"Пардаи экранро оғоз мекунад.\n"
"Ҳамаи нишонвандҳо (ба ғайр аз -setup) ба пардаи экран гузаронида мешаванд."

#: random.cpp:55
#, kde-format
msgid "Start a random KDE screen saver"
msgstr "Пардаи экрани KDE-ро оғоз кунед"

#: random.cpp:70
#, kde-format
msgid "Random screen saver"
msgstr "Танзимоти пардаи экран"

#: random.cpp:76
#, kde-format
msgid "Setup screen saver"
msgstr "Насби пардаи экран"

#: random.cpp:78
#, kde-format
msgid "Run in the specified XWindow"
msgstr "Дар XWindow муайяншуда истифода баред"

#: random.cpp:80
#, kde-format
msgid "Run in the root XWindow"
msgstr "Дар XWindow Root истифода баред"

#: random.cpp:194
#, kde-format
msgid "Setup Random Screen Saver"
msgstr "Барпосозии Нигаҳдорандаи Дилхоҳи Экран"

#: random.cpp:202
#, kde-format
msgid "Use OpenGL screen savers"
msgstr "Пардаи экранро бо OpenGL истифода баред"

#: random.cpp:205
#, kde-format
msgid "Use screen savers that manipulate the screen"
msgstr "Нигаҳдорандаи экранеро, ки экранро дасткорӣ мекунад, истифода баред"

