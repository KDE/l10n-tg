#, kde-format
msgid "Acceptance dela&y:"
msgstr "&Время ожидания:"

#: kcmaccess.cpp:396
#, kde-format
msgid "&Use system bell whenever a key is pressed"
msgstr "&Подавать системный сигнал при нажатии клавиши"

#: kcmaccess.cpp:402
#, kde-format
