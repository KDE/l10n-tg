#, fuzzy, kde-format
#| msgid ""
#| "<qt>\n"
#| "<p>Select from this listbox the program you want to use to draw your "
#| "desktop background.</p>\n"
#| "<p>The <b>Program</b> column shows the name of the program.<br>\n"
