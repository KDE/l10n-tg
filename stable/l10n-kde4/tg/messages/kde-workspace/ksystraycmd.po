#: main.cpp:28
#, kde-format
msgid "Allows any application to be kept in the system tray"
msgstr "Имконияти нигаҳдории ҳамаи замимаҳоро дар қуттии системавӣ медиҳад"

#: main.cpp:30
#, kde-format
